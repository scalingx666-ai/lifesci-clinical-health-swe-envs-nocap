+	private String givenPendingActivationKey(User user) {
+		String key = "h4ph0fpNzQCIPSw8plJI";
+		long tokenTime = System.currentTimeMillis() + 10 * 60 * 1000;
+		LoginCredential credentials = dao.getLoginCredential(user);
