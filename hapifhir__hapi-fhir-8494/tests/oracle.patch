diff --git a/hapi-fhir-docs/src/main/resources/ca/uhn/hapi/fhir/changelog/8_14_0/8493-lastupdated-redundant-resource-join.yaml b/hapi-fhir-docs/src/main/resources/ca/uhn/hapi/fhir/changelog/8_14_0/8493-lastupdated-redundant-resource-join.yaml
new file mode 100644
index 000000000000..ee8883624d78
--- /dev/null
+++ b/hapi-fhir-docs/src/main/resources/ca/uhn/hapi/fhir/changelog/8_14_0/8493-lastupdated-redundant-resource-join.yaml
@@ -0,0 +1,8 @@
+---
+type: fix
+issue: 8493
+jira: SMILE-13032
+title: "Previously, a search combining `_lastUpdated` with a sort, or with more than
+  one search parameter, generated SQL that joined the resource table to itself and
+  applied the `_lastUpdated` range to the joined copy. This could cause very slow
+  searches and bulk exports on large databases. The redundant join has been removed."
diff --git a/hapi-fhir-jpaserver-base/src/main/java/ca/uhn/fhir/jpa/search/builder/sql/SearchQueryBuilder.java b/hapi-fhir-jpaserver-base/src/main/java/ca/uhn/fhir/jpa/search/builder/sql/SearchQueryBuilder.java
