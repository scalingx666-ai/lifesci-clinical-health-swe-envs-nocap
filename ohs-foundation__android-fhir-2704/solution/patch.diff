+        isActive = true,
+      ),
+    )
+
+    // Patient 6
+    patients.add(
+      createPatient(
+        firstName = "Liam",
+        lastName = "Wilson",
+        birthDate = "2001-12-30",
+        gender = Enumerations.AdministrativeGender.MALE,
+        phoneNumber = "5678901234",
