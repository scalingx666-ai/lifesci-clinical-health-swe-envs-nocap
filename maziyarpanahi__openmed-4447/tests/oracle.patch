+
+def test_manifest_names_every_consumer_and_its_ci_gate() -> None:
+    manifest = json.loads((FIXTURE_DIR / fixture_tool.MANIFEST_FILE).read_text("utf-8"))
+
+    assert manifest["update_command"] == fixture_tool.UPDATE_COMMAND
