+
+def test_changed_note_length_fails_derived_output(fixture_copy: Path) -> None:
+    note = fixture_copy / "synthetic_clinical_note.txt"
+    note.write_bytes(note.read_bytes().replace(b"Harbor", b"Harbour", 1))
