+    assert json.loads(queue.store.path.read_text(encoding="utf-8")) == records_before
+    assert set(records_before["jobs"]) == {running["id"], queued["id"]}
+    assert _gauges(registry) == (2, len("synthetic running") + len("synthetic queued"))
