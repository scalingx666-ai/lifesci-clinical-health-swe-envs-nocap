+def _request(*texts: str) -> DeidentifyJobRequest:
+    return DeidentifyJobRequest(
+        documents=[
+            DeidentifyJobDocument(id=f"synthetic-{index}", text=text)
+            for index, text in enumerate(texts)
+        ]
+    )
