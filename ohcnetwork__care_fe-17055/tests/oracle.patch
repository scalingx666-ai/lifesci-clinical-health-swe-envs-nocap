new file mode 100644
index 00000000000..ddd48d58a3d
--- /dev/null
+++ b/src/components/Tags/TagExpiryOffsetInput.tsx
@@ -0,0 +1,54 @@
+import { useId } from "react";
+import { useTranslation } from "react-i18next";
+
+import { TAG_EXPIRY_OFFSET_INPUT_UNITS } from "@/components/Tags/tagExpiry";
+
+import { Field, FieldLabel } from "@/components/ui/field";
+import { Input } from "@/components/ui/input";
+
+import { TagExpiryOffset } from "@/types/emr/tagConfig/tagConfig";
+
+interface TagExpiryOffsetInputProps {
+  value: TagExpiryOffset;
+  onChange: (value: TagExpiryOffset) => void;
+  disabled?: boolean;
+}
+
+export function TagExpiryOffsetInput({
+  value,
+  onChange,
+  disabled,
+}: TagExpiryOffsetInputProps) {
+  const { t } = useTranslation();
+  const id = useId();
+
+  return (
+    <div className="grid grid-cols-3 gap-2">
+      {TAG_EXPIRY_OFFSET_INPUT_UNITS.map((unit) => (
+        <Field key={unit}>
+          <FieldLabel htmlFor={`${id}-${unit}`}>
+            {t(`expiry_offset_unit_${unit}`)}
+          </FieldLabel>
+          <Input
+            id={`${id}-${unit}`}
+            type="number"
+            inputMode="numeric"
+            min={0}
+            step={1}
+            placeholder="0"
+            value={value[unit] || ""}
+            onChange={(e) => {
+              // valueAsNumber handles exponent input such as 1e2 that parseInt misreads
+              const parsed = Math.trunc(e.target.valueAsNumber);
+              onChange({
+                ...value,
+                [unit]: Number.isNaN(parsed) ? 0 : Math.max(0, parsed),
+              });
+            }}
+            disabled={disabled}
+          />
+        </Field>
+      ))}
+    </div>
+  );
+}
diff --git a/src/components/Tags/TagExpiryStep.tsx b/src/components/Tags/TagExpiryStep.tsx
new file mode 100644
index 00000000000..c2c9f423a1d
--- /dev/null
+++ b/src/components/Tags/TagExpiryStep.tsx
@@ -0,0 +1,108 @@
+import { ArrowLeft } from "lucide-react";
+import { useEffect, useRef, useState } from "react";
+import { useTranslation } from "react-i18next";
+
+import { TagExpiryOffsetInput } from "@/components/Tags/TagExpiryOffsetInput";
+import {
+  MAX_TAG_EXPIRY_DAYS,
+  compactExpiryOffset,
+  formatExpiryOffset,
+  hasExpiryOffset,
+  isExpiryOffsetTooLong,
+} from "@/components/Tags/tagExpiry";
+
+import { Button } from "@/components/ui/button";
+import {
+  FieldDescription,
+  FieldError,
+  FieldGroup,
+} from "@/components/ui/field";
+
+import { TagConfig, TagExpiryOffset } from "@/types/emr/tagConfig/tagConfig";
+
+interface TagExpiryStepProps {
+  tag: TagConfig;
+  onBack: () => void;
+  onApply: (expiryOffset?: TagExpiryOffset) => void;
+}
+
+/**
+ * Lets the user pick an expiry while applying a tag whose config allows it.
+ * Leaving the duration empty falls back to the config's default expiry, if any.
+ */
+export function TagExpiryStep({ tag, onBack, onApply }: TagExpiryStepProps) {
+  const { t } = useTranslation();
+  const { autoset_expiry, expiry_offset } = tag.expiry_metadata ?? {};
+  const defaultOffset = autoset_expiry ? expiry_offset : undefined;
+  const [offset, setOffset] = useState<TagExpiryOffset>(defaultOffset ?? {});
+  const containerRef = useRef<HTMLDivElement>(null);
+  const tooLong = isExpiryOffsetTooLong(offset);
+
+  // The menu refocuses its popup after the picked item is hidden, which wins
+  // over autoFocus, so move focus to the first input once that has settled.
+  useEffect(() => {
+    const frame = requestAnimationFrame(() =>
+      containerRef.current?.querySelector("input")?.focus(),
+    );
+    return () => cancelAnimationFrame(frame);
+  }, []);
+
+  return (
+    // Keep typing and Tab out of the menu's typeahead, but let Escape reach
+    // the menu or drawer so it still closes from here.
+    <div
+      ref={containerRef}
+      className="flex flex-col gap-4 p-3"
+      onKeyDown={(e) => {
+        if (e.key !== "Escape") e.stopPropagation();
+      }}
+    >
+      <div className="flex items-center gap-2">
+        <Button
+          type="button"
+          variant="ghost"
+          size="icon-xs"
+          onClick={onBack}
+          aria-label={t("back")}
+        >
+          <ArrowLeft />
+        </Button>
+        <span className="truncate text-sm font-medium">
+          {t("set_tag_expiry", { tag: tag.display })}
+        </span>
+      </div>
+      <FieldGroup className="gap-2">
+        <TagExpiryOffsetInput value={offset} onChange={setOffset} />
+        <FieldDescription>
+          {defaultOffset
+            ? t("tag_expiry_default", {
+                duration: formatExpiryOffset(defaultOffset, t),
+              })
+            : t("tag_expiry_leave_empty")}
+        </FieldDescription>
+        {tooLong && (
+          <FieldError>
+            {t("tag_expiry_offset_too_long", { days: MAX_TAG_EXPIRY_DAYS })}
+          </FieldError>
+        )}
+      </FieldGroup>
+      <div className="flex justify-end gap-2">
+        <Button type="button" variant="outline" size="sm" onClick={onBack}>
+          {t("cancel")}
+        </Button>
+        <Button
+          type="button"
+          size="sm"
+          disabled={tooLong}
+          onClick={() =>
+            onApply(
+              hasExpiryOffset(offset) ? compactExpiryOffset(offset) : undefined,
+            )
+          }
+        >
+          {t("apply_tag")}
+        </Button>
+      </div>
+    </div>
+  );
+}
