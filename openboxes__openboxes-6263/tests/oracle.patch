diff --git a/src/integration-test/groovy/org/pih/warehouse/inventory/spec/ProductAvailabilityServiceQuantityOnHandAtDateSpec.groovy b/src/integration-test/groovy/org/pih/warehouse/inventory/spec/ProductAvailabilityServiceQuantityOnHandAtDateSpec.groovy
