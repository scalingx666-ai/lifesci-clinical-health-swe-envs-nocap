+def _expired_token(digest):
+    signer = ApprovalTokenSigner(
+        KEY, clock=lambda: NOW - 1000, max_lifetime_seconds=3600
+    )
+    return signer.issue(
+        action_digest=digest, reviewer_role=ROLE, expires_at=NOW - 10
+    ).to_dict()
