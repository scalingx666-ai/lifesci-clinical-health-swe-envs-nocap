@@ -0,0 +1,116 @@
+#if DEBUG
+    import CoreGraphics
+    import CoreText
+    import Foundation
+    import SwiftUI
+
+    /// Synthetic preview data only; never invoked by production review loading.
+    @MainActor
+    enum MultimodalReviewFixtures {
+        struct Row: Decodable {
+            let id: String
+            let kind: String
+            let status: String
+            let revision: String
+            let uncertainty: [String]
+            let wire: String
+            let text: String
+            let imageText: String?
+            let alternatives: [Alternative]
+            enum CodingKeys: String, CodingKey {
+                case id, kind, status, revision, uncertainty, wire, text, alternatives
+                case imageText = "image_text"
+            }
+        }
+
+        struct Alternative: Decodable {
+            let reference: String
+            let value: String
+        }
+        private struct Corpus: Decodable {
+            let version: Int
+            let syntheticOnly: Bool
+            let cases: [Row]
+            enum CodingKeys: String, CodingKey {
+                case version, cases
+                case syntheticOnly = "synthetic_only"
+            }
+        }
+
+        final class Source: LocalMultimodalReviewSource {
+            var localOnly = true
+            var revision: String?
+            var content: LocalMultimodalReviewContent?
+            init(revision: String?, content: LocalMultimodalReviewContent?) {
+                self.revision = revision
+                self.content = content
+            }
+            func currentRevision(_ handle: LocalMultimodalReviewHandle) throws -> String? { revision }
+            func resolve(_ handle: LocalMultimodalReviewHandle) throws -> LocalMultimodalReviewContent? { content }
+        }
+
+        static func rows(data supplied: Data? = nil) throws -> [Row] {
+            var root = URL(fileURLWithPath: #filePath)
+            for _ in 0..<5 { root.deleteLastPathComponent() }
+            let data = try supplied ?? Data(contentsOf: root.appending(path: "tests/fixtures/multimodal/local_review_v1.json"))
+            let corpus = try JSONDecoder().decode(Corpus.self, from: data)
+            guard corpus.version == 1, corpus.syntheticOnly, corpus.cases.count == 4 else { throw MultimodalReviewError.invalid }
+            return corpus.cases
+        }
+
+        static func image(_ text: String) throws -> CGImage {
+            guard let colorSpace = CGColorSpace(name: CGColorSpace.sRGB),
+                let context = CGContext(
+                    data: nil, width: 240, height: 96, bitsPerComponent: 8, bytesPerRow: 240 * 4,
+                    space: colorSpace, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue)
+            else { throw MultimodalReviewError.invalid }
+            context.setFillColor(CGColor(gray: 1, alpha: 1))
+            context.fill(CGRect(x: 0, y: 0, width: 240, height: 96))
+            let line = CTLineCreateWithAttributedString(
+                NSAttributedString(
+                    string: text,
+                    attributes: [
+                        NSAttributedString.Key(kCTFontAttributeName as String): CTFontCreateWithName("Helvetica" as CFString, 42, nil),
+                        NSAttributedString.Key(kCTForegroundColorAttributeName as String): CGColor(gray: 0, alpha: 1),
+                    ]))
+            context.textPosition = CGPoint(x: 18, y: 28)
+            CTLineDraw(line, context)
+            guard let image = context.makeImage() else { throw MultimodalReviewError.invalid }
+            return image
+        }
+
+        static func make(_ id: String, data: Data? = nil) throws -> (MultimodalReviewCase, Source) {
+            guard let row = try rows(data: data).first(where: { $0.id == id }), let kind = MultimodalReviewKind(rawValue: row.kind) else {
+                throw MultimodalReviewError.invalid
+            }
+            let review = try MultimodalReviewCase(
+                handle: LocalMultimodalReviewHandle(), evidence: MultimodalPacket.fromJSON(Data(row.wire.utf8)),
+                revision: row.revision, kind: kind, alternatives: row.alternatives.map(\.reference),
+                uncertainty: row.uncertainty.map { raw in
+                    guard let value = MultimodalReviewUncertainty(rawValue: raw) else { throw MultimodalReviewError.invalid }
+                    return value
+                })
+            let content = try LocalMultimodalReviewContent(
+                revision: row.revision, sourceDigest: review.sourceDigest, text: row.text,
+                image: try row.imageText.map(image),
+                alternatives: row.alternatives.map { try LocalReviewAlternative(reference: $0.reference, value: $0.value) })
+            return (
+                review,
+                Source(
+                    revision: row.status == "stale" ? String(repeating: "f", count: 64) : row.revision,
+                    content: row.status == "missing" ? nil : content)
+            )
+        }
+
+        static func view(_ id: String) throws -> some View {
+            let (review, source) = try make(id)
+            return MultimodalReviewView(review: review, source: source) { _ in }
+                .frame(width: 420, height: 760)
+        }
+    }
+
+    #Preview("Ambiguous visual value") { try! MultimodalReviewFixtures.view("ambiguous_visual") }
+    #Preview("Stale evidence") { try! MultimodalReviewFixtures.view("stale_evidence") }
+    #Preview("Missing content") { try! MultimodalReviewFixtures.view("missing_content") }
+    #Preview("Uncertain speaker role") { try! MultimodalReviewFixtures.view("uncertain_speaker") }
+#endif
diff --git a/swift/OpenMedKit/Sources/OpenMedKit/MultimodalReviewView.swift b/swift/OpenMedKit/Sources/OpenMedKit/MultimodalReviewView.swift
new file mode 100644
index 000000000..a0791c6f6
--- /dev/null
+++ b/swift/OpenMedKit/Sources/OpenMedKit/MultimodalReviewView.swift
@@ -0,0 +1,276 @@
+import SwiftUI
+
+/// Reusable local review. Replacing the case or source creates a fresh unseen presentation.
+@MainActor
+public struct MultimodalReviewView: View {
+    private let review: MultimodalReviewCase
+    private let source: any LocalMultimodalReviewSource
+    private let onDecision: (MultimodalReviewDecision) -> Void
+
+    public init(
+        review: MultimodalReviewCase, source: any LocalMultimodalReviewSource,
+        onDecision: @escaping (MultimodalReviewDecision) -> Void
+    ) {
+        self.review = review
+        self.source = source
+        self.onDecision = onDecision
+    }
+
+    public var body: some View {
+        ReviewPanel(review: review, source: source, onDecision: onDecision)
+            .id(ReviewIdentity(digest: review.digest, source: ObjectIdentifier(source)))
+    }
+}
+
+private struct ReviewIdentity: Hashable {
+    let digest: String
+    let source: ObjectIdentifier
+}
+
+private struct ReviewExposure: Equatable {
+    let identity: UUID
+    let frame: CGRect
+}
+
+private struct ReviewExposureKey: PreferenceKey {
+    static let defaultValue: ReviewExposure? = nil
+    static func reduce(value: inout ReviewExposure?, nextValue: () -> ReviewExposure?) { value = nextValue() ?? value }
+}
+
+private struct ReviewViewportKey: PreferenceKey {
+    static let defaultValue: CGSize = .zero
+    static func reduce(value: inout CGSize, nextValue: () -> CGSize) {
+        let next = nextValue()
+        if next.width > 0 && next.height > 0 { value = next }
+    }
+}
+
+private struct ReviewVisibility: Equatable {
+    let viewport: CGSize
+    let exposure: ReviewExposure?
+}
+
+@MainActor
+private struct ReviewPanel: View {
+    @State private var session: MultimodalReviewSession
+    @Environment(\.scenePhase) private var scenePhase
+    @FocusState private var focusedControl: String?
+    @State private var viewportSize: CGSize = .zero
+    @State private var exposure: ReviewExposure?
+    private let onDecision: (MultimodalReviewDecision) -> Void
+
+    init(
+        review: MultimodalReviewCase, source: any LocalMultimodalReviewSource,
+        onDecision: @escaping (MultimodalReviewDecision) -> Void
+    ) {
+        _session = State(initialValue: MultimodalReviewSession(review: review, source: source))
+        self.onDecision = onDecision
+    }
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 20) {
+                header
+                if session.completed {
+                    Label("Choice returned for review", systemImage: "checkmark.circle")
+                        .accessibilityIdentifier("review-completed")
+                } else if let content = session.content {
+                    let shownIdentity = session.presentationID
+                    protectedContent(content, identity: shownIdentity)
+                        .id(shownIdentity)
+                    alternatives(content)
+                    actions
+                } else {
+                    hold
+                }
+            }
+            .padding(20)
+            .frame(maxWidth: 760, alignment: .leading)
+            .frame(maxWidth: .infinity)
+        }
+        .coordinateSpace(name: "multimodal-review-viewport")
+        .background(GeometryReader { proxy in Color.clear.preference(key: ReviewViewportKey.self, value: proxy.size) })
+        .onPreferenceChange(ReviewViewportKey.self) { viewportSize = $0 }
+        .onPreferenceChange(ReviewExposureKey.self) { exposure = $0 }
+        .onChange(of: ReviewVisibility(viewport: viewportSize, exposure: exposure)) { _, visibility in markVisible(visibility) }
+        .privacySensitive()
+        .task { if scenePhase == .active { session.load() } }
+        .onChange(of: scenePhase) { _, phase in
+            if phase == .active { session.load() } else { session.hide() }
+        }
+        .onDisappear { session.hide() }
+    }
+
+    private func markVisible(_ visibility: ReviewVisibility) {
+        guard scenePhase == .active, let exposure = visibility.exposure, exposure.frame.width > 0, exposure.frame.height > 0 else { return }
+        let visible = CGRect(origin: .zero, size: visibility.viewport).intersection(exposure.frame)
+        guard !visible.isNull, visible.width >= min(64, exposure.frame.width), visible.height >= min(64, exposure.frame.height) else { return }
+        session.markPresented(exposure.identity)
+    }
+
+    private var header: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Text(title).font(.title2.bold())
+            Text("Compare the source and alternatives before choosing.")
+                .foregroundStyle(.secondary)
+            Text(provenance).font(.caption).foregroundStyle(.secondary)
+            Text("Revision \(session.review.revision.prefix(12))")
+                .font(.caption.monospaced()).foregroundStyle(.secondary)
+            ForEach(session.review.uncertainty, id: \.self) { reason in
+                Label(reasonLabel(reason), systemImage: "exclamationmark.triangle")
+                    .font(.callout)
+            }
+            if !session.review.canAccept {
+                Text("This transcript is provisional. Accept is unavailable until it is finalized.")
+                    .font(.callout)
+            }
+        }
+    }
+
+    private var title: String {
+        switch session.review.kind {
+        case .visualConflict: return "Review conflicting values"
+        case .handwriting: return "Review handwriting"
+        case .speakerRole: return "Review speaker attribution"
+        }
+    }
+
+    private var provenance: String {
+        switch session.review.evidence.projection {
+        case .visual(let visual):
+            return "Source region · Page \(visual.page + 1) · \(visual.unit.rawValue) coordinates"
+        case .transcript(let transcript):
+            guard let span = transcript.currentScalarSpan else { return "Transcript citation unavailable" }
+            return "Transcript revision \(transcript.revision) · Unicode scalars [\(span.start), \(span.end))"
+        default: return "Unsupported source"
+        }
+    }
+
+    private func reasonLabel(_ reason: MultimodalReviewUncertainty) -> String {
+        switch reason {
+        case .conflictingValues: return "The source readers disagree."
+        case .ambiguousHandwriting: return "The handwriting has more than one interpretation."
+        case .uncertainSpeaker: return "The speaker role is unconfirmed."
+        case .provisionalTranscript: return "The transcript may still change."
+        }
+    }
+
+    private func protectedContent(_ content: LocalMultimodalReviewContent, identity: UUID) -> some View {
+        VStack(alignment: .leading, spacing: 12) {
+            Text("Source evidence").font(.headline)
+            VStack(alignment: .leading, spacing: 12) {
+                if let image = content.image {
+                    Image(image, scale: 1, label: Text("Protected source region. Compare it with the alternatives."))
+                        .resizable().interpolation(.none).scaledToFit()
+                        .frame(maxHeight: 320)
+                        .accessibilityLabel("Protected source region. Compare it with the alternatives.")
+                        .accessibilityIdentifier("review-source-image")
+                }
+                if let text = content.text {
+                    Text(verbatim: text)
+                        .font(.body)
+                        .accessibilityIdentifier("review-source-text")
+                }
+            }
+            .background(
+                GeometryReader { proxy in
+                    Color.clear.preference(
+                        key: ReviewExposureKey.self,
+                        value: ReviewExposure(identity: identity, frame: proxy.frame(in: .named("multimodal-review-viewport"))))
+                })
+        }
+        .padding(16)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(.quaternary, in: RoundedRectangle(cornerRadius: 12))
+        .accessibilityElement(children: .contain)
+    }
+
+    private func alternatives(_ content: LocalMultimodalReviewContent) -> some View {
+        VStack(alignment: .leading, spacing: 10) {
+            Text("Alternatives").font(.headline)
+            ForEach(Array(content.alternatives.enumerated()), id: \.element.reference) { index, alternative in
+                Button {
+                    session.select(alternative.reference)
+                } label: {
+                    HStack(alignment: .top, spacing: 10) {
+                        Image(systemName: session.selected == alternative.reference ? "checkmark.circle.fill" : "circle")
+                        Text(verbatim: alternative.value).frame(maxWidth: .infinity, alignment: .leading)
+                    }
+                }
+                .buttonStyle(.bordered)
+                .accessibilityIdentifier("review-alternative-\(index + 1)")
+                .focused($focusedControl, equals: "alternative-\(index + 1)")
+                .accessibilityLabel(Text(verbatim: "Alternative \(index + 1): \(alternative.value)"))
+                .accessibilityValue(session.selected == alternative.reference ? "Selected" : "Not selected")
+                .disabled(!session.canAct)
+            }
+        }
+    }
+
+    private var actions: some View {
+        ViewThatFits(in: .horizontal) {
+            HStack(spacing: 12) { decisionButtons }
+            VStack(alignment: .leading, spacing: 12) { decisionButtons }
+        }
+    }
+
+    @ViewBuilder
+    private var decisionButtons: some View {
+        Button("Accept selected") { decide(.accept) }
+            .buttonStyle(.borderedProminent)
+            .focused($focusedControl, equals: "accept")
+            .reviewShortcut("a", enabled: focusedControl != nil)
+            .accessibilityIdentifier("review-accept")
+            .disabled(!session.canAccept)
+        Button("Reject alternatives") { decide(.reject) }
+            .buttonStyle(.bordered)
+            .focused($focusedControl, equals: "reject")
+            .reviewShortcut("r", enabled: focusedControl != nil)
+            .accessibilityIdentifier("review-reject")
+            .disabled(!session.canAct)
+        Button("Defer") { decide(.defer) }
+            .buttonStyle(.bordered)
+            .focused($focusedControl, equals: "defer")
+            .reviewShortcut("d", enabled: focusedControl != nil)
+            .accessibilityIdentifier("review-defer")
+            .disabled(!session.canAct)
+    }
+
+    private func decide(_ choice: MultimodalReviewChoice) {
+        guard scenePhase == .active, let decision = session.decide(choice) else { return }
+        onDecision(decision)
+    }
+
+    private var hold: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            Label(holdMessage, systemImage: "hand.raised")
+                .accessibilityIdentifier("review-hold")
+            Button("Reload local evidence") { session.load() }
+                .buttonStyle(.bordered)
+                .accessibilityIdentifier("review-reload")
+            Text("No choice can be approved until the current source is displayed.")
+                .font(.caption).foregroundStyle(.secondary)
+        }
+    }
+
+    private var holdMessage: String {
+        switch session.refusal {
+        case .changed: return "The evidence changed. Request its current revision."
+        case .missing: return "The protected source is unavailable."
+        case .invalid, .unsupported: return "This source cannot be safely displayed."
+        case .unavailable: return "Local source access is unavailable."
+        default: return "Evidence is hidden until this view is active."
+        }
+    }
+}
+
+extension View {
+    @ViewBuilder
+    fileprivate func reviewShortcut(_ key: Character, enabled: Bool) -> some View {
+        #if os(watchOS)
+            self
+        #else
+            self.keyboardShortcut(enabled ? KeyboardShortcut(KeyEquivalent(key), modifiers: [.command, .shift]) : nil)
+        #endif
+    }
+}
diff --git a/swift/OpenMedKit/Tests/OpenMedKitTests/MultimodalReviewTests.swift b/swift/OpenMedKit/Tests/OpenMedKitTests/MultimodalReviewTests.swift
new file mode 100644
index 000000000..811fb4a21
--- /dev/null
+++ b/swift/OpenMedKit/Tests/OpenMedKitTests/MultimodalReviewTests.swift
@@ -0,0 +1,285 @@
+import CoreGraphics
+import Foundation
+import XCTest
+
+@testable import OpenMedKit
+
+final class MultimodalReviewTests: XCTestCase {
+    @MainActor
+    private func loaded(_ id: String = "ambiguous_visual") throws -> (MultimodalReviewSession, MultimodalReviewFixtures.Source) {
+        let (review, source) = try MultimodalReviewFixtures.make(id)
+        let session = MultimodalReviewSession(review: review, source: source)
+        session.load()
+        return (session, source)
+    }
+
+    @MainActor
+    func testAllSharedSyntheticFixturesEnforceTheirExpectedState() throws {
+        let rows = try MultimodalReviewFixtures.rows()
+        XCTAssertEqual(Set(rows.map(\.id)), Set(["ambiguous_visual", "stale_evidence", "missing_content", "uncertain_speaker"]))
+        for row in rows {
+            let (session, _) = try loaded(row.id)
+            XCTAssertFalse(session.canAct, row.id)
+            if row.status == "current" {
+                XCTAssertNotNil(session.content, row.id)
+                session.markPresented(session.presentationID)
+                XCTAssertTrue(session.canAct, row.id)
+                session.select(session.review.alternatives[0])
+                let decision = try XCTUnwrap(session.decide(.accept), row.id)
+                XCTAssertEqual(decision.revision, row.revision)
+                XCTAssertEqual(decision.caseDigest, session.review.digest)
+                XCTAssertEqual(decision.evidenceDigest, session.review.evidence.evidenceDigest)
+                XCTAssertFalse(decision.allowsAutomaticFinalization)
+            } else {
+                XCTAssertNil(session.content, row.id)
+                XCTAssertEqual(session.refusal, row.status == "stale" ? .changed : .missing)
+                session.markPresented(session.presentationID)
+                XCTAssertNil(session.decide(.accept))
+                XCTAssertNil(session.decide(.reject))
+                XCTAssertNil(session.decide(.defer))
+            }
+        }
+    }
+
+    @MainActor
+    func testUnseenContentCannotSelectOrProduceAnyDecision() throws {
+        let (session, _) = try loaded()
+        session.select(session.review.alternatives[0])
+        XCTAssertNil(session.selected)
+        for choice in [MultimodalReviewChoice.accept, .reject, .defer] { XCTAssertNil(session.decide(choice)) }
+        session.markPresented(UUID())
+        XCTAssertFalse(session.canAct)
+        session.markPresented(session.presentationID)
+        XCTAssertNil(session.decide(.accept))
+        session.select(session.review.alternatives[1])
+        XCTAssertEqual(session.decide(.accept)?.alternativeReference, session.review.alternatives[1])
+    }
+
+    @MainActor
+    func testReloadAndHideInvalidatePresentationAndSelection() throws {
+        let (session, _) = try loaded()
+        let previous = session.presentationID
+        session.markPresented(previous)
+        session.select(session.review.alternatives[0])
+        session.load()
+        session.markPresented(previous)
+        XCTAssertFalse(session.canAct)
+        XCTAssertNil(session.selected)
+        session.markPresented(session.presentationID)
+        XCTAssertTrue(session.canAct)
+        session.hide()
+        XCTAssertNil(session.content)
+        XCTAssertFalse(session.canAct)
+        XCTAssertNil(session.decide(.reject))
+    }
+
+    @MainActor
+    func testEveryActionRechecksSourceRevisionAndClearsStaleContent() throws {
+        for choice in [MultimodalReviewChoice.accept, .reject, .defer] {
+            let (session, source) = try loaded()
+            session.markPresented(session.presentationID)
+            session.select(session.review.alternatives[0])
+            source.revision = String(repeating: "e", count: 64)
+            XCTAssertNil(session.decide(choice))
+            XCTAssertEqual(session.refusal, .changed)
+            XCTAssertNil(session.content)
+            XCTAssertFalse(session.canAct)
+        }
+    }
+
+    @MainActor
+    func testChangedDisplayContentCannotReuseAnUnchangedRevision() throws {
+        for changeImage in [false, true] {
+            let (session, source) = try loaded()
+            session.markPresented(session.presentationID)
+            session.select(session.review.alternatives[0])
+            let original = try XCTUnwrap(source.content)
+            source.content = try LocalMultimodalReviewContent(
+                revision: original.revision, sourceDigest: original.sourceDigest,
+                text: original.text, image: changeImage ? MultimodalReviewFixtures.image("17 ?") : original.image,
+                alternatives: changeImage
+                    ? original.alternatives
+                    : [
+                        LocalReviewAlternative(reference: original.alternatives[0].reference, value: "Changed candidate"),
+                        original.alternatives[1],
+                    ])
+            XCTAssertNil(session.decide(.accept))
+            XCTAssertEqual(session.refusal, .changed)
+            XCTAssertNil(session.content)
+        }
+    }
+
+    @MainActor
+    func testRevokedMissingAndNonlocalSourcesCannotProduceDecisions() throws {
+        for failure in 0..<3 {
+            let (session, source) = try loaded()
+            session.markPresented(session.presentationID)
+            session.select(session.review.alternatives[0])
+            if failure == 0 { source.revision = nil }
+            if failure == 1 { source.content = nil }
+            if failure == 2 { source.localOnly = false }
+            XCTAssertNil(session.decide(.accept))
+            XCTAssertEqual(session.refusal, failure == 2 ? .unavailable : .missing)
+            XCTAssertNil(session.content)
+        }
+    }
+
+    @MainActor
+    func testRejectAndDeferDoNotChooseAnAlternativeOrAllowReplay() throws {
+        for choice in [MultimodalReviewChoice.reject, .defer] {
+            let (session, _) = try loaded("uncertain_speaker")
+            session.markPresented(session.presentationID)
+            let decision = try XCTUnwrap(session.decide(choice))
+            XCTAssertEqual(decision.choice, choice)
+            XCTAssertNil(decision.alternativeReference)
+            XCTAssertFalse(decision.allowsAutomaticFinalization)
+            XCTAssertNil(session.decide(choice))
+            session.load()
+            XCTAssertNil(session.content)
+            XCTAssertTrue(session.completed)
+        }
+    }
+
+    @MainActor
+    func testSourceBindingAndAlternativeOrderMustMatchTheCase() throws {
+        for changedSource in [true, false] {
+            let (session, source) = try loaded()
+            let old = try XCTUnwrap(source.content)
+            source.content = try LocalMultimodalReviewContent(
+                revision: old.revision, sourceDigest: changedSource ? String(repeating: "e", count: 64) : old.sourceDigest,
+                text: old.text, image: old.image,
+                alternatives: changedSource ? old.alternatives : old.alternatives.reversed())
+            session.load()
+            XCTAssertEqual(session.refusal, .changed)
+            XCTAssertNil(session.content)
+        }
+    }
+
+    @MainActor
+    func testTextScalarBoundsAndPrivacyDescriptions() throws {
+        let (session, source) = try loaded("uncertain_speaker")
+        let old = try XCTUnwrap(source.content)
+        XCTAssertEqual(String(reflecting: old), "LocalMultimodalReviewContent(content=<private>)")
+        XCTAssertEqual(String(reflecting: old.alternatives[0]), "LocalReviewAlternative(value=<private>)")
+        source.content = try LocalMultimodalReviewContent(
+            revision: old.revision, sourceDigest: old.sourceDigest, text: "different length", alternatives: old.alternatives)
+        session.load()
+        XCTAssertEqual(session.refusal, .invalid)
+        XCTAssertNil(session.content)
+    }
+
+    @MainActor
+    func testInvalidReviewMetadataAndUnboundedContentAreRefused() throws {
+        let (review, source) = try MultimodalReviewFixtures.make("ambiguous_visual")
+        XCTAssertThrowsError(
+            try MultimodalReviewCase(
+                handle: review.handle, evidence: review.evidence, revision: "private input", kind: review.kind,
+                alternatives: review.alternatives, uncertainty: review.uncertainty))
+        XCTAssertThrowsError(
+            try MultimodalReviewCase(
+                handle: review.handle, evidence: review.evidence, revision: review.revision, kind: .speakerRole,
+                alternatives: review.alternatives, uncertainty: [.uncertainSpeaker]))
+        XCTAssertThrowsError(
+            try MultimodalReviewCase(
+                handle: review.handle, evidence: review.evidence, revision: review.revision, kind: review.kind,
+                alternatives: [review.alternatives[0], review.alternatives[0]], uncertainty: review.uncertainty))
+        XCTAssertThrowsError(try LocalReviewAlternative(reference: review.alternatives[0], value: String(repeating: "x", count: 4097)))
+        XCTAssertThrowsError(
+            try LocalMultimodalReviewContent(
+                revision: review.revision, sourceDigest: review.sourceDigest, text: String(repeating: "x", count: 16_385),
+                alternatives: try XCTUnwrap(source.content).alternatives))
+    }
+
+    @MainActor
+    func testChangingHandleChangesCaseIdentityWithoutChangingEvidence() throws {
+        let (original, _) = try MultimodalReviewFixtures.make("ambiguous_visual")
+        let other = try MultimodalReviewCase(
+            handle: LocalMultimodalReviewHandle(), evidence: original.evidence, revision: original.revision,
+            kind: original.kind, alternatives: original.alternatives, uncertainty: original.uncertainty)
+        XCTAssertNotEqual(original.digest, other.digest)
+        XCTAssertEqual(original.evidence.evidenceDigest, other.evidence.evidenceDigest)
+    }
+    @MainActor
+    private final class ChangingSource: LocalMultimodalReviewSource {
+        var localOnly = true
+        var revision: String?
+        var content: LocalMultimodalReviewContent?
+        var duringResolve: (() throws -> Void)?
+        func currentRevision(_ handle: LocalMultimodalReviewHandle) throws -> String? { revision }
+        func resolve(_ handle: LocalMultimodalReviewHandle) throws -> LocalMultimodalReviewContent? {
+            try duringResolve?()
+            return content
+        }
+    }
+
+    @MainActor
+    func testSourceChangesAndPrivateErrorsDuringResolutionAreHeld() throws {
+        for mode in 0..<3 {
+            let (review, fixture) = try MultimodalReviewFixtures.make("ambiguous_visual")
+            let source = ChangingSource()
+            source.revision = fixture.revision
+            source.content = fixture.content
+            let session = MultimodalReviewSession(review: review, source: source)
+            session.load()
+            session.markPresented(session.presentationID)
+            session.select(review.alternatives[0])
+            source.duringResolve = { [weak source] in
+                if mode == 0 { source?.revision = String(repeating: "e", count: 64) }
+                if mode == 1 { source?.localOnly = false }
+                if mode == 2 { throw NSError(domain: "synthetic-private-payload", code: 1) }
+            }
+            XCTAssertNil(session.decide(.accept))
+            XCTAssertEqual(session.refusal, mode == 0 ? .changed : .unavailable)
+            XCTAssertNil(session.content)
+            XCTAssertFalse(session.canAct)
+        }
+    }
+
+    @MainActor
+    func testProvisionalTranscriptMayDeferButCannotBeAccepted() throws {
+        let (original, source) = try MultimodalReviewFixtures.make("uncertain_speaker")
+        var wire = try XCTUnwrap(JSONSerialization.jsonObject(with: original.evidence.toJSON()) as? [String: Any])
+        var payload = try XCTUnwrap(wire["payload"] as? [String: Any])
+        payload["finalized"] = false
+        wire["payload"] = payload
+        wire.removeValue(forKey: "evidence_digest")
+        wire["evidence_digest"] = String(ClinicalBrief.hash(try ClinicalBrief.canonical(wire)).dropFirst(7))
+        let review = try MultimodalReviewCase(
+            handle: original.handle, evidence: MultimodalPacket.fromJSON(ClinicalBrief.canonical(wire)),
+            revision: original.revision, kind: original.kind, alternatives: original.alternatives,
+            uncertainty: [.uncertainSpeaker, .provisionalTranscript])
+        let session = MultimodalReviewSession(review: review, source: source)
+        session.load()
+        session.markPresented(session.presentationID)
+        session.select(review.alternatives[0])
+        XCTAssertFalse(session.canAccept)
+        XCTAssertNil(session.decide(.accept))
+        XCTAssertEqual(session.refusal, .provisional)
+        XCTAssertEqual(session.decide(.defer)?.choice, .defer)
+    }
+
+    @MainActor
+    func testSourcePixelMutationCannotChangeOwnedDisplayedImage() throws {
+        let (review, fixture) = try MultimodalReviewFixtures.make("ambiguous_visual")
+        let storage = UnsafeMutableRawPointer.allocate(byteCount: 4, alignment: 4)
+        storage.storeBytes(of: UInt32.max, as: UInt32.self)
+        let provider = try XCTUnwrap(
+            CGDataProvider(dataInfo: nil, data: storage, size: 4) { _, pointer, _ in
+                pointer.deallocate()
+            })
+        let image = try XCTUnwrap(
+            CGImage(
+                width: 1, height: 1, bitsPerComponent: 8, bitsPerPixel: 32, bytesPerRow: 4,
+                space: CGColorSpace(name: CGColorSpace.sRGB)!,
+                bitmapInfo: CGBitmapInfo(rawValue: CGImageAlphaInfo.premultipliedLast.rawValue),
+                provider: provider, decode: nil, shouldInterpolate: false, intent: .defaultIntent))
+        let content = try LocalMultimodalReviewContent(
+            revision: review.revision, sourceDigest: review.sourceDigest, image: image,
+            alternatives: XCTUnwrap(fixture.content).alternatives)
+        let before = try XCTUnwrap(content.image?.dataProvider?.data) as Data
+        storage.storeBytes(of: UInt32.zero, as: UInt32.self)
+        XCTAssertEqual(try XCTUnwrap(content.image?.dataProvider?.data) as Data, before)
+        XCTAssertNotEqual(try XCTUnwrap(image.dataProvider?.data) as Data, before)
+    }
