diff --git a/openmed/training/synthetic/fhir_records.py b/openmed/training/synthetic/fhir_records.py
new file mode 100644
index 0000000000..5c6081c02d
--- /dev/null
+++ b/openmed/training/synthetic/fhir_records.py
@@ -0,0 +1,434 @@
+"""Referentially closed synthetic FHIR fixtures from existing Journey fact graphs."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from collections.abc import Mapping
+from datetime import date, datetime, timezone
+from itertools import islice
+
+from openmed.clinical.exporters.fhir.bundle import to_bundle
+from openmed.clinical.exporters.fhir.validate import validate_bundle
+from openmed.clinical.journey_contracts import ClinicalFact
+
+_CODE = re.compile(r"[a-z][a-z0-9_]{0,63}")
+_SYSTEM = "urn:openmed:synthetic-facts"
+_TYPES = {
+    "condition": "Condition",
+    "medication": "MedicationStatement",
+    "laboratory": "Observation",
+    "procedure": "Procedure",
+    "outcome": "Observation",
+}
+
+
+def _resource_id(kind: str, source: str, seed: int) -> str:
+    return hashlib.sha256(f"{kind}:{source}:{seed}".encode()).hexdigest()[:32]
+
+
+def _synthetic_facts(facts: tuple[ClinicalFact, ...]) -> tuple[ClinicalFact, ...]:
+    facts = tuple(islice(facts, 1001))
+    if (
+        not facts
+        or len(facts) > 1000
+        or any(not isinstance(f, ClinicalFact) for f in facts)
+    ):
+        raise ValueError("invalid synthetic FHIR fact collection")
+    if len({f.fact_id for f in facts}) != len(facts):
+        raise ValueError("duplicate synthetic FHIR fact identity")
+    indexed = {f.fact_id: f for f in facts}
+    for fact in facts:
+        if (
+            fact.attributes.get("synthetic") is not True
+            or fact.status != "synthetic"
+            or fact.fact_type not in _TYPES.keys() | {"encounter"}
+        ):
+            raise ValueError("FHIR fixture requires declared synthetic facts")
+        if not isinstance(fact.value, Mapping) or set(fact.value) != {"synthetic_code"}:
+            raise ValueError("invalid synthetic FHIR fact value")
+        code = fact.value["synthetic_code"]
+        if not isinstance(code, str) or not _CODE.fullmatch(code):
+            raise ValueError("invalid synthetic FHIR terminology placeholder")
+        effective = fact.effective_time.get("date")
+        observed = fact.attributes.get("observed_at")
+        try:
+            day = date.fromisoformat(effective)
+            stamp = datetime.fromisoformat(observed)
+            if stamp.tzinfo is None or day > stamp.date():
+                raise ValueError
+        except (ValueError, TypeError):
+            raise ValueError("invalid synthetic FHIR fact chronology") from None
+        for parent_id in fact.parent_fact_ids:
+            parent = indexed.get(parent_id)
+            if (
+                parent is None
+                or parent.subject_id != fact.subject_id
+                or parent.effective_time.get("date", "") > effective
+            ):
+                raise ValueError("invalid synthetic FHIR parent reference")
+    completed = set()
+    remaining = set(indexed)
+    while remaining:
+        ready = {
+            code
+            for code in remaining
+            if set(indexed[code].parent_fact_ids) <= completed
+        }
+        if not ready:
+            raise ValueError("synthetic graph contains a causal cycle")
+        completed |= ready
+        remaining -= ready
+    return tuple(
+        sorted(
+            facts,
+            key=lambda f: (
+                f.subject_id,
+                f.effective_time["date"],
+                f.fact_type,
+                f.fact_id,
+            ),
+        )
+    )
+
+
+def generate_fhir_records(
+    facts: tuple[ClinicalFact, ...], *, seed: int = 0
+) -> dict[str, object]:
+    """Create an offline synthetic R4 collection Bundle with no write requests.
+
+    Inputs use the existing ClinicalFact graph and explicit synthetic markers.
+    Terminology is local placeholder coding; no restricted vocabularies or
+    inferred clinical states are introduced.
+    """
+    if type(seed) is not int or not 0 <= seed <= 2**63 - 1:
+        raise ValueError("invalid synthetic FHIR seed")
+    facts = _synthetic_facts(facts)
+    subjects = sorted({f.subject_id for f in facts})
+    patient_ids = {s: _resource_id("Patient", s, seed) for s in subjects}
+    encounters = {}
+    for fact in facts:
+        if fact.fact_type == "encounter":
+            if fact.encounter_id is None or fact.encounter_id in encounters:
+                raise ValueError("invalid synthetic FHIR encounter inventory")
+            encounters[fact.encounter_id] = fact
+    for fact in facts:
+        encounter = encounters.get(fact.encounter_id)
+        if (
+            encounter is None
+            or encounter.subject_id != fact.subject_id
+            or encounter.effective_time["date"] > fact.effective_time["date"]
+        ):
+            raise ValueError("synthetic FHIR fact has no matching encounter")
+    encounter_ids = {e: _resource_id("Encounter", e, seed) for e in encounters}
+    resources = []
+    tag = {"tag": [{"system": _SYSTEM, "code": "synthetic"}]}
+    for subject in subjects:
+        resources.append(
+            {"resourceType": "Patient", "id": patient_ids[subject], "meta": tag}
+        )
+    for encounter_id, fact in sorted(encounters.items()):
+        resources.append(
+            {
+                "resourceType": "Encounter",
+                "id": encounter_ids[encounter_id],
+                "meta": tag,
+                "status": "unknown",
+                "class": {
+                    "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
+                    "code": "AMB",
+                },
+                "subject": {"reference": "Patient/" + patient_ids[fact.subject_id]},
+                "period": {"start": fact.effective_time["date"]},
+            }
+        )
+    targets = {}
+    for fact in facts:
+        if fact.fact_type == "encounter":
+            targets[fact.fact_id] = "Encounter/" + encounter_ids[fact.encounter_id]
+            continue
+        kind = _TYPES[fact.fact_type]
+        resource_id = _resource_id(kind, fact.fact_id, seed)
+        resource = {
+            "resourceType": kind,
+            "id": resource_id,
+            "meta": tag,
+            "subject": {"reference": "Patient/" + patient_ids[fact.subject_id]},
+        }
+        code = {"coding": [{"system": _SYSTEM, "code": fact.value["synthetic_code"]}]}
+        encounter = {"reference": "Encounter/" + encounter_ids[fact.encounter_id]}
+        effective = fact.effective_time["date"]
+        if kind == "MedicationStatement":
+            resource.update(
+                status="unknown",
+                medicationCodeableConcept=code,
+                context=encounter,
+                effectiveDateTime=effective,
+            )
+        elif kind == "Condition":
+            resource.update(code=code, encounter=encounter, onsetDateTime=effective)
+        elif kind == "Procedure":
+            resource.update(
+                status="unknown",
+                code=code,
+                encounter=encounter,
+                performedDateTime=effective,
+            )
+        else:
+            resource.update(
+                status="final",
+                code=code,
+                encounter=encounter,
+                effectiveDateTime=effective,
+                valueString=fact.value["synthetic_code"],
+            )
+        resources.append(resource)
+        targets[fact.fact_id] = kind + "/" + resource_id
+    for fact in facts:
+        resources.append(
+            {
+                "resourceType": "Provenance",
+                "id": _resource_id("Provenance", fact.fact_id, seed),
+                "meta": tag,
+                "target": [{"reference": targets[fact.fact_id]}],
+                "recorded": fact.attributes["observed_at"],
+                "agent": [
+                    {
+                        "who": {
+                            "identifier": {
+                                "system": _SYSTEM,
+                                "value": "synthetic_fixture_generator",
+                            }
+                        }
+                    }
+                ],
+                "entity": [
+                    {
+                        "role": "source",
+                        "what": {
+                            "identifier": {"system": _SYSTEM, "value": fact.fact_id}
+                        },
+                    }
+                ],
+            }
+        )
+    bundle = to_bundle(
+        resources, doc_id="synthetic-fhir-" + str(seed), bundle_type="collection"
+    )
+    if validate_synthetic_fhir(bundle):
+        raise ValueError("synthetic FHIR generation failed fixture constraints")
+    return bundle
+
+
+def validate_synthetic_fhir(bundle: Mapping[str, object]) -> tuple[str, ...]:
+    """Independently check cardinality subset, references, synthetic tags and time.
+
+    OpenMed's bundled validator covers a base R4 subset, not full server or
+    implementation-guide conformance. Patient/Provenance receive explicit
+    fixture checks here; no broader conformance assurance is inferred.
+    """
+    if (
+        not isinstance(bundle, Mapping)
+        or not isinstance(bundle.get("entry"), list)
+        or len(bundle["entry"]) > 3000
+    ):
+        raise ValueError("invalid synthetic FHIR bundle")
+    errors = set()
+    if bundle.get("resourceType") != "Bundle" or bundle.get("type") != "collection":
+        errors.add("fixture_bundle_type")
+    if not validate_bundle(bundle).is_valid:
+        errors.add("base_cardinality_or_type")
+    indexed = {}
+    for entry in bundle["entry"]:
+        if not isinstance(entry, Mapping) or not isinstance(
+            entry.get("resource"), Mapping
+        ):
+            errors.add("entry_structure")
+            continue
+        if "request" in entry:
+            errors.add("unexpected_write_request")
+        fullurl = entry.get("fullUrl")
+        if not isinstance(fullurl, str) or fullurl in indexed:
+            errors.add("duplicate_or_missing_fullurl")
+            continue
+        resource = entry["resource"]
+        indexed[fullurl] = resource
+        meta = resource.get("meta")
+        if (
+            not isinstance(meta, Mapping)
+            or not isinstance(meta.get("tag"), list)
+            or {"system": _SYSTEM, "code": "synthetic"} not in meta["tag"]
+        ):
+            errors.add("synthetic_tag_missing")
+
+    inspected = 0
+
+    def references(value):
+        nonlocal inspected
+        pending = [(value, 0)]
+        seen = set()
+        found = []
+        while pending:
+            node, depth = pending.pop()
+            inspected += 1
+            if inspected > 100000 or depth > 32:
+                raise ValueError("synthetic FHIR reference inspection limit exceeded")
+            if isinstance(node, (Mapping, list)):
+                if id(node) in seen:
+                    continue
+                seen.add(id(node))
+                if len(node) + len(pending) > 100000:
+                    raise ValueError(
+                        "synthetic FHIR reference inspection limit exceeded"
+                    )
+                if isinstance(node, Mapping):
+                    if "reference" in node:
+                        found.append(node["reference"])
+                    pending.extend((child, depth + 1) for child in node.values())
+                else:
+                    pending.extend((child, depth + 1) for child in node)
+        return found
+
+    provenance_targets = set()
+    provenance_sources = set()
+
+    def instant(value):
+        if not isinstance(value, str):
+            raise ValueError
+        if len(value) == 10:
+            return datetime.combine(
+                date.fromisoformat(value), datetime.min.time(), timezone.utc
+            )
+        parsed = datetime.fromisoformat(value)
+        if parsed.tzinfo is None:
+            raise ValueError
+        return parsed
+
+    for resource in indexed.values():
+        try:
+            refs = references(resource)
+        except ValueError:
+            errors.add("reference_structure_limit")
+            continue
+        if any(not isinstance(ref, str) or ref not in indexed for ref in refs):
+            errors.add("dangling_reference")
+        if resource.get("resourceType") == "Provenance":
+            if (
+                not resource.get("target")
+                or not resource.get("agent")
+                or not isinstance(resource.get("recorded"), str)
+            ):
+                errors.add("provenance_incomplete")
+            targets = resource.get("target")
+            entities = resource.get("entity")
+            if (
+                not isinstance(targets, list)
+                or len(targets) != 1
+                or not isinstance(targets[0], Mapping)
+                or not isinstance(targets[0].get("reference"), str)
+            ):
+                errors.add("provenance_incomplete")
+            else:
+                target = targets[0]["reference"]
+                if (
+                    target in provenance_targets
+                    or target not in indexed
+                    or indexed[target].get("resourceType") in {"Patient", "Provenance"}
+                ):
+                    errors.add("provenance_target_mismatch")
+                provenance_targets.add(target)
+                target_resource = indexed.get(target, {})
+                target_period = target_resource.get("period")
+                effective = target_resource.get(
+                    "effectiveDateTime",
+                    target_resource.get(
+                        "onsetDateTime",
+                        target_resource.get(
+                            "performedDateTime",
+                            target_period.get("start")
+                            if isinstance(target_period, Mapping)
+                            else None,
+                        ),
+                    ),
+                )
+                try:
+                    recorded_value = resource.get("recorded")
+                    if not isinstance(recorded_value, str):
+                        raise ValueError
+                    recorded_time = datetime.fromisoformat(recorded_value)
+                    if recorded_time.tzinfo is None:
+                        raise ValueError
+                    if effective is not None and recorded_time < instant(effective):
+                        errors.add("provenance_before_target")
+                except (TypeError, ValueError):
+                    errors.add("provenance_time_invalid")
+            if (
+                not isinstance(entities, list)
+                or len(entities) != 1
+                or not isinstance(entities[0], Mapping)
+            ):
+                errors.add("provenance_source_missing")
+            else:
+                entity = entities[0]
+                what = entity.get("what")
+                identifier = (
+                    what.get("identifier") if isinstance(what, Mapping) else None
+                )
+                if (
+                    not isinstance(identifier, Mapping)
+                    or identifier.get("system") != _SYSTEM
+                    or not isinstance(identifier.get("value"), str)
+                    or not re.fullmatch(r"fact_[0-9a-f]{16,64}", identifier["value"])
+                    or entity.get("role") != "source"
+                ):
+                    errors.add("provenance_source_missing")
+                else:
+                    source = identifier["value"]
+                    if source in provenance_sources:
+                        errors.add("provenance_source_duplicate")
+                    provenance_sources.add(source)
+            continue
+        if resource.get("resourceType") == "Patient":
+            continue
+        subject = resource.get("subject")
+        subject_ref = subject.get("reference") if isinstance(subject, Mapping) else None
+        if (
+            not isinstance(subject_ref, str)
+            or indexed.get(subject_ref, {}).get("resourceType") != "Patient"
+        ):
+            errors.add("subject_reference_type")
+        encounter_node = resource.get("encounter", resource.get("context", {}))
+        if not isinstance(encounter_node, Mapping):
+            errors.add("encounter_reference_structure")
+            continue
+        encounter_ref = encounter_node.get("reference")
+        if encounter_ref is not None and not isinstance(encounter_ref, str):
+            errors.add("encounter_reference_structure")
+            continue
+        encounter = indexed.get(encounter_ref)
+        effective = resource.get(
+            "effectiveDateTime",
+            resource.get("onsetDateTime", resource.get("performedDateTime")),
+        )
+        if resource.get("resourceType") != "Encounter":
+            if encounter is None or encounter.get("resourceType") != "Encounter":
+                errors.add("encounter_reference_type")
+            elif encounter.get("subject") != resource.get("subject"):
+                errors.add("encounter_subject_mismatch")
+        if encounter is not None and effective is not None:
+            try:
+                period = encounter.get("period")
+                if not isinstance(period, Mapping) or instant(
+                    period.get("start")
+                ) > instant(effective):
+                    errors.add("clinical_time_before_encounter")
+            except (TypeError, ValueError):
+                errors.add("clinical_time_invalid")
+    required_targets = {
+        ref
+        for ref, resource in indexed.items()
+        if resource.get("resourceType") not in {"Patient", "Provenance"}
+    }
+    if provenance_targets != required_targets:
+        errors.add("provenance_coverage_missing")
+    return tuple(sorted(errors))
diff --git a/openmed/training/synthetic/omop_cohorts.py b/openmed/training/synthetic/omop_cohorts.py
new file mode 100644
index 0000000000..e71378fb88
--- /dev/null
+++ b/openmed/training/synthetic/omop_cohorts.py
@@ -0,0 +1,413 @@
+"""Coherent synthetic OMOP-shaped cohorts from existing Journey clinical facts."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from collections.abc import Mapping
+from datetime import date
+from itertools import islice
+
+from openmed.clinical.journey_contracts import ClinicalFact, sha256_digest
+from openmed.interop.omop_cohort_check import validate_omop_cohort_export
+
+_CODE = re.compile(r"[a-z][a-z0-9_]{0,63}")
+_DOMAINS = {
+    "condition": ("condition_occurrence", "condition", "Condition"),
+    "medication": ("drug_exposure", "drug", "Drug"),
+    "laboratory": ("measurement", "measurement", "Measurement"),
+    "procedure": ("procedure_occurrence", "procedure", "Procedure"),
+    "outcome": ("observation", "observation", "Observation"),
+}
+
+
+def _identity(namespace: str, value: str, seed: int) -> int:
+    # Keep IDs inside positive signed BIGINT without aliasing textual identities.
+    return (
+        int(hashlib.sha256(f"{namespace}:{value}:{seed}".encode()).hexdigest()[:15], 16)
+        + 1
+    )
+
+
+def generate_omop_cohort(
+    facts: tuple[ClinicalFact, ...],
+    *,
+    seed: int = 0,
+    cohort_condition_codes: tuple[str, ...] = (),
+) -> dict[str, object]:
+    """Create relational synthetic person/visit/condition/drug/measurement fixtures.
+
+    Local concepts are explicit OPENMED_SYNTHETIC placeholders, not Athena,
+    SNOMED, CPT or standard clinical vocabulary claims. No database writes occur.
+    """
+    if type(seed) is not int or not 0 <= seed <= 2**63 - 1:
+        raise ValueError("invalid synthetic OMOP seed")
+    facts = tuple(islice(facts, 1001))
+    if (
+        not facts
+        or len(facts) > 1000
+        or any(not isinstance(f, ClinicalFact) for f in facts)
+    ):
+        raise ValueError("invalid synthetic OMOP fact collection")
+    criteria = tuple(islice(cohort_condition_codes, 129))
+    if (
+        len(criteria) > 128
+        or any(not isinstance(c, str) or not _CODE.fullmatch(c) for c in criteria)
+        or len(set(criteria)) != len(criteria)
+    ):
+        raise ValueError("invalid synthetic OMOP cohort criteria")
+    if len({f.fact_id for f in facts}) != len(facts):
+        raise ValueError("duplicate synthetic OMOP fact identity")
+    facts = tuple(sorted(facts, key=lambda f: (f.subject_id, f.fact_id)))
+    encounters = {}
+    for fact in facts:
+        if (
+            fact.attributes.get("synthetic") is not True
+            or fact.status != "synthetic"
+            or fact.fact_type not in _DOMAINS.keys() | {"encounter"}
+        ):
+            raise ValueError("OMOP fixture requires declared synthetic facts")
+        if not isinstance(fact.value, Mapping) or set(fact.value) != {"synthetic_code"}:
+            raise ValueError("invalid synthetic OMOP fact value")
+        code = fact.value["synthetic_code"]
+        if not isinstance(code, str) or not _CODE.fullmatch(code):
+            raise ValueError("invalid synthetic OMOP concept placeholder")
+        try:
+            effective = fact.effective_time["date"]
+            if (
+                not isinstance(effective, str)
+                or date.fromisoformat(effective).isoformat() != effective
+            ):
+                raise ValueError
+        except (ValueError, KeyError, TypeError):
+            raise ValueError("invalid synthetic OMOP effective date") from None
+        if fact.fact_type == "encounter":
+            if fact.encounter_id is None or fact.encounter_id in encounters:
+                raise ValueError("invalid synthetic OMOP encounter inventory")
+            encounters[fact.encounter_id] = fact
+    indexed = {f.fact_id: f for f in facts}
+    for fact in facts:
+        encounter = encounters.get(fact.encounter_id)
+        if (
+            encounter is None
+            or encounter.subject_id != fact.subject_id
+            or encounter.effective_time["date"] > fact.effective_time["date"]
+        ):
+            raise ValueError("invalid synthetic OMOP visit relationship")
+        if any(
+            p not in indexed
+            or indexed[p].subject_id != fact.subject_id
+            or indexed[p].effective_time["date"] > fact.effective_time["date"]
+            for p in fact.parent_fact_ids
+        ):
+            raise ValueError("invalid synthetic OMOP parent relationship")
+    completed = set()
+    remaining = set(indexed)
+    while remaining:
+        ready = {
+            code
+            for code in remaining
+            if set(indexed[code].parent_fact_ids) <= completed
+        }
+        if not ready:
+            raise ValueError("synthetic graph contains a causal cycle")
+        completed |= ready
+        remaining -= ready
+    subjects = sorted({f.subject_id for f in facts})
+    persons = {subject: _identity("person", subject, seed) for subject in subjects}
+    visits = {
+        encounter: _identity("visit", encounter, seed) for encounter in encounters
+    }
+    tables = {
+        name: []
+        for name in (
+            "concept",
+            "person",
+            "visit_occurrence",
+            "note",
+            "condition_occurrence",
+            "drug_exposure",
+            "measurement",
+            "procedure_occurrence",
+            "observation",
+        )
+    }
+    tables["concept"].append(
+        {
+            "concept_id": 0,
+            "concept_name": "No matching synthetic concept",
+            "domain_id": "Metadata",
+            "vocabulary_id": "OPENMED_SYNTHETIC",
+            "concept_class_id": "Synthetic",
+            "standard_concept": "",
+            "concept_code": "0",
+            "synthetic": True,
+        }
+    )
+    for subject in subjects:
+        first_visit_year = min(
+            int(fact.effective_time["date"][:4])
+            for fact in facts
+            if fact.subject_id == subject
+        )
+        synthetic_birth_year = max(1, first_visit_year - 30)
+        tables["person"].append(
+            {
+                "person_id": persons[subject],
+                "gender_concept_id": 0,
+                "year_of_birth": synthetic_birth_year,
+                "race_concept_id": 0,
+                "ethnicity_concept_id": 0,
+                "person_source_value": "synthetic_person",
+                "synthetic": True,
+            }
+        )
+    for encounter, fact in sorted(encounters.items()):
+        related = [
+            f.effective_time["date"] for f in facts if f.encounter_id == encounter
+        ]
+        tables["visit_occurrence"].append(
+            {
+                "visit_occurrence_id": visits[encounter],
+                "person_id": persons[fact.subject_id],
+                "visit_concept_id": 0,
+                "visit_source_concept_id": 0,
+                "visit_type_concept_id": 0,
+                "visit_start_date": fact.effective_time["date"],
+                "visit_end_date": max(related),
+                "synthetic": True,
+            }
+        )
+    concepts = {}
+    for fact in facts:
+        if fact.fact_type == "encounter":
+            continue
+        table, prefix, domain = _DOMAINS[fact.fact_type]
+        code = fact.value["synthetic_code"]
+        concept_key = (domain, code)
+        if concept_key not in concepts:
+            concept_id = _identity("concept", domain + ":" + code, seed)
+            concepts[concept_key] = concept_id
+            tables["concept"].append(
+                {
+                    "concept_id": concept_id,
+                    "concept_name": code,
+                    "domain_id": domain,
+                    "vocabulary_id": "OPENMED_SYNTHETIC",
+                    "concept_class_id": "Synthetic",
+                    "standard_concept": "",
+                    "concept_code": code,
+                    "synthetic": True,
+                }
+            )
+        note_id = _identity("note", fact.fact_id, seed)
+        text = f"SYNTHETIC {fact.fact_type}: {code}"
+        note_hash = sha256_digest(text).removeprefix("sha256:")
+        tables["note"].append(
+            {
+                "note_id": note_id,
+                "person_id": persons[fact.subject_id],
+                "visit_occurrence_id": visits[fact.encounter_id],
+                "note_date": fact.effective_time["date"],
+                "note_text": text,
+                "source_note_hash": note_hash,
+                "synthetic": True,
+            }
+        )
+        row = {
+            prefix + "_id": _identity(table, fact.fact_id, seed),
+            "person_id": persons[fact.subject_id],
+            "visit_occurrence_id": visits[fact.encounter_id],
+            prefix + "_concept_id": concepts[concept_key],
+            prefix + "_source_concept_id": concepts[concept_key],
+            prefix + "_source_value": code,
+            "note_id": note_id,
+            "source_note_hash": note_hash,
+            "synthetic": True,
+        }
+        effective = fact.effective_time["date"]
+        if table == "condition_occurrence":
+            row.update(
+                condition_occurrence_id=row.pop("condition_id"),
+                condition_start_date=effective,
+                condition_end_date=effective,
+                condition_type_concept_id=0,
+            )
+        elif table == "drug_exposure":
+            row.update(
+                drug_exposure_id=row.pop("drug_id"),
+                drug_exposure_start_date=effective,
+                drug_exposure_end_date=effective,
+                drug_type_concept_id=0,
+            )
+        elif table == "procedure_occurrence":
+            row.update(
+                procedure_occurrence_id=row.pop("procedure_id"),
+                procedure_date=effective,
+                procedure_type_concept_id=0,
+            )
+        else:
+            row[prefix + "_date"] = effective
+            row[prefix + "_type_concept_id"] = 0
+            # Missing numeric truth stays missing, rather than fabricating measurements.
+            row["value_as_number"] = None
+        tables[table].append(row)
+    for table, rows in tables.items():
+        key = {
+            "concept": "concept_id",
+            "person": "person_id",
+            "visit_occurrence": "visit_occurrence_id",
+            "note": "note_id",
+        }.get(table, table + "_id")
+        rows.sort(key=lambda row: row[key])
+    condition_sets = {person: set() for person in persons.values()}
+    for row in tables["condition_occurrence"]:
+        condition_sets[row["person_id"]].add(row["condition_source_value"])
+    cohort = {
+        "required_condition_codes": sorted(criteria),
+        "member_person_ids": sorted(
+            person for person, codes in condition_sets.items() if set(criteria) <= codes
+        ),
+    }
+    result = {
+        "schema_version": "1.0.0",
+        "synthetic": True,
+        "tables": tables,
+        "cohort": cohort,
+    }
+    if validate_synthetic_omop(result):
+        raise ValueError("synthetic OMOP generation failed fixture constraints")
+    return result
+
+
+def validate_synthetic_omop(export: Mapping[str, object]) -> tuple[str, ...]:
+    """Independently check runtime relational rules, visit time and cohort membership."""
+    if not isinstance(export, Mapping) or not isinstance(export.get("tables"), Mapping):
+        raise ValueError("invalid synthetic OMOP export")
+    tables = export["tables"]
+    if any(
+        not isinstance(rows, (tuple, list))
+        or any(not isinstance(row, Mapping) for row in rows)
+        for rows in tables.values()
+    ):
+        raise ValueError("invalid synthetic OMOP row collection")
+    if sum(len(rows) for rows in tables.values()) > 10000:
+        raise ValueError("synthetic OMOP table limit exceeded")
+    errors = set()
+    if export.get("synthetic") is not True or export.get("schema_version") != "1.0.0":
+        errors.add("synthetic_provenance_missing")
+    if any(
+        row.get("synthetic") is not True for rows in tables.values() for row in rows
+    ):
+        errors.add("synthetic_row_marker_missing")
+    try:
+        relational_valid = validate_omop_cohort_export(tables).is_valid
+    except (TypeError, KeyError, ValueError, AttributeError):
+        relational_valid = False
+    if not relational_valid:
+        errors.add("relational_or_concept_constraint")
+        return tuple(sorted(errors))
+    cohort = export.get("cohort")
+    if not isinstance(cohort, Mapping) or set(cohort) != {
+        "required_condition_codes",
+        "member_person_ids",
+    }:
+        return tuple(sorted(errors | {"invalid_cohort_structure"}))
+    criteria, members = cohort["required_condition_codes"], cohort["member_person_ids"]
+    if (
+        not isinstance(criteria, list)
+        or len(criteria) > 128
+        or any(
+            not isinstance(code, str) or not _CODE.fullmatch(code) for code in criteria
+        )
+        or len(set(criteria)) != len(criteria)
+    ):
+        return tuple(sorted(errors | {"invalid_cohort_structure"}))
+    if (
+        not isinstance(members, list)
+        or len(members) > 10000
+        or any(type(person) is not int or not 1 <= person < 2**63 for person in members)
+        or len(set(members)) != len(members)
+    ):
+        return tuple(sorted(errors | {"invalid_cohort_structure"}))
+    visits = {r["visit_occurrence_id"]: r for r in tables.get("visit_occurrence", [])}
+    persons = {r["person_id"] for r in tables.get("person", [])}
+
+    def valid_date(value):
+        if not isinstance(value, str) or len(value) != 10:
+            return False
+        try:
+            date.fromisoformat(value)
+        except ValueError:
+            return False
+        return True
+
+    birth_years = {
+        r["person_id"]: r.get("year_of_birth") for r in tables.get("person", [])
+    }
+    for visit in visits.values():
+        start, end = visit.get("visit_start_date"), visit.get("visit_end_date")
+        if not valid_date(start) or not valid_date(end):
+            errors.add("invalid_visit_date")
+            continue
+        birth = birth_years.get(visit.get("person_id"))
+        if type(birth) is not int or not 1 <= birth <= int(start[:4]):
+            errors.add("invalid_birth_visit_chronology")
+        if start > end:
+            errors.add("visit_time_reversed")
+    dates = {
+        "condition_occurrence": "condition_start_date",
+        "drug_exposure": "drug_exposure_start_date",
+        "measurement": "measurement_date",
+        "procedure_occurrence": "procedure_date",
+        "observation": "observation_date",
+    }
+    for table, column in dates.items():
+        for row in tables.get(table, []):
+            value = row.get(column)
+            if not valid_date(value):
+                errors.add("invalid_event_date")
+                continue
+            visit = visits.get(row.get("visit_occurrence_id"))
+            if (
+                visit is not None
+                and valid_date(visit.get("visit_start_date"))
+                and valid_date(visit.get("visit_end_date"))
+                and not visit["visit_start_date"] <= value <= visit["visit_end_date"]
+            ):
+                errors.add("event_outside_visit")
+            if table in {"condition_occurrence", "drug_exposure"}:
+                end = (
+                    "condition_end_date"
+                    if table == "condition_occurrence"
+                    else "drug_exposure_end_date"
+                )
+                if not valid_date(row.get(end)):
+                    errors.add("invalid_event_date")
+                elif value > row[end]:
+                    errors.add("event_time_reversed")
+    conditions = {person: set() for person in persons}
+    for row in tables.get("condition_occurrence", []):
+        if row.get("person_id") in conditions:
+            conditions[row["person_id"]].add(row["condition_source_value"])
+    cohort = export.get("cohort", {})
+    if (
+        not isinstance(cohort, Mapping)
+        or not isinstance(cohort.get("required_condition_codes"), list)
+        or not isinstance(cohort.get("member_person_ids"), list)
+    ):
+        errors.add("invalid_cohort_structure")
+        cohort = {"required_condition_codes": [], "member_person_ids": []}
+    expected = sorted(
+        person
+        for person, codes in conditions.items()
+        if set(cohort.get("required_condition_codes", [])) <= codes
+    )
+    if expected != cohort.get("member_person_ids"):
+        errors.add("cohort_truth_mismatch")
+    for note in tables.get("note", []):
+        if not isinstance(note.get("note_text"), str) or note.get(
+            "source_note_hash"
+        ) != sha256_digest(note["note_text"]).removeprefix("sha256:"):
+            errors.add("synthetic_note_hash_mismatch")
+    return tuple(sorted(errors))
