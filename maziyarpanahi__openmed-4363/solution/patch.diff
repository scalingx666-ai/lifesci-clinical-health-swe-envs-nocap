+CRITICAL_IDENTIFIER_LABELS: tuple[str, ...] = (
+    "DATE",
+    "ID_NUM",
+    "PERSON",
+    "PHONE",
+    "STREET_ADDRESS",
+    "ZIPCODE",
+)
