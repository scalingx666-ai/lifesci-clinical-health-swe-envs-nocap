+REPOSITORY_EVIDENCE: tuple[str, ...] = (
+    "golden_i18n_fixture",
+    "language_pack",
+    "locale_phi_generator",
+    "manifest_model_language",
+    "national_id_only_route",
+    "national_id_validator",
+    "on_device_mlx_variant",
+    "user_supplied_model_route",
