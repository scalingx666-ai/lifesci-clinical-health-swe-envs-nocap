diff --git a/src/test/java/org/mitre/synthea/world/agents/behaviors/payeradjustment/PayerAdjustmentTest.java b/src/test/java/org/mitre/synthea/world/agents/behaviors/payeradjustment/PayerAdjustmentTest.java
