@@ -0,0 +1,62 @@
+"""Tests for running one-off data migrations at most once per instance."""
+
+from typing import Any
+from unittest.mock import MagicMock
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.orm import Session
+
+from app.models import DataMigration
+from app.services.data_migration_service import data_migration_service
+
+NAME = "test_migration"
+
+
+class TestDataMigrationService:
+    def test_clean_run_is_recorded_and_not_repeated(self, db: Session) -> None:
+        migrate = MagicMock(return_value=True)
+
+        data_migration_service.run(db, NAME, migrate)
+        data_migration_service.run(db, NAME, migrate)
+
+        migrate.assert_called_once()
+        assert db.get(DataMigration, NAME) is not None
+
+    def test_incomplete_run_is_retried(self, db: Session) -> None:
+        migrate = MagicMock(return_value=False)
+
+        data_migration_service.run(db, NAME, migrate)
+        data_migration_service.run(db, NAME, migrate)
+
+        assert migrate.call_count == 2
+        assert db.get(DataMigration, NAME) is None
+
+    def test_failed_run_is_not_recorded_and_releases_the_lock(self, db: Session) -> None:
+        with pytest.raises(RuntimeError):
+            data_migration_service.run(db, NAME, MagicMock(side_effect=RuntimeError("boom")))
+
+        assert db.get(DataMigration, NAME) is None
+        assert data_migration_service.repo.try_lock(db, NAME)
+        data_migration_service.repo.unlock(db, NAME)
+
+    def test_dry_run_is_never_recorded(self, db: Session) -> None:
+        migrate = MagicMock(return_value=True)
+
+        data_migration_service.run(db, NAME, migrate, dry_run=True)
+
+        migrate.assert_called_once()
+        assert db.get(DataMigration, NAME) is None
+
+    def test_run_held_by_another_instance_is_skipped(self, db: Session, engine: Any) -> None:
+        migrate = MagicMock(return_value=True)
+        key = {"key": f"data_migration:{NAME}"}
+        with engine.connect() as other:
+            other.execute(text("SELECT pg_advisory_lock(hashtextextended(:key, 0))"), key)
+            try:
+                data_migration_service.run(db, NAME, migrate)
+            finally:
+                other.execute(text("SELECT pg_advisory_unlock(hashtextextended(:key, 0))"), key)
+
+        migrate.assert_not_called()
+        assert db.get(DataMigration, NAME) is None
diff --git a/docs/dev-guides/data-migrations.mdx b/docs/dev-guides/data-migrations.mdx
index 4637a31267..849bd7863f 100644
--- a/docs/dev-guides/data-migrations.mdx
+++ b/docs/dev-guides/data-migrations.mdx
@@ -23,6 +23,18 @@ This automatic execution is **temporary**. Each entry in `app.sh` is gated by a
 
 The practical consequence: if you upgrade Open Wearables long after a migration shipped, the corresponding script may already have been removed from `app.sh` and **will not run automatically**. In that case, run it manually (see below). Scripts that were never added to `app.sh` must always be run manually.
 
+### Run-once scripts
+
+Some scripts are expensive to run even when there is nothing left to fix, because checking means scanning a large table. These run **at most once per instance**: a clean run writes a row with the script's name to the `data_migration` table, and from then on the script prints `already completed, skipping` and exits, both on startup and when run manually. A run that fails or is interrupted writes nothing, so it is retried on the next startup. When several replicas start at once, only one runs the script; the others skip it.
+
+To run such a script again, delete its row first:
+
+```sql
+DELETE FROM data_migration WHERE name = '<script_name>';
+```
+
+`--dry-run` never writes the row.
+
 ## Prerequisites
 
 The scripts import from the `app` package and connect to the database via the environment variables in `backend/config/.env`. You need:
