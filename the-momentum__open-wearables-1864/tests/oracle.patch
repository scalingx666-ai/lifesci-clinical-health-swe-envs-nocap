@@ -0,0 +1,25 @@
+from sqlalchemy import text
+from sqlalchemy.dialects.postgresql import insert
+
+from app.database import DbSession
+from app.models import DataMigration
+
+_LOCK_KEY = "data_migration:{name}"
+
+
+class DataMigrationRepository:
+    """Completion markers of one-off data migrations and the lock that keeps replicas from running one twice."""
+
+    def is_completed(self, db: DbSession, name: str) -> bool:
+        return db.get(DataMigration, name) is not None
+
+    def mark_completed(self, db: DbSession, name: str) -> None:
+        db.execute(insert(DataMigration).values(name=name).on_conflict_do_nothing())
+
+    def try_lock(self, db: DbSession, name: str) -> bool:
+        """Session-level lock, held across the migration's own commits until unlock."""
+        statement = text("SELECT pg_try_advisory_lock(hashtextextended(:key, 0))")
+        return bool(db.execute(statement, {"key": _LOCK_KEY.format(name=name)}).scalar())
+
+    def unlock(self, db: DbSession, name: str) -> None:
+        db.execute(text("SELECT pg_advisory_unlock(hashtextextended(:key, 0))"), {"key": _LOCK_KEY.format(name=name)})
diff --git a/backend/app/services/data_migration_service.py b/backend/app/services/data_migration_service.py
new file mode 100644
index 0000000000..e81c0d6d22
--- /dev/null
+++ b/backend/app/services/data_migration_service.py
@@ -0,0 +1,46 @@
+from collections.abc import Callable
+
+from app.database import DbSession
+from app.repositories.data_migration_repository import DataMigrationRepository
+
+
+class DataMigrationService:
+    """Runs one-off data migration scripts at most once per instance.
+
+    The scripts run at startup and report on stdout, so this prints rather than logs.
+    """
+
+    def __init__(self) -> None:
+        self.repo = DataMigrationRepository()
+
+    def run(self, db: DbSession, name: str, migrate: Callable[[], bool], *, dry_run: bool = False) -> None:
+        """Run migrate unless it already completed here or another instance is running it.
+
+        migrate returns True when it ran cleanly; only then is the migration recorded, so a failed
+        or interrupted run is retried on the next startup. The session must stay on one connection,
+        since the lock belongs to it.
+        """
+        if self.repo.is_completed(db, name):
+            print(f"{name}: already completed, skipping.")
+            return
+        if dry_run:
+            migrate()
+            return
+        if not self.repo.try_lock(db, name):
+            print(f"{name}: running on another instance, skipping.")
+            return
+        try:
+            # Another instance may have finished between the check above and taking the lock
+            if self.repo.is_completed(db, name):
+                print(f"{name}: already completed, skipping.")
+                return
+            if migrate():
+                self.repo.mark_completed(db, name)
+                db.commit()
+        finally:
+            db.rollback()
+            self.repo.unlock(db, name)
+            db.commit()
+
+
+data_migration_service = DataMigrationService()
