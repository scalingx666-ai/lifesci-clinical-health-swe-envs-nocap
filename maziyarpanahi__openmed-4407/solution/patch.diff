+    assert result.value is None and result.reason is GateReason.OUTPUT_EXPIRED
+
+
+@pytest.mark.parametrize(
+    "attribute,value",
+    [
+        ("thermal", ThermalState.CRITICAL),
+        ("available", 0),
+        ("pressure", MemoryPressure.CRITICAL),
+        ("thermal", None),
+        ("delay_ms", 501),
