+  PENDING: 'PENDING',
+  /** A save request is currently in progress. We're awaiting a response from the server */
   SAVING: 'SAVING',
+  /** The save request for the row failed */
   ERROR: 'ERROR',
+  /** The row failed validation (so a save request was not sent to the server) */
+  INVALID: 'INVALID',
