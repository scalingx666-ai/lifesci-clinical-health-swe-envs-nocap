diff --git a/src/integration-test/groovy/org/pih/warehouse/performance/spec/GetQuantityByBinLocationPerformanceSpec.groovy b/src/integration-test/groovy/org/pih/warehouse/performance/spec/GetQuantityByBinLocationPerformanceSpec.groovy
