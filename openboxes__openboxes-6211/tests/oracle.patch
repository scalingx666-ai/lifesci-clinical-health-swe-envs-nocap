diff --git a/src/main/webapp/css/openboxes-theme.css b/src/main/webapp/css/openboxes-theme.css
index ba21df61269..7ff3901efd4 100644
--- a/src/main/webapp/css/openboxes-theme.css
+++ b/src/main/webapp/css/openboxes-theme.css
@@ -1453,6 +1453,32 @@ th a:hover {
   overflow-wrap: anywhere;
 }
 
+/* Product > Stock levels tab: 16 columns. At natural width (nowrap headers,
+   max-content table) it spills past the page, and its tr.prop rows opt the
+   card out of in-card scrolling. Make it fit the card instead: headers wrap
+   at word boundaries and padding is tighter. */
+form[action$="/product/updateInventoryLevels"] > .box > table {
+  width: 100%;
+  min-width: 0;
+}
+
+form[action$="/product/updateInventoryLevels"] > .box > table th {
+  white-space: normal;
+  word-break: normal;
+  overflow-wrap: normal;
+  hyphens: none;
+  vertical-align: bottom;
+}
+
+form[action$="/product/updateInventoryLevels"] > .box > table th,
+form[action$="/product/updateInventoryLevels"] > .box > table td {
+  padding: 8px 6px;
+}
+
+form[action$="/product/updateInventoryLevels"] > .box > table td {
+  max-width: 200px;
+}
+
 .list tbody tr:hover {
   background: rgba(240, 246, 255, 0.5);
 }
