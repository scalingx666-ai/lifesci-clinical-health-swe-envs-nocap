+def _assert_no_sentinel(*values: object) -> None:
+    for value in values:
+        assert SENTINEL not in repr(value)
+        assert SENTINEL not in str(value)
+        if hasattr(value, "to_dict"):
+            assert SENTINEL not in json.dumps(value.to_dict(), sort_keys=True)
