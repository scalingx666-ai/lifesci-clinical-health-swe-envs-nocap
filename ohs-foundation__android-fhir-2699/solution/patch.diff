+package com.google.android.fhir.demo.helpers
+
+object ProgressHelper {
+
+  fun calculateProgressPercentage(total: Int, completed: Int): Int? {
+    return if (total > 0) {
+      (completed * 100) / total
+    } else {
+      null
+    }
+  }
+}
