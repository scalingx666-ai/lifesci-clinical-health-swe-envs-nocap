diff --git a/backend/tests/providers/google_health/test_google_sleep.py b/backend/tests/providers/google_health/test_google_sleep.py
new file mode 100644
index 0000000000..422e38eea9
--- /dev/null
+++ b/backend/tests/providers/google_health/test_google_sleep.py
@@ -0,0 +1,58 @@
+"""Google Health sleep sessions: typed as sleep_session so a re-fetched night updates in place."""
+
+from datetime import datetime, timezone
+from typing import Any
+from unittest.mock import MagicMock, patch
+from uuid import uuid4
+
+import pytest
+from sqlalchemy.orm import Session
+
+from app.models import EventRecord
+from app.schemas.enums import EventCategory
+from app.services.providers.google_health.sleep import GoogleHealthApiSleep
+from tests.factories import UserFactory
+
+WINDOW = (datetime(2026, 5, 1, tzinfo=timezone.utc), datetime(2026, 5, 3, tzinfo=timezone.utc))
+INTERVAL = {"startTime": "2026-05-01T22:10:00Z", "endTime": "2026-05-02T05:40:00Z", "startUtcOffset": "7200s"}
+STAGES = [
+    {"type": "LIGHT", "startTime": "2026-05-01T22:10:00Z", "endTime": "2026-05-02T01:00:00Z"},
+    {"type": "DEEP", "startTime": "2026-05-02T01:00:00Z", "endTime": "2026-05-02T05:40:00Z"},
+]
+
+
+def _point(**sleep: Any) -> dict[str, Any]:
+    return {
+        "name": "users/me/dataTypes/sleep/dataPoints/night-1",
+        "sleep": {"interval": INTERVAL, "summary": {"minutesInSleepPeriod": 450, "minutesAsleep": 420}, **sleep},
+    }
+
+
+@pytest.fixture
+def handler() -> GoogleHealthApiSleep:
+    return GoogleHealthApiSleep(oauth=MagicMock(), connection_repo=MagicMock(), api_base_url="https://x")
+
+
+def test_a_session_is_typed_as_sleep_session(handler: GoogleHealthApiSleep) -> None:
+    sleep = _point()["sleep"]
+    start, end = datetime(2026, 5, 1, 22, 10, tzinfo=timezone.utc), datetime(2026, 5, 2, 5, 40, tzinfo=timezone.utc)
+
+    record, _ = handler._normalize(_point(), sleep, INTERVAL, start, end, uuid4())
+
+    assert (record.category, record.type) == (EventCategory.SLEEP, "sleep_session")
+
+
+def test_a_re_fetched_night_refreshes_its_details_without_a_webhook(db: Session, handler: GoogleHealthApiSleep) -> None:
+    user = UserFactory()
+
+    with patch("app.services.event_record_service.on_sleep_created") as sleep_created:
+        with patch.object(handler, "_fetch", return_value=[_point()]):
+            handler.load_and_save(db, user.id, *WINDOW)
+        with patch.object(handler, "_fetch", return_value=[_point(stages=STAGES)]):
+            handler.load_and_save(db, user.id, *WINDOW)
+
+    records = db.query(EventRecord).filter(EventRecord.category == EventCategory.SLEEP).all()
+    assert len(records) == 1
+    db.refresh(records[0])
+    assert [stage["stage"] for stage in records[0].sleep_detail.sleep_stages] == ["light", "deep"]
+    sleep_created.assert_called_once()
diff --git a/backend/tests/scripts/test_backfill_google_sleep_type.py b/backend/tests/scripts/test_backfill_google_sleep_type.py
new file mode 100644
index 0000000000..d72995f725
--- /dev/null
+++ b/backend/tests/scripts/test_backfill_google_sleep_type.py
@@ -0,0 +1,68 @@
+"""Tests for the one-off typing of Google Health sleep rows saved without ``sleep_session``."""
+
+import importlib.util
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from types import ModuleType
+
+from sqlalchemy.orm import Session
+
+from app.models import EventRecord
+from app.schemas.enums import ProviderName
+from tests.factories import DataSourceFactory, EventRecordFactory
+
+_SCRIPT_PATH = Path(__file__).resolve().parents[2] / "scripts" / "data_migrations" / "backfill_google_sleep_type.py"
+
+
+def _load_module() -> ModuleType:
+    spec = importlib.util.spec_from_file_location("backfill_google_sleep_type", _SCRIPT_PATH)
+    assert spec is not None
+    assert spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+backfill_google_sleep_type = _load_module().backfill_google_sleep_type
+
+NIGHT = datetime(2026, 5, 1, 22, 0, tzinfo=timezone.utc)
+
+
+def _row(provider: ProviderName, *, category: str = "sleep", type_: str | None = None, night: int = 0) -> EventRecord:
+    return EventRecordFactory(
+        data_source=DataSourceFactory(provider=provider),
+        category=category,
+        type=type_,
+        start_datetime=NIGHT + timedelta(days=night),
+        duration_seconds=8 * 3600,
+    )
+
+
+def test_types_only_untyped_google_sleep(db: Session) -> None:
+    google_sleep = _row(ProviderName.GOOGLE_HEALTH)
+    google_workout = _row(ProviderName.GOOGLE_HEALTH, category="workout", night=1)
+    oura_sleep = _row(ProviderName.OURA)
+
+    assert backfill_google_sleep_type(db, dry_run=False, batch_size=1) == 1
+
+    db.refresh(google_sleep)
+    db.refresh(google_workout)
+    db.refresh(oura_sleep)
+    assert (google_sleep.type, google_workout.type, oura_sleep.type) == ("sleep_session", None, None)
+
+
+def test_a_second_run_changes_nothing(db: Session) -> None:
+    _row(ProviderName.GOOGLE_HEALTH)
+
+    backfill_google_sleep_type(db, dry_run=False)
+
+    assert backfill_google_sleep_type(db, dry_run=False) == 0
+
+
+def test_dry_run_counts_without_writing(db: Session) -> None:
+    google_sleep = _row(ProviderName.GOOGLE_HEALTH)
+
+    assert backfill_google_sleep_type(db, dry_run=True) == 1
+
+    db.refresh(google_sleep)
+    assert google_sleep.type is None
