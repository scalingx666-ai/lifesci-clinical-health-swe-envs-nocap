+        stub = served.stub()
+        results = [outcome(stub, rpc) for _ in range(3)]
+        clock.advance(1.0)
+        recovered = outcome(stub, rpc)
+
+    assert results == [
+        (grpc.StatusCode.OK, None),
+        (grpc.StatusCode.OK, None),
+        failure_of(REASON_RATE_LIMITED),
+    ]
+    assert recovered == (grpc.StatusCode.OK, None)
+    assert spy.calls == [rpc, rpc, rpc]
