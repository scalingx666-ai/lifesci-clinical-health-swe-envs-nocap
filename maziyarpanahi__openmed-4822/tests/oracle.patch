+
+DEFAULT_GRPC_MAX_SEND_MESSAGE_BYTES = 64 * 1024 * 1024
+DEFAULT_GRPC_MAX_STREAM_CHUNKS = 4096
+DEFAULT_GRPC_MAX_STREAM_CHUNK_BYTES = 128 * 1024
