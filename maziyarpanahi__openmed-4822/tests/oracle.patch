+@dataclass(frozen=True)
+class SyntheticTLSMaterial:
+    """File paths and PEM bytes for ephemeral synthetic TLS identities."""
+
+    directory: Path
+    ca_file: Path
+    ca_pem: bytes
+    server_cert_file: Path
+    server_key_file: Path
