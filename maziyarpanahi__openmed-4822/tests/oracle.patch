+def limited(**limits: Any) -> GrpcServicePolicy:
+    return GrpcServicePolicy(limits=GrpcLimits(**limits))
+
+
+def throttled(**throttle: Any) -> GrpcServicePolicy:
+    return GrpcServicePolicy(throttle=ServiceThrottleConfig(**throttle))
