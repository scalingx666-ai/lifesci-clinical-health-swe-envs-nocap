diff --git a/openmed/core/schemas/json/reviewer_disagreement_report.schema.json b/openmed/core/schemas/json/reviewer_disagreement_report.schema.json
new file mode 100644
index 000000000..117bf664f
--- /dev/null
+++ b/openmed/core/schemas/json/reviewer_disagreement_report.schema.json
@@ -0,0 +1,69 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://openmed.life/schemas/reviewer_disagreement_report.schema.json",
+  "title": "OpenMed reviewer disagreement report",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["adjudication", "agreement", "has_suppressed_cells", "minimum_cell_size", "reason_adjudication", "schema_version", "suppressed_reason_cells"],
+  "properties": {
+    "adjudication": {"$ref": "#/$defs/published_rate"},
+    "agreement": {"$ref": "#/$defs/published_rate"},
+    "has_suppressed_cells": {"type": "boolean"},
+    "minimum_cell_size": {"type": "integer", "minimum": 2},
+    "reason_adjudication": {
+      "type": "array",
+      "items": {"$ref": "#/$defs/reason_adjudication_rate"}
+    },
+    "schema_version": {"const": "openmed.reviewer_disagreement.v1"},
+    "suppressed_reason_cells": {"type": "integer", "minimum": 0}
+  },
+  "$defs": {
+    "published_rate": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["denominator", "numerator", "rate", "suppressed"],
+      "properties": {
+        "denominator": {"type": ["integer", "null"], "minimum": 0},
+        "numerator": {"type": ["integer", "null"], "minimum": 0},
+        "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
+        "suppressed": {"type": "boolean"}
+      },
+      "if": {"properties": {"suppressed": {"const": true}}},
+      "then": {
+        "properties": {
+          "denominator": {"type": "null"},
+          "numerator": {"type": "null"},
+          "rate": {"type": "null"}
+        }
+      },
+      "else": {
+        "properties": {
+          "denominator": {"type": "integer"},
+          "numerator": {"type": "integer"}
+        }
+      }
+    },
+    "reason_adjudication_rate": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["denominator", "numerator", "rate", "reason", "suppressed"],
+      "properties": {
+        "denominator": {"type": ["integer", "null"], "minimum": 0},
+        "numerator": {"type": ["integer", "null"], "minimum": 0},
+        "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
+        "reason": {
+          "type": "string",
+          "enum": [
+            "clinical_interpretation",
+            "evidence_quality",
+            "guideline_ambiguity",
+            "label_definition",
+            "other",
+            "reviewer_error"
+          ]
+        },
+        "suppressed": {"type": "boolean"}
+      }
+    }
+  }
+}
diff --git a/tests/unit/eval/test_reviewer_disagreement_schema.py b/tests/unit/eval/test_reviewer_disagreement_schema.py
new file mode 100644
index 000000000..0b3f1a2d9
--- /dev/null
+++ b/tests/unit/eval/test_reviewer_disagreement_schema.py
@@ -0,0 +1,129 @@
+"""Tests for the packaged reviewer-disagreement report JSON Schema.
+
+The schema is the contract consumers validate a report against, so it must
+accept exactly what ``ReviewerDisagreementReport.to_dict()`` produces and
+reject any extra key — in particular reviewer or case identifiers, which the
+report deliberately never contains.
+"""
+
+from __future__ import annotations
+
+import json
+from importlib import resources
+
+import pytest
+from jsonschema.validators import validator_for
+
+from openmed.eval.reviewer_disagreement import (
+    DisagreementReason,
+    ReviewerDecision,
+    reviewer_disagreement_report,
+)
+
+SCHEMA_PACKAGE = "openmed.core.schemas.json"
+SCHEMA_NAME = "reviewer_disagreement_report.schema.json"
+
+
+def _load_schema() -> dict:
+    resource = resources.files(SCHEMA_PACKAGE).joinpath(SCHEMA_NAME)
+    return json.loads(resource.read_text(encoding="utf-8"))
+
+
+def _synthetic_report() -> dict:
+    def case(
+        number: int,
+        left: str,
+        right: str,
+        *,
+        reason: DisagreementReason | None = None,
+        adjudicated: bool = False,
+    ) -> list[ReviewerDecision]:
+        case_id = f"synthetic-case-{number}"
+        return [
+            ReviewerDecision(
+                case_id=case_id,
+                reviewer_id="synthetic-reviewer-a",
+                decision=left,
+                reason=reason,
+                adjudicated=adjudicated,
+            ),
+            ReviewerDecision(
+                case_id=case_id,
+                reviewer_id="synthetic-reviewer-b",
+                decision=right,
+                reason=reason,
+                adjudicated=adjudicated,
+            ),
+        ]
+
+    decisions = [
+        *case(1, "accept", "accept"),
+        *case(2, "accept", "accept"),
+        *case(
+            3,
+            "accept",
+            "revise",
+            reason=DisagreementReason.EVIDENCE_QUALITY,
+            adjudicated=True,
+        ),
+        *case(
+            4,
+            "revise",
+            "accept",
+            reason=DisagreementReason.EVIDENCE_QUALITY,
+            adjudicated=True,
+        ),
+        *case(
+            5,
+            "accept",
+            "revise",
+            reason=DisagreementReason.EVIDENCE_QUALITY,
+        ),
+        *case(
+            6,
+            "revise",
+            "accept",
+            reason=DisagreementReason.EVIDENCE_QUALITY,
+        ),
+    ]
+    return reviewer_disagreement_report(decisions, minimum_cell_size=2).to_dict()
+
+
+def test_schema_is_a_valid_json_schema() -> None:
+    schema = _load_schema()
+    validator_for(schema).check_schema(schema)
+
+
+def test_synthetic_report_validates_against_schema() -> None:
+    schema = _load_schema()
+    validator = validator_for(schema)(schema)
+
+    assert not list(validator.iter_errors(_synthetic_report()))
+
+
+@pytest.mark.parametrize(
+    "extra_key",
+    ["reviewer_id", "case_id", "decision"],
+)
+def test_report_with_identifier_key_fails_validation(extra_key: str) -> None:
+    schema = _load_schema()
+    validator = validator_for(schema)(schema)
+    report = _synthetic_report()
+    report[extra_key] = "synthetic-identifier"
+
+    assert list(validator.iter_errors(report))
+
+
+def test_suppressed_rate_rejects_disclosed_counts() -> None:
+    schema = _load_schema()
+    validator = validator_for(schema)(schema)
+    report = _synthetic_report()
+    report["agreement"].update(
+        suppressed=True, numerator=None, denominator=None, rate=None
+    )
+    report["has_suppressed_cells"] = True
+    assert validator.is_valid(report)
+
+    report["agreement"]["numerator"] = 1
+
+    assert not validator.is_valid(report)
