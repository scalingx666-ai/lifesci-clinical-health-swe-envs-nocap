+  private void setClaimCosts(HashMap<BB2RIFStructure.INPATIENT, String> fieldValues,
+          Claim.ClaimEntry claim) {
+    fieldValues.put(BB2RIFStructure.INPATIENT.CLM_PMT_AMT,
+            String.format("%.2f", claim.getCoveredCost()));
