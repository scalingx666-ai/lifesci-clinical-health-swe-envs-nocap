+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import type { SearchRequest } from '@medplum/core';
+import { Operator } from '@medplum/core';
+import type { Patient } from '@medplum/fhirtypes';
+import { randomUUID } from 'crypto';
+import { initAppServices, shutdownApp } from '../app';
+import { loadTestConfig } from '../config/loader';
+import { getLogger } from '../logger';
+import { createTestProject, withTestContext } from '../test.setup';
+import { searchUnique } from './searchunique';
+
+describe('searchUnique', () => {
+  beforeAll(async () => {
+    const config = await loadTestConfig();
+    await initAppServices(config);
+  });
+
+  afterAll(async () => {
+    await shutdownApp();
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  test('Multiple matches are logged once per window and the first match is returned', () =>
+    withTestContext(async () => {
+      const { repo } = await createTestProject({ withRepo: true });
+      const family = randomUUID();
+      const search: SearchRequest<Patient> = {
+        resourceType: 'Patient',
+        filters: [{ code: 'family', operator: Operator.EQUALS, value: family }],
+      };
+      const patient1 = await repo.createResource<Patient>({ resourceType: 'Patient', name: [{ family }] });
+      expect((await searchUnique(repo, search, 'test'))?.id).toBe(patient1.id);
+
+      const patient2 = await repo.createResource<Patient>({ resourceType: 'Patient', name: [{ family }] });
+      const warnSpy = vi.spyOn(getLogger(), 'warn');
+
+      const result = await searchUnique(repo, search, 'test');
+      expect([patient1.id, patient2.id]).toContain(result?.id);
+      await searchUnique(repo, { ...search, count: 10 }, 'test');
+      expect(warnSpy).toHaveBeenCalledTimes(1);
+      expect(warnSpy).toHaveBeenCalledWith(
+        'Search matched multiple resources',
+        expect.objectContaining({
+          source: 'test',
+          search: 'Patient?_count=2&family=' + family,
+          projectId: repo.currentProject()?.id,
+          matchIds: [patient1.id, patient2.id].sort((a, b) => a.localeCompare(b)),
+          returnedId: result?.id,
+          suppressed: 0,
+        })
+      );
+    }));
+});
diff --git a/packages/server/src/fhir/searchunique.ts b/packages/server/src/fhir/searchunique.ts
new file mode 100644
index 00000000000..d4db3707a43
--- /dev/null
+++ b/packages/server/src/fhir/searchunique.ts
@@ -0,0 +1,47 @@
+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import type { SearchRequest, WithId } from '@medplum/core';
+import { formatSearchQuery } from '@medplum/core';
+import type { Resource } from '@medplum/fhirtypes';
+import { getLogger } from '../logger';
+import { LogThrottle } from '../util/logthrottle';
+import type { Repository } from './repo';
+
+const multipleMatchesLogThrottle = new LogThrottle(10 * 60 * 1000); // 10 minute window
+
+/**
+ * Searches for the one resource matching a search request.
+ *
+ * When more than one resource matches, a warning is logged and the first match is returned.
+ *
+ * @param repo - The repository.
+ * @param searchRequest - The search request.
+ * @param source - Short description of the caller, included in the warning.
+ * @returns The matching resource, or undefined if no resource matches.
+ */
+export async function searchUnique<T extends Resource>(
+  repo: Repository,
+  searchRequest: SearchRequest<T>,
+  source: string
+): Promise<WithId<T> | undefined> {
+  const effectiveRequest = { ...searchRequest, count: 2 };
+  const matches = await repo.searchResources<T>(effectiveRequest);
+  if (matches.length <= 1) {
+    return matches[0];
+  }
+
+  const projectId = repo.currentProject()?.id;
+  const effectiveSearch = effectiveRequest.resourceType + formatSearchQuery(effectiveRequest);
+  const matchIds = matches.map((m) => m.id).sort((a, b) => a.localeCompare(b));
+  multipleMatchesLogThrottle.maybeLog([projectId, source, effectiveSearch, ...matchIds].join('|'), (suppressed) => {
+    getLogger().warn('Search matched multiple resources', {
+      source,
+      search: effectiveSearch,
+      projectId,
+      matchIds,
+      returnedId: matches[0].id,
+      suppressed,
+    });
+  });
+  return matches[0];
+}
