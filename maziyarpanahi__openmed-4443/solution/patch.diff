+def _volumes_by_name(deployment: dict) -> dict[str, dict]:
+    volumes = deployment["spec"]["template"]["spec"]["volumes"]
+    by_name = {volume["name"]: volume for volume in volumes}
+    assert len(by_name) == len(volumes)
+    return by_name
