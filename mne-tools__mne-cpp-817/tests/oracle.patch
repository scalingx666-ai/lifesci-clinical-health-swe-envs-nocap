+
+    //=========================================================================================================
+    /**
+     * Attempts to create a file at filePath.
+     * Does nothing if file already exists.
+     *
+     * @param[in] filePath  File path of new file to be created.
+     *
+     * @return Returns whether file was created, false otherwise.
+     */
