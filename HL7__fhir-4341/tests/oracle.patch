+                    <coding>
+                        <system value="http://snomed.info/sct"/>
+                        <code value="336623009"/>
+                        <display value="Oxygen nasal cannula"/>
+                    </coding>
+                </type>
+            </classification>
+        </DeviceDefinition>
+    </contained>
+    <groupIdentifier>
+        <system value="urn:ietf:rfc:3986"/>
+        <value value="urn:uuid:8b7a3c6e-4d2f-4a1b-9e0c-5f6d7e8a9b10"/>
+    </groupIdentifier>
+    <status value="active"/>
+    <intent value="order"/>
+    <medication>
+        <concept>
+            <coding>
+                <system value="http://snomed.info/sct"/>
+                <code value="320917000"/>
+                <display value="Oxygen only product in gas for inhalation"/>
+            </coding>
+        </concept>
+    </medication>
+    <subject>
+        <reference value="Patient/pat1"/>
+        <display value="Donald Duck"/>
