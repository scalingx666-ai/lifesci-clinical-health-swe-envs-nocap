+    xmlns="http://hl7.org/fhir">
+    <id value="medrx0352"/>
+    <!-- Supplementary oxygen, given with the HeliOx order medrx0351 (same groupIdentifier) if SpO2 is below 88%.
+         The nasal cannula is described by a (contained) DeviceDefinition. -->
