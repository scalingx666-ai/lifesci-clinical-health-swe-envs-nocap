+
+def merge(projections, decisions=(), **kwargs):
+    kwargs.setdefault("policy", POLICY)
+    return merge_native_review_labels(projections, decisions, **kwargs)
+
+
+def only(revision):
+    assert len(revision.items) == 1
+    return revision.items[0]
