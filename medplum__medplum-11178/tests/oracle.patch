+    return true;
+  }
+  if (isPrefixOf('false') || isPrefixOf('no') || isPrefixOf('off', 2) || v === '0') {
+    return false;
+  }
+  throw new Error(`Could not parse boolean storage parameter value "${value}" from ${indexdef}`);
