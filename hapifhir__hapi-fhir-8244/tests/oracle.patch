+	public static boolean isMetaOperation(String theCode) {
+		if (theCode == null) {
+			return false;
+		}
+
+		return theCode.equals(RestOperationTypeEnum.META_ADD.getCode())
+				|| theCode.equals(RestOperationTypeEnum.META_DELETE.getCode());
+	}
+
 	/**
