diff --git a/api/src/main/resources/hibernate.default.properties b/api/src/main/resources/hibernate.default.properties
index 7acbb6bfb7f..879b6583644 100644
--- a/api/src/main/resources/hibernate.default.properties
+++ b/api/src/main/resources/hibernate.default.properties
@@ -36,6 +36,64 @@ hibernate.cache.region.factory_class=infinispan
 hibernate.cache.default_cache_concurrency_strategy=read-write
 # hibernate.cache.infinispan.cfg is configured by HibernateSessionFactoryBean based on cache_type property
 
+# Reference data is cached indefinitely.
+# GlobalProperty, Role and the Role.* collections are deliberately left at the default expiry:
+# GlobalPropertyCache and RolePrivilegeCache refill through these regions, so their lifespans
+# only bound staleness from changes made outside Hibernate if these regions expire too.
+hibernate.cache.infinispan.org.openmrs.Concept.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.Concept.expiration.lifespan=-1
+hibernate.cache.infinispan.org.openmrs.Concept.memory.size=10000
+
+hibernate.cache.infinispan.org.openmrs.User.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.User.expiration.lifespan=-1
+hibernate.cache.infinispan.org.openmrs.User.memory.size=10000
+
+hibernate.cache.infinispan.org.openmrs.Privilege.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.Privilege.expiration.lifespan=-1
+hibernate.cache.infinispan.org.openmrs.Privilege.memory.size=10000
+
+hibernate.cache.infinispan.org.openmrs.Person.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.Person.expiration.lifespan=-1
+hibernate.cache.infinispan.org.openmrs.Person.memory.size=10000
+
+hibernate.cache.infinispan.org.openmrs.ConceptDatatype.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.ConceptDatatype.expiration.lifespan=-1
+hibernate.cache.infinispan.org.openmrs.ConceptDatatype.memory.size=100
+
+hibernate.cache.infinispan.org.openmrs.ConceptClass.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.ConceptClass.expiration.lifespan=-1
+hibernate.cache.infinispan.org.openmrs.ConceptClass.memory.size=100
+
+hibernate.cache.infinispan.org.openmrs.Location.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.Location.expiration.lifespan=-1
+hibernate.cache.infinispan.org.openmrs.Location.memory.size=10000
+
+# A person's names, addresses and attributes expire to bound how long changes made outside
+# Hibernate are served stale
+hibernate.cache.infinispan.org.openmrs.PersonName.expiration.max_idle=900000
+hibernate.cache.infinispan.org.openmrs.PersonName.expiration.lifespan=3600000
+hibernate.cache.infinispan.org.openmrs.PersonName.memory.size=10000
+
+hibernate.cache.infinispan.org.openmrs.PersonAddress.expiration.max_idle=900000
+hibernate.cache.infinispan.org.openmrs.PersonAddress.expiration.lifespan=3600000
+hibernate.cache.infinispan.org.openmrs.PersonAddress.memory.size=10000
+
+hibernate.cache.infinispan.org.openmrs.PersonAttribute.expiration.max_idle=900000
+hibernate.cache.infinispan.org.openmrs.PersonAttribute.expiration.lifespan=3600000
+hibernate.cache.infinispan.org.openmrs.PersonAttribute.memory.size=10000
+
+hibernate.cache.infinispan.org.openmrs.Person.names.expiration.max_idle=900000
+hibernate.cache.infinispan.org.openmrs.Person.names.expiration.lifespan=3600000
+
+hibernate.cache.infinispan.org.openmrs.Person.addresses.expiration.max_idle=900000
+hibernate.cache.infinispan.org.openmrs.Person.addresses.expiration.lifespan=3600000
+
+hibernate.cache.infinispan.org.openmrs.Person.attributes.expiration.max_idle=900000
+hibernate.cache.infinispan.org.openmrs.Person.attributes.expiration.lifespan=3600000
+
+# A user's roles are kept for at most an hour, the same staleness bound as RolePrivilegeCache
+hibernate.cache.infinispan.org.openmrs.User.roles.expiration.max_idle=-1
+hibernate.cache.infinispan.org.openmrs.User.roles.expiration.lifespan=3600000
 
 # Needs to be set to elasticsearch or lucene
 hibernate.search.backend.type=lucene
