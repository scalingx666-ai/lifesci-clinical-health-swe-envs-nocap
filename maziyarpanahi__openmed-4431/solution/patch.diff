+):
+    def forbidden(*args):
+        pytest.fail("unexpected parser/runtime access")
+
+    monkeypatch.setattr(asr, "_CpuEngine", forbidden)
+    monkeypatch.setattr(asr, "_inspect_graph", forbidden)
