+def test_manifest_round_trips_and_rejects_duplicate_keys(
+    anchored: AuditContinuityStore,
+) -> None:
+    _, manifest = anchored.load()
+    text = manifest.to_json()
+    assert ContinuityManifest.from_json(text).to_json() == text
