+            f"synthetic-continuity-key-{index:02d}-0123456789abcdef"
+        ).encode("ascii")
+        for index in range(12)
+    }
+    store = AuditContinuityStore(Path(sys.argv[1]), key_provider=keys)
+    worker = sys.argv[2]
