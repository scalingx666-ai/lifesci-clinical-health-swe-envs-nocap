+@pytest.mark.parametrize(
+    "case_id",
+    [
+        pytest.param(
+            case.case_id,
+            id=case.case_id,
+            marks=pytest.mark.xfail(
+                strict=True,
+                reason=(
+                    f"#{case.known_gap.issue}: {case.known_gap.reason_code}"
+                    + (
+                        f" ({FOLDED_REPORTS[case.case_id]})"
+                        if case.case_id in FOLDED_REPORTS
+                        else ""
+                    )
+                ),
