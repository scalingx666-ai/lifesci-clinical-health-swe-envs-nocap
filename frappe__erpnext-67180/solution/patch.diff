+def validate_no_inter_company_sales_order(rows, parent) -> None:
+	"""Raise if a Purchase Order row being deleted is linked by an inter-company Sales Order row."""
+	if not rows:
+		return
+
+	sales_orders = dict(
+		frappe.get_all(
+			"Sales Order Item",
+			filters={
+				"purchase_order": parent.name,
+				"purchase_order_item": ["in", [row.name for row in rows]],
+				"docstatus": ["<", 2],
+			},
+			fields=["purchase_order_item", "parent"],
+			as_list=True,
+		)
+	)
+	for row in rows:
+		if sales_order := sales_orders.get(row.name):
+			frappe.throw(
+				_("Row #{0}: Cannot delete item {1} which is already ordered on Sales Order {2}.").format(
+					row.idx, row.item_code, get_link_to_form("Sales Order", sales_order)
+				)
+			)
+
+
