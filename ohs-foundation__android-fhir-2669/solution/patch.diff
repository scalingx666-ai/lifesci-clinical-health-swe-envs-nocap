+/** Implementation of a parallelized map */
+suspend fun <A, B> Iterable<A>.pmap(dispatcher: CoroutineDispatcher, f: suspend (A) -> B): List<B> =
+  coroutineScope {
+    map { async(dispatcher) { f(it) } }.awaitAll()
+  }
