+	 */
+	@Test
+	void shouldNotCompressWhenTheClientDoesNotAdvertiseGzipSupport() throws Exception {
+		givenGlobalProperty(GZIP_ENABLED, "true");
+
+		assertFalse(isResponseCompressed(null));
