+		assertFalse(isResponseCompressed());
+	}
+
+	@Test
+	void shouldNotReadAnyGlobalPropertyWhenNoSessionIsOpen() throws Exception {
+		contextMock.when(Context::isSessionOpen).thenReturn(false);
