+def test_edited_pixel_receipt_and_geometry_cannot_pass_reproduction(clean):
+    page = clean.pages[0]
+    with Image.open(BytesIO(page.png)) as image:
+        image.putpixel((0, 0), (0, 0, 0))
+        stream = BytesIO()
