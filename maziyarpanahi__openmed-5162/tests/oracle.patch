+    def __call__(self, *args: Any, **kwargs: Any):
+        try:
+            for index in range(self.chunks):
+                self.produced += 1
+                yield StreamingDeidentificationEvent(redacted_text=f"[NAME] {index} ")
+            yield StreamingDeidentificationEvent(
+                redacted_text="",
