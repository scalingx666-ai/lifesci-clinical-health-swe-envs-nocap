+    for tissue in _extract_tissues_from_config(config, "dartel_tissues"):
+        (
+            segmentation_folder
+            / "dartel_input"
+            / f"{common_filename_part}{tissue.value}_dartelinput.nii.gz"
+        ).touch()
+
+
+def _build_t1_volume_tissue_segmentation_normalized_space(
