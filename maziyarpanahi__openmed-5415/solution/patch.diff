+        except StoreWaitError as error:
+            return error.outcome()
+
+    def _rollback(self) -> None:
+        failed = False
+        try:
+            self._raw_connection.rollback()
+        except Exception:
+            failed = True
+        if failed:
+            raise PostgresStoreError("postgres rollback failed")
+
+    def _commit_or_report_unknown(self) -> None:
+        acknowledged = False
