+    "from scipy import signal\n",
+    "from scipy import sparse\n",
+    "\n",
+    "class Visualizer:\n",
+    "    def __init__(self, preprocessed_dataset_path, input_files, label_files):\n",
+    "        self.input_files = natsorted(input_files)\n",
