index 000000000..9b52d0434
--- /dev/null
+++ b/mirobody/tests/test_catalog_loinc_axes.py
@@ -0,0 +1,95 @@
+"""Catalogue identities checked against all six LOINC axes.
+
+The explicit expectations describe the new mappings, not every row in a lab
+category: urine, CSF and other specimens are legitimate independent tests.
+Raw ROWS retain conflicting duplicate names that a first-wins index hides.
+"""
+
+from __future__ import annotations
+
+from mirobody.engine import get_resolver
+from mirobody.kernel import metrics
+from mirobody.units import unit_families
+
+# LOINC 2.83: code, full component, property, scale, specimen, method, time.
+EXPECTED_AXES = {
+    "ALANINE_AMINOTRANSFERASE": ("1742-6", "alanine aminotransferase", "CCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "ASPARTATE_AMINOTRANSFERASE": ("1920-8", "aspartate aminotransferase", "CCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "ALKALINE_PHOSPHATASE": ("6768-6", "alkaline phosphatase", "CCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "GAMMA_GLUTAMYL_TRANSFERASE": ("2324-2", "gamma glutamyl transferase", "CCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "LACTATE_DEHYDROGENASE": ("14804-9", "lactate dehydrogenase", "CCnc", "Qn", "Ser/Plas", "Reaction: lactate to pyruvate", "Pt"),
+    "UREA_NITROGEN": ("3094-0", "urea nitrogen", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "CREATININE": ("2160-0", "creatinine", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "URATE": ("3084-1", "urate", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "BILIRUBIN": ("1975-2", "bilirubin", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "ALBUMIN": ("1751-7", "albumin", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "PROTEIN": ("2885-2", "protein", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "SODIUM": ("2951-2", "sodium", "SCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "POTASSIUM": ("2823-3", "potassium", "SCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "CHLORIDE": ("2075-0", "chloride", "SCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "BICARBONATE": ("1959-6", "bicarbonate", "SCnc", "Qn", "Bld", "", "Pt"),
+    "CALCIUM": ("17861-6", "calcium", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "PHOSPHATE": ("2777-1", "phosphate", "MCnc", "Qn", "Ser/Plas", "", "Pt"),
+    "GLOBULIN": ("10834-0", "globulin", "MCnc", "Qn", "Ser", "Calculated", "Pt"),
+    "CYCLING_DISTANCE": ("93818-3", "cycling distance", "Len", "Qn", "^Patient", "", "XXX"),
+    "BODY_FAT_MASS": ("73708-0", "body fat mass", "Mass", "Qn", "^Patient", "Calculated", "Pt"),
+    "BODY_MUSCLE_MASS": ("73964-9", "body muscle mass", "Mass", "Qn", "^Patient", "Calculated", "Pt"),
+}
+
+
+def test_every_code_is_reachable():
+    resolver = get_resolver()
+    for metric in metrics.ROWS:
+        if metric.loinc:
+            assert resolver.axes_of(metric.loinc) is not None, metric.member
+            assert metric.confidence, metric.member
+
+
+def test_new_mappings_match_all_six_axes():
+    resolver = get_resolver()
+    for member, (code, *expected) in EXPECTED_AXES.items():
+        metric = metrics.MEMBERS[member]
+        assert metric.loinc == code, member
+        axes = resolver.axes_of(code)
+        assert axes is not None, member
+        assert axes[:6] == tuple(expected), member
+
+
+def test_lab_units_match_their_property():
+    resolver = get_resolver()
+    for metric in metrics.ROWS:
+        if not metric.loinc or metric.category not in {"Medical Metrics", "Metabolic Metrics"}:
+            continue
+        if metric.member in {"APNEA_HYPOPNEA_INDEX", "OBSTRUCTIVE_APNEA_INDEX", "PULSE_WAVE_VELOCITY"}:
+            continue
+        families = unit_families(metric.unit_ucum)
+        assert families, (metric.member, metric.unit_ucum)
+        assert resolver.axes_of(metric.loinc)[1] in families, metric.member
+
+
+def test_serum_sodium_has_its_own_lookup_identity():
+    serum = metrics.MEMBERS["SODIUM"]
+    dietary = metrics.MEMBERS["DIETARY_SODIUM"]
+    assert serum.name != dietary.name
+    assert metrics.METRICS[serum.name] is serum
+    assert serum.canonical == ("loinc", "2951-2")
+    assert serum.unit_ucum == "mmol/L"
+    assert dietary.name == "sodium" and dietary.unit_ucum == "mg"
+    assert metrics.mapping_for("synthetic", serum.name).metric is serum
+
+
+def test_instantaneous_walking_speed_keeps_its_device_identity():
+    walking = metrics.MEMBERS["WALKING_SPEED"]
+    assert walking.state_class == "instant"
+    assert walking.loinc == ""
+    assert walking.canonical == ("mirobody-device", "walkingSpeeds")
+
+
+def test_conflicting_names_are_rejected_before_first_wins_lookup(monkeypatch):
+    import pytest
+
+    rows = metrics._read_tsv("catalog/metrics.tsv")
+    duplicate = {**rows[0], "member": "SYNTHETIC_COLLISION", "unit_ucum": "synthetic-conflict"}
+    monkeypatch.setattr(metrics, "_read_tsv", lambda _: [*rows, duplicate])
+    with pytest.raises(ValueError, match="name"):
+        metrics._load()
diff --git a/mirobody/tests/test_local_day.py b/mirobody/tests/test_local_day.py
new file mode 100644
index 000000000..cc163ef9f
--- /dev/null
+++ b/mirobody/tests/test_local_day.py
@@ -0,0 +1,100 @@
+"""Which local day an instant belongs to.
+
+The module docstring records two production bugs of the same shape: a reading
+filed under the wrong day because one path computed the day in the server's
+zone, another in the user's, and a third by casting a naive timestamp. The fix
+was one implementation, so the tests pin the three behaviours that a fourth
+implementation would get wrong:
+
+  the sleep family opens its day at 18:00, so 01:30 belongs to the PREVIOUS date
+  the same instant is a different date in a different zone
+  a zone it cannot place raises, it is never silently defaulted
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, UTC
+from zoneinfo import ZoneInfo
+
+from mirobody.standardize.local_day import local_day, resolve_tz, zone_for
+
+NEW_YORK = "America/New_York"
+SHANGHAI = "Asia/Shanghai"
+
+
+def at(y, mo, d, h, mi, tz=NEW_YORK):
+    """An instant written in the local wall clock, returned as UTC."""
+    return datetime(y, mo, d, h, mi, tzinfo=ZoneInfo(tz)).astimezone(UTC)
+
+
+def test_calendar_day_is_the_local_date():
+    """With the default window a day is simply the local calendar date."""
+    assert local_day(at(2024, 3, 11, 0, 30), NEW_YORK) == datetime(2024, 3, 11).date()
+    assert local_day(at(2024, 3, 11, 23, 59), NEW_YORK) == datetime(2024, 3, 11).date()
+
+
+def test_sleep_window_opens_at_eighteen():
+    """A sleep day runs 18:00 to 18:00 and is named for the evening it began."""
+    assert local_day(at(2024, 3, 11, 17, 59), NEW_YORK, window="18:00") == datetime(2024, 3, 10).date()
+    assert local_day(at(2024, 3, 11, 18, 0), NEW_YORK, window="18:00") == datetime(2024, 3, 11).date()
+    # 01:30 is the middle of the night that began on the 11th, not the 12th
+    assert local_day(at(2024, 3, 12, 1, 30), NEW_YORK, window="18:00") == datetime(2024, 3, 11).date()
+
+
+def test_the_same_instant_is_a_different_date_in_another_zone():
+    """23:30 UTC is still the 10th in New York and already the 11th in Shanghai."""
+    instant = datetime(2024, 3, 10, 23, 30, tzinfo=UTC)
+    assert local_day(instant, NEW_YORK) == datetime(2024, 3, 10).date()
+    assert local_day(instant, SHANGHAI) == datetime(2024, 3, 11).date()
+
+
+def test_a_fixed_offset_places_the_day_but_is_tagged_as_such():
+    """A device that ships `UTC+08:00` is placed correctly, and the caller can
+    tell it was an offset rather than an IANA zone."""
+    tz, source = resolve_tz("UTC+08:00", "UTC")
+    assert tz == "UTC+08:00"
+    assert source == "offset-only"
+    instant = datetime(2024, 3, 10, 23, 30, tzinfo=UTC)
+    assert local_day(instant, tz) == datetime(2024, 3, 11).date()
+
+
+def test_missing_zone_falls_back_to_the_user_default_and_says_so():
+    tz, source = resolve_tz(None, "Europe/Berlin")
+    assert tz == "Europe/Berlin"
+    assert source == "user-default"
+
+
+def test_an_unplaceable_zone_raises_instead_of_defaulting():
+    """The dangerous failure is a silent UTC default: it files readings under
+    the wrong day without anyone noticing."""
+    for bad in ("Mars/Base", "GMT+25:00", "not-a-zone"):
+        try:
+            zone_for(bad)
+        except Exception:
+            continue
+        raise AssertionError(f"{bad!r} was accepted; it must raise")
+
+
+def test_dst_day_still_assigns_sleep_nights_correctly():
+    """America/New_York loses an hour on 2024-03-10; the night that began on
+    the 9th and the one that began on the 10th must not collapse into one."""
+    nightly = [local_day(at(2024, 3, d, 22, 0), NEW_YORK, window="18:00") for d in (9, 10, 11)]
+    assert nightly == [datetime(2024, 3, 9).date(), datetime(2024, 3, 10).date(),
+                       datetime(2024, 3, 11).date()], nightly
+
+
+if __name__ == "__main__":  # runs without pytest
+    failures = 0
+    for name, fn in sorted(globals().items()):
+        if not name.startswith("test_") or not callable(fn):
+            continue
+        try:
+            fn()
+            print(f"  PASS {name}")
+        except AssertionError as exc:
+            failures += 1
+            print(f"  FAIL {name}: {str(exc)[:180]}")
+        except Exception as exc:
+            failures += 1
+            print(f"  ERROR {name}: {exc!r}")
+    raise SystemExit(1 if failures else 0)
