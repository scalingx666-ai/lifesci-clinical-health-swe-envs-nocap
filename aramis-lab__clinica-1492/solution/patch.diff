+def mapping_diagnosis(diagnosis_bl: float) -> str:
+    """Mapping diagnosis label to corresponding number.
+
+    Parameters
+    ----------
+    diagnosis_bl : float
+        Diagnosis number.
+
+    Returns
+    -------
+    str :
+        Diagnosis label if matching a number, Not Available (n/a) otherwise.
+    """
+
+    if diagnosis_bl == 0.0:
+        return "CN"
+
+    elif diagnosis_bl in (0.5, 1.0, 1.5, 2.0):
+        return "AD"
+
+    return "n/a"
+
+
