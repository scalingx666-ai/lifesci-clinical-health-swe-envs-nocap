diff --git a/src/js/tests/hooks/useCycleCountFilters.test.jsx b/src/js/tests/hooks/useCycleCountFilters.test.jsx
new file mode 100644
index 0000000000..7fc0df315a
--- /dev/null
+++ b/src/js/tests/hooks/useCycleCountFilters.test.jsx
@@ -0,0 +1,43 @@
+import { act, renderHook } from '@testing-library/react';
+import queryString from 'query-string';
+import { BrowserRouter, useLocation } from 'react-router-dom';
+
+import useCycleCountFilters from 'hooks/cycleCount/useCycleCountFilters';
+import useSwitchTabs from 'hooks/useSwitchTabs';
+
+jest.mock('react-redux', () => ({
+  useSelector: jest.fn().mockImplementation(() => ({
+    currentLocation: { id: 'loc-123' },
+    debounceTime: 500,
+    minSearchLength: 3,
+    shouldRebuildParams: false,
+  })),
+  useDispatch: () => jest.fn(),
+  connect: jest.fn(() => (Component) => Component),
+}));
+jest.mock('hooks/useTranslate', () => jest.fn(() => (key) => key));
+
+const useCycleCountTabs = () => {
+  const { switchTab } = useSwitchTabs({ defaultTab: 'ALL_PRODUCTS' });
+  const { resetForm } = useCycleCountFilters({ filterFields: { categories: {} } });
+  const { search } = useLocation();
+
+  return { switchTab, resetForm, search };
+};
+
+describe('useCycleCountFilters', () => {
+  beforeEach(() => {
+    window.history.replaceState({}, '', '/cycleCount?tab=ALL_PRODUCTS');
+  });
+
+  it('keeps the new tab when the filters are reset right after a tab switch', async () => {
+    const { result } = renderHook(useCycleCountTabs, { wrapper: BrowserRouter });
+
+    await act(async () => {
+      result.current.switchTab('TO_COUNT', result.current.resetForm);
+    });
+
+    expect(queryString.parse(result.current.search).tab).toEqual('TO_COUNT');
+    expect(queryString.parse(window.location.search).tab).toEqual('TO_COUNT');
+  });
+});
diff --git a/src/js/tests/menu/WizardNavigation.test.jsx b/src/js/tests/menu/WizardNavigation.test.jsx
new file mode 100644
index 0000000000..0156cc499b
--- /dev/null
+++ b/src/js/tests/menu/WizardNavigation.test.jsx
@@ -0,0 +1,60 @@
+import React from 'react';
+
+import { fireEvent, render, screen } from '@testing-library/react';
+import { Provider } from 'react-redux';
+import { MemoryRouter, Route, Routes } from 'react-router-dom';
+
+import Wizard from 'components/wizard/Wizard';
+import withRouter from 'utils/withRouter';
+
+import store from '../../store';
+
+const idsSeenBySecondPage = [];
+
+const FirstPage = withRouter(({ navigate, nextPage }) => {
+  const save = () => Promise.resolve({ id: '123' })
+    .then((saved) => {
+      navigate(`/create/${saved.id}`);
+      nextPage(saved);
+    });
+
+  return <button type="button" onClick={save}>Next</button>;
+});
+
+const SecondPage = withRouter(({ match }) => {
+  idsSeenBySecondPage.push(match.params.id);
+
+  return <div>{`Second page for ${match.params.id}`}</div>;
+});
+
+const renderWizard = () => render(
+  <MemoryRouter initialEntries={['/create']}>
+    <Provider store={store}>
+      <Routes>
+        <Route
+          path="/create/:id?"
+          element={(
+            <Wizard
+              title={[{ title: '' }]}
+              currentPage={1}
+              prevPage={1}
+              pageList={[FirstPage, SecondPage]}
+              stepList={['Create', 'Add items']}
+            />
+          )}
+        />
+      </Routes>
+    </Provider>
+  </MemoryRouter>,
+);
+
+describe('wizard navigation', () => {
+  it('renders the next page with the id the previous page navigated to', async () => {
+    renderWizard();
+
+    fireEvent.click(screen.getByText('Next'));
+
+    expect(await screen.findByText('Second page for 123')).toBeTruthy();
+    expect(idsSeenBySecondPage).toEqual(expect.not.arrayContaining([undefined]));
+  });
+});
diff --git a/src/js/tests/utils/confirmAlert.test.jsx b/src/js/tests/utils/confirmAlert.test.jsx
new file mode 100644
index 0000000000..dbc829f104
--- /dev/null
+++ b/src/js/tests/utils/confirmAlert.test.jsx
@@ -0,0 +1,55 @@
+import React from 'react';
+
+import {
+  act, fireEvent, screen, waitFor,
+} from '@testing-library/react';
+import { confirmAlert } from 'react-confirm-alert';
+
+const openAlert = (options) => act(() => {
+  confirmAlert(options);
+});
+
+describe('confirmAlert', () => {
+  afterEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  it('renders a dialog with buttons and closes it after a click', async () => {
+    const onConfirm = jest.fn();
+
+    await openAlert({
+      title: 'Confirm refresh',
+      message: 'Unsaved changes will be lost',
+      buttons: [{ label: 'Yes', onClick: onConfirm }, { label: 'No' }],
+    });
+
+    expect(screen.getByText('Confirm refresh')).toBeTruthy();
+    expect(document.querySelector('.react-confirm-alert-overlay .react-confirm-alert-body')).toBeTruthy();
+
+    await act(() => fireEvent.click(screen.getByText('Yes')));
+
+    expect(onConfirm).toHaveBeenCalled();
+    await waitFor(() => expect(screen.queryByText('Confirm refresh')).toBeNull());
+  });
+
+  it('renders a custom UI and closes it with onClose', async () => {
+    await openAlert({
+      customUI: ({ onClose }) => (
+        <button type="button" onClick={onClose}>Close login modal</button>
+      ),
+    });
+
+    await act(() => fireEvent.click(screen.getByText('Close login modal')));
+
+    await waitFor(() => expect(screen.queryByText('Close login modal')).toBeNull());
+  });
+
+  it('can be opened again after closing', async () => {
+    await openAlert({ title: 'First', buttons: [{ label: 'OK' }] });
+    await act(() => fireEvent.click(screen.getByText('OK')));
+    await openAlert({ title: 'Second', buttons: [{ label: 'OK' }] });
+
+    expect(screen.queryByText('First')).toBeNull();
+    expect(screen.getByText('Second')).toBeTruthy();
+  });
+});
