+    round_trip_reasons: tuple[TranslationGuardReason, ...] = ()
+    span_map: tuple[RoundTripSpanMapEntry, ...] = ()
+    spans: tuple[SpanAnnotation, ...] = field(default=(), repr=False)
+    text: str | None = field(default=None, repr=False)
