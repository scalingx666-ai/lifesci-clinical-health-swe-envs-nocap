+        *TEXTS,
+        *(case[1] for case in CASES),
+    }
+    digest = re.compile(r"[0-9a-f]{64}\Z")
+
+    def strings(value):
+        if isinstance(value, str):
+            yield value
+        elif isinstance(value, dict):
+            for key, item in value.items():
+                yield key
+                yield from strings(item)
+        elif isinstance(value, list):
+            for item in value:
+                yield from strings(item)
