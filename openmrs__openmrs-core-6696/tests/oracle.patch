diff --git a/startup-init.sh b/startup-init.sh
index 1cc20d099d3..f8178bea0ae 100644
--- a/startup-init.sh
+++ b/startup-init.sh
@@ -33,7 +33,7 @@ OMRS_HAS_CURRENT_OPENMRS_DATABASE=${OMRS_HAS_CURRENT_OPENMRS_DATABASE:-true}
 OMRS_HOME=${OMRS_HOME:-'/openmrs'}
 # When Set to 'auto' disables installation wizard
 OMRS_INSTALL_METHOD=${OMRS_INSTALL_METHOD:-'auto'}
-# JVM startup parameters
+# JVM startup parameters, read by the shell like Tomcat's JAVA_OPTS: quote special characters, e.g. -Dkey='a$b'
 OMRS_JAVA_SERVER_OPTS=${OMRS_JAVA_SERVER_OPTS:-'-Dfile.encoding=UTF-8 -server -Djava.security.egd=file:/dev/./urandom -Djava.awt.headless=true -Djava.awt.headlesslib=true'}
 # Appended to JAVA_SERVER_OPTS
 OMRS_JAVA_MEMORY_OPTS=${OMRS_JAVA_MEMORY_OPTS:-'-XX:NewSize=128m'}
diff --git a/startup.sh b/startup.sh
index 67d2c030bfe..54c8f265af3 100644
--- a/startup.sh
+++ b/startup.sh
@@ -81,10 +81,14 @@ if [ "${OMRS_OTEL_ENABLED:-false}" = "true" ]; then
   CATALINA_OPTS="$CATALINA_OPTS -javaagent:/openmrs/java-agents/opentelemetry-javaagent.jar"
 fi
 
-cat > $TOMCAT_SETENV_FILE << EOF
-export JAVA_OPTS="$JAVA_OPTS"
-export CATALINA_OPTS="$CATALINA_OPTS"
-EOF
+# Single-quoted, so catalina.sh's eval is the only shell interpretation
+SQ="'"
+# Expanded unquoted below on purpose: bash 4.2 keeps the quotes of a quoted replacement
+SQ_ESCAPED="'\\''"
+{
+  printf "export JAVA_OPTS='%s'\n" "${JAVA_OPTS//"$SQ"/$SQ_ESCAPED}"
+  printf "export CATALINA_OPTS='%s'\n" "${CATALINA_OPTS//"$SQ"/$SQ_ESCAPED}"
+} > "$TOMCAT_SETENV_FILE"
 
 echo "Starting up OpenMRS..."
 
