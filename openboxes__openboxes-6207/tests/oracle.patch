+/* Stock card > Stock history: 14 columns at natural width came to 1661px
+   against a 1383px card at 1920, so even a full-HD screen got the card's
+   scrollbar, and `anywhere` still split values like "05:50P|M". Fit it to
+   the card the way the legacy page did: headers wrap at word boundaries,
+   cells never break mid-word, and tighter side padding brings its minimum
+   (~1020px) back to the legacy one. Narrower than that, the card scrolls. */
+.box > table.stockHistory {
+  width: 100%;
+  min-width: 0;
+}
+
+.box > table.stockHistory th {
+  white-space: normal;
+  word-break: normal;
+  overflow-wrap: normal;
+  hyphens: none;
+  vertical-align: bottom;
+}
+
+.box > table.stockHistory td {
+  overflow-wrap: normal;
+}
+
+.box > table.stockHistory th,
+.box > table.stockHistory td {
+  padding-left: 6px;
+  padding-right: 6px;
+}
+
 .list tbody tr:hover {
   background: rgba(240, 246, 255, 0.5);
 }
@@ -2359,8 +2388,13 @@ form[action$="/product/updateInventoryLevels"] > .box > table td {
   flex: 1;
 }
 
