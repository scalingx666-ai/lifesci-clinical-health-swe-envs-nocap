+        val attempts = CopyOnWriteArrayList<String>()
+        val results = mutableListOf<ArtifactAcquisitionResult>()
+        @Suppress("DEPRECATION")
+        val previous = System.getSecurityManager()
+        @Suppress("DEPRECATION")
