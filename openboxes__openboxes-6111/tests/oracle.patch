--- /dev/null
+++ b/src/main/groovy/org/pih/warehouse/api/PickStatusCode.groovy
@@ -0,0 +1,11 @@
+package org.pih.warehouse.api
+
+enum PickStatusCode {
+    NOT_PICKED,
+    PARTIALLY_PICKED,
+    PICKED
+
+    static List<PickStatusCode> list() {
+        return values().toList()
+    }
+}
