diff --git a/source/medication/medication-introduction.xml b/source/medication/medication-introduction.xml
index 0a79852210..0e1b0d1ac6 100644
--- a/source/medication/medication-introduction.xml
+++ b/source/medication/medication-introduction.xml
@@ -10,6 +10,8 @@
 		<li><a href="https://jira.hl7.org/browse/FHIR-54379">FHIR-54379</a> - Corrected the description of the <code>serial-number</code> search parameter, which referred to a lot number.</li>
 		<li><a href="https://jira.hl7.org/browse/FHIR-57813">FHIR-57813</a> - Medication can now optionally be a canonical resource: it has the CanonicalResource elements (<code>url</code>, <code>version</code>, <code>name</code>, <code>title</code>, <code>publisher</code>, <code>jurisdiction</code> and others).</li>
 		<li><a href="https://jira.hl7.org/browse/FHIR-59543">FHIR-59543</a> - <code>status</code> is bound to the <a href="valueset-publication-status.html">PublicationStatus</a> value set (draft | active | retired | unknown), as for other canonical resources; the Medication Status code system and value set are removed. From R5: <code>inactive</code> and <code>entered-in-error</code> become <code>retired</code>; <code>active</code> is unchanged.</li>
+		<li><a href="https://jira.hl7.org/browse/FHIR-59524">FHIR-59524</a> - The <code>serial-number</code> search parameter now searches <code>Medication.instance.identifier</code> (the serial number of a physical item) instead of <code>Medication.identifier</code>; the build path of <code>lot-number</code> now matches its expression (<code>Medication.instance.lotNumber</code>).</li>
+		<li><a href="https://jira.hl7.org/browse/FHIR-57429">FHIR-57429</a> - Clarified the two identifiers in the comments: <code>identifier</code> is the business identifier of the Medication record; <code>instance.identifier</code> is the identifier (typically the serial number) of a physical item, not used for lot numbers. Added a pair of examples for the same product: a kind of medication (<a href="medicationexample0324.html">medicationexample0324</a>) and a physical item (<a href="medicationexample0325.html">medicationexample0325</a>).</li>
 	</ul>
 </blockquote>
 
diff --git a/source/medication/medicationexample0324.xml b/source/medication/medicationexample0324.xml
new file mode 100644
index 0000000000..6bf4793dd4
--- /dev/null
+++ b/source/medication/medicationexample0324.xml
@@ -0,0 +1,30 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<Medication xmlns="http://hl7.org/fhir">
+  <id value="med0324"/>
+  <!-- A Medication representing a kind of medication (a catalogue entry), used as a canonical resource:
+       url and version identify it across systems; identifier is the business identifier of the record
+       (a catalogue number). It has no instance. Compare medicationexample0325, a physical item of the same product. -->
+  <url value="http://example.org/fhir/Medication/amoxicillin-500mg-capsule"/>
+  <identifier>
+    <system value="http://example.org/medication-catalogue"/>
+    <value value="CAT-AMX-500-CAP"/>
+  </identifier>
+  <version value="1.0.0"/>
+  <name value="Amoxicillin500mgCapsule"/>
+  <title value="Amoxicillin 500 mg capsule"/>
+  <code>
+    <coding>
+      <system value="http://www.nlm.nih.gov/research/umls/rxnorm"/>
+      <code value="308191"/>
+      <display value="amoxicillin 500 MG Oral Capsule"/>
+    </coding>
+  </code>
+  <status value="active"/>
+  <doseForm>
+    <coding>
+      <system value="http://snomed.info/sct"/>
+      <code value="385049006"/>
+      <display value="Capsule"/>
+    </coding>
+  </doseForm>
+</Medication>
diff --git a/source/medication/medicationexample0325.xml b/source/medication/medicationexample0325.xml
new file mode 100644
index 0000000000..73a740acc8
--- /dev/null
+++ b/source/medication/medicationexample0325.xml
@@ -0,0 +1,27 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<Medication xmlns="http://hl7.org/fhir">
+  <id value="med0325"/>
+  <!-- A Medication representing a physical item (one pack on a pharmacy shelf) of the same product as medicationexample0324.
+       identifier is the business identifier of this record (a stock-system number); instance.identifier is the serial number
+       of the item; the batch is in instance.lotNumber, not in an identifier. -->
+  <identifier>
+    <system value="http://example.org/pharmacy-stock"/>
+    <value value="STK-2026-004711"/>
+  </identifier>
+  <code>
+    <coding>
+      <system value="http://www.nlm.nih.gov/research/umls/rxnorm"/>
+      <code value="308191"/>
+      <display value="amoxicillin 500 MG Oral Capsule"/>
+    </coding>
+  </code>
+  <status value="active"/>
+  <instance>
+    <identifier>
+      <system value="http://example.org/serial-number"/>
+      <value value="SN-48211907"/>
+    </identifier>
+    <lotNumber value="AX2604B"/>
+    <expirationDate value="2028-03-31"/>
+  </instance>
+</Medication>
