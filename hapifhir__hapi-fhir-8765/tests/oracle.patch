+	 *
+	 * @since 9.2.0
+	 */
+	public static boolean isEncodingSupported(FhirContext theContext, EncodingEnum theEncoding) {
+		return theEncoding != EncodingEnum.RDF || theContext.isFormatRdfSupported();
+	}
