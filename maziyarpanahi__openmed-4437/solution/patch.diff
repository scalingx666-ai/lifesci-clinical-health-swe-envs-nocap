+class FakeLoader:
+    """Minimal offline loader for service construction."""
+
+    def __init__(self, config: Any) -> None:
+        self.config = config
+
+    def resolve_model_name(self, model_name: str) -> str:
+        return model_name
+
+    def loaded_models(self) -> dict[str, Any]:
+        return {}
