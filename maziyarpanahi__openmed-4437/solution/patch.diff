+_GRAPHQL_QUERY = """
+query Journey(
+  $resourceType: JourneyResourceKind!
+  $namespace: String
+  $purpose: String
+  $role: String
+  $attributes: [String!]
+  $consentState: String
+  $exportPolicy: String
+  $first: Int!
+  $after: String
+  $fields: [String!]
+) {
+  journeyResources(
