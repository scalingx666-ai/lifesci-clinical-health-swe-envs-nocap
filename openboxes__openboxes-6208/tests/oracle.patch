diff --git a/src/main/webapp/css/openboxes-theme.css b/src/main/webapp/css/openboxes-theme.css
index 9927474c65..72a52dbbfd 100644
--- a/src/main/webapp/css/openboxes-theme.css
+++ b/src/main/webapp/css/openboxes-theme.css
@@ -1437,6 +1437,15 @@ th:has(> .vertical-text) {
   height: 200px;
 }
 
+/* The same page squeezes its dozens of columns into width: 100%, and the
+   `overflow-wrap: anywhere` on .box cells lets that squeeze reach one
+   character per line: `anywhere` also shrinks a cell's min-content, so
+   Name or Status broke mid-word. Wrap only between words here; the
+   .table-container already scrolls horizontally for the extra width. */
+.box .table-container table td {
+  overflow-wrap: break-word;
+}
+
 th a:hover {
   color: var(--blue-primary);
 }
