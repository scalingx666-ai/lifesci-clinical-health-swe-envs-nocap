+	 *
+	 * @see UserPasswordGuard
+	 */
+	private void daoChangeHashedPassword(User user, String hashedPassword, String salt) {
+		UserPasswordGuard.enter();
+		try {
+			dao.changeHashedPassword(user, hashedPassword, salt);
+		} finally {
+			UserPasswordGuard.exit();
+		}
+	}
