+
+    /**
+     * Spock 2 mocks treat a getProperty(String) call on a Groovy class as a property read, so a stubbed
+     * ConfigService.getProperty(String) is never matched. This keeps the real one-argument variant, which
+     * delegates to getProperty(property, String), and forwards that typed lookup to the stub.
+     */
+    private static class StubBackedConfigService extends ConfigService {
+
+        private final ConfigService stub
+
+        StubBackedConfigService(ConfigService stub) {
+            this.stub = stub
+        }
+
+        @Override
+        <T> T getProperty(String property, Class<T> type) {
+            return stub.getProperty(property, type)
+        }
+    }
 }
