+def test_matrix_and_evidence_are_machine_readable_and_value_free() -> None:
+    one = _contract(1, 1)
+    two = _contract(2, 1, jobs_range=(1, 2, 1))
+    three = _contract(3, 2, jobs_range=(1, 2, 2))
