diff --git a/nginx/nginx.conf b/nginx/nginx.conf
index 423aaf4c1c3..066d1d6da5a 100644
--- a/nginx/nginx.conf
+++ b/nginx/nginx.conf
@@ -2,6 +2,8 @@ server {
   listen 80;
   root /usr/share/nginx/html;
 
+  server_tokens off;
+
   # Security headers — mirrors netlify.toml so self-hosted deploys get the
   # same hardening as Netlify deploys. `always` includes error responses.
   add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
