@@ -0,0 +1,290 @@
+/* Coverage matrix on providers/coverage.mdx. The markup is generated by
+   backend/scripts/generate_coverage_docs.py as plain HTML tables; this file only
+   styles it. Mintlify includes every .css file in the content directory. */
+
+.ow-cov,
+.ow-cov-legend {
+  --ow-cov-border: #e5e7eb;
+  --ow-cov-border-soft: #f1f3f5;
+  --ow-cov-bg: #ffffff;
+  --ow-cov-bg-alt: #f9fafb;
+  --ow-cov-text: #111827;
+  --ow-cov-muted: #6b7280;
+  --ow-cov-chip: #eef0f2;
+  --ow-cov-dot-off: #c4c9cf;
+  --ow-cov-dot-on: #16a34a;
+  --ow-cov-dot-ring: rgba(22, 163, 74, 0.22);
+  font-size: 0.8125rem;
+  color: var(--ow-cov-text);
+}
+
+.dark .ow-cov,
+.dark .ow-cov-legend {
+  --ow-cov-border: #27272a;
+  --ow-cov-border-soft: #1f1f23;
+  --ow-cov-bg: #0b0b0c;
+  --ow-cov-bg-alt: #121214;
+  --ow-cov-text: #e4e4e7;
+  --ow-cov-muted: #a1a1aa;
+  --ow-cov-chip: #27272a;
+  --ow-cov-dot-off: #3f3f46;
+  --ow-cov-dot-on: #22c55e;
+  --ow-cov-dot-ring: rgba(34, 197, 94, 0.25);
+}
+
+/* One scroll box for both axes so the header row and the metric column can
+   stay pinned (sticky top / sticky left) while only the dots move. */
+.ow-cov {
+  overflow: auto;
+  max-height: 75vh;
+  margin: 0.5rem 0;
+  border: 1px solid var(--ow-cov-border);
+  border-radius: 0.6rem;
+  background: var(--ow-cov-bg);
+}
+
+/* Mintlify turns prose tables into display:block scrollers, which breaks sticky cells. */
+.ow-cov-table {
+  display: table !important;
+  overflow: visible !important;
+  border-collapse: separate !important;
+  border-spacing: 0 !important;
+  table-layout: fixed !important;
+  width: auto !important;
+  min-width: 100%;
+  margin: 0 !important;
+}
+
+.ow-cov-table thead {
+  display: table-header-group !important;
+}
+
+.ow-cov-table tbody {
+  display: table-row-group !important;
+}
+
+.ow-cov-table tr {
+  display: table-row !important;
+}
+
+.ow-cov-table th,
+.ow-cov-table td {
+  display: table-cell !important;
+  border: 0 !important;
+  padding: 0 !important;
+  background: var(--ow-cov-bg);
+  font-weight: normal;
+}
+
+.ow-cov-table thead th {
+  position: sticky;
+  top: 0;
+  z-index: 2;
+  border-bottom: 1px solid var(--ow-cov-border) !important;
+}
+
+.ow-cov-table thead th.ow-cov-sticky {
+  z-index: 3;
+}
+
+.ow-cov-table .ow-cov-sticky {
+  position: sticky;
+  left: 0;
+  z-index: 1;
+  text-align: left !important;
+  width: 14rem !important;
+  min-width: 14rem !important;
+  max-width: 14rem !important;
+  padding: 0.35rem 0.75rem !important;
+  border-right: 1px solid var(--ow-cov-border) !important;
+}
+
+.ow-cov-table .ow-cov-corner {
+  vertical-align: bottom !important;
+  color: var(--ow-cov-muted);
+  font-size: 0.7rem;
+  font-weight: 500;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  white-space: nowrap;
+}
+
+/* Rotated provider headers keep the table narrow enough to fit all providers. */
+.ow-cov-provider,
+.ow-cov-table td.y,
+.ow-cov-table td.n {
+  width: 1.9rem !important;
+  min-width: 1.9rem !important;
+  max-width: 1.9rem !important;
+  text-align: center !important;
+}
+
+.ow-cov-table .ow-cov-provider {
+  height: 5.6rem;
+  vertical-align: bottom !important;
+  padding: 0 0 0.4rem !important;
+}
+
+.ow-cov-vlabel {
+  display: inline-block;
+  writing-mode: vertical-rl;
+  transform: rotate(180deg);
+  color: var(--ow-cov-muted);
+  font-size: 0.72rem;
+  font-weight: 500;
+  line-height: 1;
+  padding: 0.25rem 0;
+  white-space: nowrap;
+}
+
+.ow-cov-table tbody td,
+.ow-cov-table tbody th {
+  border-bottom: 1px solid var(--ow-cov-border-soft) !important;
+}
+
+.ow-cov-table tbody tr:last-child td,
+.ow-cov-table tbody tr:last-child th {
+  border-bottom: 0 !important;
+}
+
+.ow-cov-cat td {
+  background: var(--ow-cov-bg-alt) !important;
+  color: var(--ow-cov-muted);
+  font-size: 0.7rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  padding: 0.3rem 0.75rem !important;
+}
+
+.ow-cov-metric {
+  line-height: 1.25;
+}
+
+.ow-cov-metric code {
+  font-size: 0.72rem;
+  background: transparent;
+  border: 0;
+  padding: 0;
+  color: var(--ow-cov-text);
+}
+
+.ow-cov-unit {
+  display: inline-block;
+  margin-left: 0.4rem;
+  padding: 0.05rem 0.3rem;
+  border-radius: 0.25rem;
+  background: var(--ow-cov-chip);
+  color: var(--ow-cov-muted);
+  font-size: 0.62rem;
+  line-height: 1.3;
+  vertical-align: middle;
+}
+
+.ow-cov-table td.y,
+.ow-cov-table td.n {
+  vertical-align: middle !important;
+  height: 1.9rem;
+}
+
+.ow-cov-table tbody tr:hover td,
+.ow-cov-table tbody tr:hover th {
+  background: var(--ow-cov-bg-alt);
+}
+
+/* Dots are drawn by CSS so the generated markup stays small. */
+.ow-cov-table td.y::before,
+.ow-cov-table td.n::before,
+.ow-cov-dot {
+  content: "";
+  display: inline-block;
+  width: 0.5rem;
+  height: 0.5rem;
+  border-radius: 999px;
+  background: var(--ow-cov-dot-off);
+  vertical-align: middle;
+}
+
+.ow-cov-table td.y::before,
+.ow-cov-dot.y {
+  background: var(--ow-cov-dot-on);
+  box-shadow: 0 0 0 3px var(--ow-cov-dot-ring);
+}
+
+/* Legend */
+.ow-cov-legend {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 1rem;
+  margin: 0.25rem 0 1rem;
+  color: var(--ow-cov-muted);
+  font-size: 0.75rem;
+}
+
+.ow-cov-legend .ow-cov-dot {
+  margin-right: 0.35rem;
+}
+
+/* Quick Overview: plain-text row labels and the two extra states. */
+.ow-cov-table .ow-cov-label {
+  font-weight: 600;
+}
+
+.ow-cov-table td.p,
+.ow-cov-table td.soon {
+  width: 1.9rem !important;
+  min-width: 1.9rem !important;
+  max-width: 1.9rem !important;
+  text-align: center !important;
+  vertical-align: middle !important;
+  height: 1.9rem;
+}
+
+.ow-cov-table td.p::before,
+.ow-cov-table td.soon::before {
+  content: "";
+  display: inline-block;
+  width: 0.5rem;
+  height: 0.5rem;
+  border-radius: 999px;
+  vertical-align: middle;
+}
+
+.ow-cov-table td.p::before,
+.ow-cov-dot.p {
+  background: linear-gradient(90deg, var(--ow-cov-dot-on) 50%, var(--ow-cov-dot-off) 50%);
+  box-shadow: 0 0 0 3px var(--ow-cov-dot-ring);
+}
+
+.ow-cov-table td.soon::before,
+.ow-cov-dot.soon {
+  box-sizing: border-box;
+  background: transparent;
+  border: 2px solid var(--ow-cov-dot-on);
+}
+
+.ow-cov-legend-col {
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 0.4rem;
+  margin: 0;
+}
+
+.ow-cov-legend b {
+  color: var(--ow-cov-text);
+  font-weight: 600;
+}
+
+/* Status text for screen readers; the dot carries the same information visually. */
+.ow-cov-sr {
+  position: absolute !important;
+  width: 1px !important;
+  height: 1px !important;
+  padding: 0 !important;
+  margin: -1px !important;
+  overflow: hidden !important;
+  clip: rect(0, 0, 0, 0) !important;
+  white-space: nowrap !important;
+  border: 0 !important;
+}
