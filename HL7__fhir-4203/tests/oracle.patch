index 00000000000..4a0c7daabca
--- /dev/null
+++ b/source/endpoint/endpoint-example-wado-uri.xml
@@ -0,0 +1,27 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<Endpoint xmlns="http://hl7.org/fhir" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://hl7.org/fhir ../../schema/endpoint.xsd">
+	<id value="example-wado-uri"/>
+	<text>
+		<status value="generated" />
+		<div xmlns="http://www.w3.org/1999/xhtml">
+			Example of an Imaging DICOM WADO-URI type endpoint
+		</div>
+	</text>
+		
+	<status value="active" />
+	<connectionType>
+		<coding>
+			<system value="http://terminology.hl7.org/CodeSystem/endpoint-connection-type" />
+			<code value="dicom-wado-uri" />
+		</coding>
+	</connectionType>
+	<name value="PACS Hospital DICOM WADO-URI endpoint" />
+	<payload>
+		<type>
+			<text value="DICOM WADO-URI"/>
+		</type>
+		<mimeType value="application/dicom"/>
+	</payload>
+
+	<address value="https://pacs.hospital.org/wado-uri"/>
+</Endpoint>
