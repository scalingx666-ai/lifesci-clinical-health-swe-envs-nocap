+def test_golden_report_digest() -> None:
+    report = _audit(REFERENCE_TEXT)
+    digest = hashlib.sha256(report.to_json().encode("utf-8")).hexdigest()
+    assert digest == _GOLDEN_REPORT_DIGEST
