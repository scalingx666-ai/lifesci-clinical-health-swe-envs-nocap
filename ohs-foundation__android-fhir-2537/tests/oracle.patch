diff --git a/datacapture/src/test/java/com/google/android/fhir/datacapture/views/factories/EditTextViewHolderFactoryTest.kt b/datacapture/src/test/java/com/google/android/fhir/datacapture/views/factories/EditTextViewHolderFactoryTest.kt
