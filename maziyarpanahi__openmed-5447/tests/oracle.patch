+def test_noisy_neighbour_cannot_take_a_quiet_principals_headroom() -> None:
+    controller = AdmissionController(
+        AdmissionConfig(
+            max_concurrency=4,
+            max_queue=8,
+            principal_max_concurrency=2,
+            principal_max_queue=2,
