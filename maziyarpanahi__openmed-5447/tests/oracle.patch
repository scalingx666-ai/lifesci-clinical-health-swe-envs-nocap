+_ADMISSION_ENV_VARS = (
+    ADMISSION_MAX_CONCURRENCY_ENV_VAR,
+    ADMISSION_MAX_QUEUE_ENV_VAR,
+    ADMISSION_PRINCIPAL_MAX_CONCURRENCY_ENV_VAR,
+    ADMISSION_PRINCIPAL_MAX_QUEUE_ENV_VAR,
+    ADMISSION_NAMESPACE_MAX_CONCURRENCY_ENV_VAR,
