+                (
+                    pixels[:, :, ::2, 0],
+                    pixels[:, :, 1::2, 0],
+                    pixels[:, :, ::2, 1],
+                    pixels[:, :, ::2, 2],
+                ),
+                axis=-1,
+            )
+        elif planar:
+            pixels = pixels.transpose(0, 3, 1, 2)
+    ds.PixelData = pixels.tobytes()
+    return ds
+
