+    monkeypatch.setattr(ImageFile, "LOAD_TRUNCATED_IMAGES", True)
+    assert assess_image_quality(source, policy).reasons == (
+        QualityReason.DECODER_UNAVAILABLE,
+    )
+    assert ImageFile.LOAD_TRUNCATED_IMAGES is True
