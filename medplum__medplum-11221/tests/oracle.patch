+// For system resources, only these types have dispatch work: Bot Lambda and cron teardown.
+const SYSTEM_DISPATCH_TYPES: readonly ResourceType[] = ['Bot', 'Cron'];
+function hasDispatchWork(data: DispatchJobData): boolean {
+  // Subscriptions never fire for AuditEvents, and no other target applies to them
+  if (data.resourceType === 'AuditEvent') {
+    return false;
+  }
+
+  // skip system resources except SYSTEM_DISPATCH_TYPES
+  return !data.target.system || SYSTEM_DISPATCH_TYPES.includes(data.resourceType);
+}
+
