+def get_detail_field_precedence(detail_field: str, workout_statistic_type: str) -> int:
+    """
+    Rank of a statistic among the sources of a detail field; lower wins.
+    """
+    order = WORKOUT_DETAIL_FIELD_PRECEDENCE.get(detail_field, ())
