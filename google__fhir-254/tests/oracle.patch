diff --git a/javatests/com/google/fhir/protogen/ProtoGeneratorV2Test.java b/javatests/com/google/fhir/protogen/ProtoGeneratorV2Test.java
new file mode 100644
index 00000000000..118581b2bcb
--- /dev/null
+++ b/javatests/com/google/fhir/protogen/ProtoGeneratorV2Test.java
@@ -0,0 +1,252 @@
