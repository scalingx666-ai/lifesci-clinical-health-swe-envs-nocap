@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import type { WithId } from '@medplum/core';
+import { getReferenceString } from '@medplum/core';
+import type { Patient, QuestionnaireResponse } from '@medplum/fhirtypes';
+import { MockClient } from '@medplum/mock';
+import type { SmartCheckinResponse } from '@smart-health-checkin/client';
+import { checkinRequest, CheckinResponse } from '@smart-health-checkin/client';
+import { validateResponseAgainstRequest } from '@smart-health-checkin/client/model';
+import { checkInRequest } from '../pages/CheckInPage.data';
+import { saveCheckIn } from './save-check-in';
+
+const phq2Canonical = 'https://smart-health-checkin.org/connectathon/Questionnaire/phq-2.json';
+
+function buildResponse(options: { walletName?: string; phq2?: boolean; phq2Partial?: boolean } = {}): CheckinResponse {
+  const request = checkinRequest(checkInRequest);
+  const json: SmartCheckinResponse = {
+    type: 'smart-health-checkin-response',
+    version: '1',
+    requestId: request.id,
+    artifacts: [
+      {
+        id: 'a1',
+        mediaType: 'application/fhir+json',
+        fhirVersion: '4.0.1',
+        fulfills: ['patient'],
+        value: {
+          resourceType: 'Patient',
+          id: 'wallet-patient',
+          name: [{ given: [options.walletName ?? 'Aria', 'Quinn'], family: 'Test' }],
+          birthDate: '1981-02-03',
+        },
+      },
+      ...(options.phq2 === false
+        ? []
+        : [
+            {
+              id: 'a2',
+              mediaType: 'application/fhir+json' as const,
+              fhirVersion: '4.0.1',
+              fulfills: ['phq2'],
+              value: {
+                resourceType: 'QuestionnaireResponse',
+                id: 'wallet-qr',
+                status: 'completed',
+                questionnaire: phq2Canonical,
+                subject: { reference: 'Patient/wallet-patient' },
+                encounter: { reference: 'Encounter/wallet-encounter' },
+                item: [
+                  { linkId: 'phq2-1', answer: [{ valueCoding: { system: 'http://loinc.org', code: 'LA6569-3' } }] },
+                  ...(options.phq2Partial
+                    ? []
+                    : [
+                        {
+                          linkId: 'phq2-2',
+                          answer: [{ valueCoding: { system: 'http://loinc.org', code: 'LA6570-1' } }],
+                        },
+                      ]),
+                ],
+              },
+            },
+          ]),
+    ],
+    requestStatus: request.items.map((item) => {
+      const declined = item.id === 'immunizations' || (item.id === 'phq2' && options.phq2 === false);
+      return { item: item.id, status: declined ? 'declined' : 'fulfilled' };
+    }),
+  };
+  const validation = validateResponseAgainstRequest(request, json);
+  if (!validation.ok) {
+    throw new Error(validation.error);
+  }
+  return new CheckinResponse(validation, request);
+}
+
+describe('saveCheckIn', () => {
+  let medplum: MockClient;
+  let patient: WithId<Patient>;
+
+  beforeEach(async () => {
+    medplum = new MockClient();
+    patient = await medplum.createResource<Patient>({
+      resourceType: 'Patient',
+      name: [{ given: ['Aria'], family: 'Test' }],
+      birthDate: '1981-02-03',
+    });
+  });
+
+  test('Stages the response, form answers, review task, and provenance', async () => {
+    const { task, documentReference, warnings } = await saveCheckIn(medplum, patient, buildResponse(), 'Test Wallet');
+
+    expect(warnings).toEqual([]);
+    expect(documentReference.content.map((c) => c.attachment.title)).toEqual(['Check-in response', 'Check-in request']);
+    expect(documentReference.content[0].attachment.url).toBeDefined();
+
+    const qrRef = task.input?.find((i) => i.type.text === 'Two questions about your mood')?.valueReference;
+    const qr = await medplum.readReference<QuestionnaireResponse>(qrRef as { reference: string });
+    expect(qr.subject?.reference).toBe(getReferenceString(patient));
+    expect(qr.questionnaire).toBe(phq2Canonical);
+    expect(qr.encounter).toBeUndefined();
+
+    expect(task.focus?.reference).toBe(getReferenceString(patient));
+    expect(task.description).toContain('shared 6 of 7');
+    expect(task.description).toContain('total score: 3');
+    expect(task.input?.find((i) => i.type.text === 'Immunizations')?.valueString).toBe('declined');
+    expect(task.note).toBeUndefined();
+
+    // MockClient can't search Provenance by target, so list them all
+    const [provenance] = await medplum.searchResources('Provenance');
+    expect(provenance.target.map((t) => t.reference)).toEqual(
+      expect.arrayContaining([getReferenceString(patient), getReferenceString(task)])
+    );
+  });
+
+  test('Flags a wallet patient that does not match the account', async () => {
+    const { task } = await saveCheckIn(medplum, patient, buildResponse({ walletName: 'Bob' }), 'Test Wallet');
+    expect(task.note?.[0].text).toContain('Bob Quinn Test, born 1981-02-03');
+  });
+
+  test('Says when a scored form is only partly answered', async () => {
+    const { task } = await saveCheckIn(medplum, patient, buildResponse({ phq2Partial: true }), 'Test Wallet');
+    expect(task.description).toContain('total score: 1 (1 of 2 answered).');
+  });
+
+  test('Notes form answers that could not be saved instead of failing', async () => {
+    const create = medplum.createResourceIfNoneExist.bind(medplum);
+    vi.spyOn(medplum, 'createResourceIfNoneExist').mockImplementation((resource, query) =>
+      resource.resourceType === 'QuestionnaireResponse' ? Promise.reject(new Error('Invalid')) : create(resource, query)
+    );
+    const { task } = await saveCheckIn(medplum, patient, buildResponse(), 'Test Wallet');
+    expect(task.note?.[0].text).toContain("Two questions about your mood: answers couldn't be saved");
+  });
+
+  test('Saves without form answers', async () => {
+    const { task } = await saveCheckIn(medplum, patient, buildResponse({ phq2: false }), 'Test Wallet');
+    expect(task.input?.some((i) => i.valueReference?.reference?.startsWith('QuestionnaireResponse/'))).toBe(false);
+    expect(task.description).not.toContain('score');
+  });
+
+  // MockClient can't search DocumentReference or QuestionnaireResponse by identifier; those are checked on a real server
+  test('Retry reuses the review task', async () => {
+    const response = buildResponse();
+    const first = await saveCheckIn(medplum, patient, response, 'Test Wallet');
+    const second = await saveCheckIn(medplum, patient, response, 'Test Wallet');
+    expect(second.task.id).toBe(first.task.id);
+  });
+});
diff --git a/examples/foomedical/src/utils/save-check-in.ts b/examples/foomedical/src/utils/save-check-in.ts
new file mode 100644
index 00000000000..d698fad43a3
--- /dev/null
+++ b/examples/foomedical/src/utils/save-check-in.ts
@@ -0,0 +1,269 @@
+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import type { MedplumClient, WithId } from '@medplum/core';
+import {
+  ContentType,
+  createReference,
+  formatHumanName,
+  getQuestionnaireAnswers,
+  normalizeErrorString,
+} from '@medplum/core';
+import type {
+  DocumentReference,
+  Identifier,
+  Patient,
+  Questionnaire,
+  QuestionnaireItemAnswerOption,
+  QuestionnaireResponse,
+  Reference,
+  Task,
+  TaskInput,
+} from '@medplum/fhirtypes';
+import type { CheckinResponse } from '@smart-health-checkin/client';
+import { CHECKIN_REQUEST_ID_SYSTEM } from '@smart-health-checkin/client/fhir';
+
+export interface SavedCheckIn {
+  readonly task: WithId<Task>;
+  readonly documentReference: WithId<DocumentReference>;
+  /** Problems the patient should know about; the check-in was still sent. */
+  readonly warnings: string[];
+}
+
+/**
+ * Stages a check-in for care team review: the response as received (DocumentReference + Binary), each form's
+ * QuestionnaireResponse, a "Review check-in" Task, and a Provenance. Nothing is written into the chart itself.
+ *
+ * A retry after a failure doesn't duplicate the DocumentReference, QuestionnaireResponses, or Task: they're keyed by
+ * the check-in request id, so a retry finds what an earlier attempt created.
+ * @param medplum - The Medplum client, signed in as the patient.
+ * @param patient - The signed-in patient.
+ * @param response - The validated check-in response.
+ * @param walletName - The name of the app that answered, for the care team.
+ * @returns The created Task and DocumentReference, and any warnings.
+ */
+export async function saveCheckIn(
+  medplum: MedplumClient,
+  patient: WithId<Patient>,
+  response: CheckinResponse,
+  walletName: string
+): Promise<SavedCheckIn> {
+  const requestId = response.request.id;
+  const patientRef = createReference(patient);
+  const now = new Date().toISOString();
+  const identifier = (suffix = ''): Identifier => ({ system: CHECKIN_REQUEST_ID_SYSTEM, value: requestId + suffix });
+  const ifNoneExist = (id: Identifier): string => `identifier=${id.system}|${id.value}`;
+  const reviewNotes = getReviewNotes(response, patient);
+
+  let documentReference = await medplum.createResourceIfNoneExist<DocumentReference>(
+    {
+      resourceType: 'DocumentReference',
+      status: 'current',
+      identifier: [identifier()],
+      type: { text: 'SMART Health Check-in response' },
+      description: `SMART Health Check-in from ${walletName}`,
+      subject: patientRef,
+      author: [patientRef],
+      date: now,
+      content: [{ attachment: { contentType: ContentType.JSON } }],
+    },
+    ifNoneExist(identifier())
+  );
+  if (!documentReference.content[0]?.attachment.url) {
+    const securityContext = createReference(documentReference);
+    const responseAttachment = await medplum.createAttachment({
+      data: JSON.stringify(response.json),
+      contentType: ContentType.JSON,
+      filename: 'checkin-response.json',
+      securityContext,
+    });
+    const requestAttachment = await medplum.createAttachment({
+      data: JSON.stringify(response.request),
+      contentType: ContentType.JSON,
+      filename: 'checkin-request.json',
+      securityContext,
+    });
+    documentReference = await medplum.updateResource({
+      ...documentReference,
+      content: [
+        { attachment: { ...responseAttachment, title: 'Check-in response' } },
+        { attachment: { ...requestAttachment, title: 'Check-in request' } },
+      ],
+    });
+  }
+
+  const formInputs: TaskInput[] = [];
+  for (const item of response.request.items) {
+    const answers = item.content.kind === 'form.fhir' ? response.form(item.id) : undefined;
+    if (!answers) {
+      continue;
+    }
+    // Copy only the answers: the wallet's other references (subject, encounter, ...) point at resources only it has
+    const { questionnaire, status, authored, item: answerItems } = answers as unknown as QuestionnaireResponse;
+    const formId = identifier('/' + item.id);
+    try {
+      const qr = await medplum.createResourceIfNoneExist<QuestionnaireResponse>(
+        {
+          resourceType: 'QuestionnaireResponse',
+          questionnaire,
+          status,
+          authored,
+          item: answerItems,
+          identifier: formId,
+          subject: patientRef,
+          source: patientRef,
+          author: patientRef,
+        },
+        ifNoneExist(formId)
+      );
+      formInputs.push({ type: { text: item.title }, valueReference: createReference(qr) });
+    } catch (err) {
+      reviewNotes.push(
+        `${item.title}: answers couldn't be saved (${normalizeErrorString(err)}); see the check-in response.`
+      );
+    }
+  }
+
+  const items = response.items();
+  const shared = items.filter((i) => i.status === 'fulfilled' || i.status === 'partial').length;
+  const scores = getFormScores(response);
+  const task = await medplum.createResourceIfNoneExist<Task>(
+    {
+      resourceType: 'Task',
+      status: 'requested',
+      intent: 'order',
+      priority: 'routine',
+      identifier: [identifier()],
+      code: { text: 'Review check-in' },
+      description: [
+        `Review SMART Health Check-in from ${walletName}: shared ${shared} of ${items.length}.`,
+        ...scores,
+      ].join(' '),
+      for: patientRef,
+      focus: patientRef,
+      requester: patientRef,
+      authoredOn: now,
+      input: [
+        { type: { text: 'Check-in response' }, valueReference: createReference(documentReference) },
+        ...formInputs,
+        ...items.map((i) => ({
+          type: { text: i.title },
+          valueString: [i.status ?? 'no valid status', i.message].filter(Boolean).join(': '),
+        })),
+      ],
+      note: reviewNotes.map((text) => ({ text, time: now })),
+    },
+    ifNoneExist(identifier())
+  );
+
+  const warnings: string[] = [];
+  try {
+    await medplum.createResource({
+      resourceType: 'Provenance',
+      target: [
+        patientRef,
+        createReference(documentReference),
+        ...formInputs.map((i) => i.valueReference as Reference),
+        createReference(task),
+      ],
+      recorded: now,
+      agent: [
+        {
+          type: {
+            coding: [{ system: 'http://terminology.hl7.org/CodeSystem/provenance-participant-type', code: 'author' }],
+            text: 'Patient-supplied via SMART Health Check-in',
+          },
+          who: patientRef,
+        },
+      ],
+      entity: [{ role: 'source', what: { identifier: identifier(), display: walletName } }],
+    });
+  } catch (err) {
+    warnings.push(`Your check-in was sent, but its audit record wasn't saved: ${normalizeErrorString(err)}`);
+  }
+
+  return { task, documentReference, warnings };
+}
+
+/**
+ * Things the care team should check before using the shared data.
+ * @param response - The validated check-in response.
+ * @param patient - The signed-in patient.
+ * @returns One note per problem.
+ */
+function getReviewNotes(response: CheckinResponse, patient: Patient): string[] {
+  const notes: string[] = [];
+  const walletPatient = response.resources('patient', { type: 'Patient' })[0] as Patient | undefined;
+  if (walletPatient && identityKey(walletPatient) !== identityKey(patient)) {
+    notes.push(
+      `The app shared records for ${describePatient(walletPatient)}, but this account is ${describePatient(patient)}. Confirm identity before using them.`
+    );
+  }
+  for (const item of response.request.items) {
+    for (const card of response.healthCards(item.id).filter((c) => !c.accepted)) {
+      notes.push(
+        `${item.title}: a SMART Health Card from ${card.issuer ?? 'an unknown issuer'} wasn't accepted (${card.reason ?? 'not verified'}).`
+      );
+    }
+  }
+  for (const d of response.disregarded()) {
+    notes.push(
+      `A record (${d.id ?? `artifact ${d.index}`}) failed the check-in checks and was set aside: ${d.problems.map((p) => p.message).join('; ')}`
+    );
+  }
+  return notes;
+}
+
+function identityKey(patient: Patient): string {
+  const name = patient.name?.[0];
+  return [name?.given?.[0], name?.family, patient.birthDate].join('|').toLowerCase();
+}
+
+function describePatient(patient: Patient): string {
+  const name = patient.name?.[0] ? formatHumanName(patient.name[0]) : 'unknown name';
+  return patient.birthDate ? `${name}, born ${patient.birthDate}` : name;
+}
+
+/**
+ * Totals for forms whose answer options carry scores, such as PHQ-2. The patient picks answers; the receiver sums them.
+ * @param response - The validated check-in response.
+ * @returns One sentence per scored form, such as "PHQ-2 depression screen total score: 3.", noting unanswered questions.
+ */
+function getFormScores(response: CheckinResponse): string[] {
+  const scores: string[] = [];
+  for (const item of response.request.items) {
+    if (item.content.kind !== 'form.fhir') {
+      continue;
+    }
+    const questionnaire = item.content.questionnaire as Questionnaire | undefined;
+    const answers = response.form(item.id) as QuestionnaireResponse | undefined;
+    if (!questionnaire || !answers) {
+      continue;
+    }
+    const scoredQuestions = (questionnaire.item ?? []).filter((q) =>
+      q.answerOption?.some((o) => getScore(o) !== undefined)
+    );
+    const answersByLinkId = getQuestionnaireAnswers(answers);
+    let total = 0;
+    let answered = 0;
+    for (const question of scoredQuestions) {
+      const answer = answersByLinkId[question.linkId]?.valueCoding;
+      const option = question.answerOption?.find(
+        (o) => answer && o.valueCoding?.system === answer.system && o.valueCoding?.code === answer.code
+      );
+      const score = option && getScore(option);
+      if (score !== undefined) {
+        total += score;
+        answered++;
+      }
+    }
+    if (answered > 0) {
+      const partial = answered < scoredQuestions.length ? ` (${answered} of ${scoredQuestions.length} answered)` : '';
+      scores.push(`${questionnaire.title ?? item.title} total score: ${total}${partial}.`);
+    }
+  }
+  return scores;
+}
+
+function getScore(option: QuestionnaireItemAnswerOption): number | undefined {
+  return option.extension?.find((e) => e.url === 'http://hl7.org/fhir/StructureDefinition/ordinalValue')?.valueDecimal;
+}
