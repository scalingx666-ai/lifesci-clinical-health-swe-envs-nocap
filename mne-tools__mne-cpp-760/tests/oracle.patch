+//*************************************************************************************************************
+
+void TestEDF2FIFFRWR::cleanupTestCase()
+{
+    // destroy containers
+    delete m_pFiffRaw;
+    delete m_pEDFRaw;
+
+    // close files
+    m_pFileOut->close();
+    m_pFileIn->close();
+
+    // remove temporary outfile
+    m_pFileOut->remove();
+
+    // destroy filehandles
+    delete m_pFileOut;
+    delete m_pFileIn;
+}
