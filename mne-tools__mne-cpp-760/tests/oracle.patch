+//=============================================================================================================
+/**
+* @file     edf_info.h
+* @author   Simon Heinke <simon.heinke@tu-ilmenau.de>;
+*           Matti Hamalainen <msh@nmr.mgh.harvard.edu>
+* @version  1.0
