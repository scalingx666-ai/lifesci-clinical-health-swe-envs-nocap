+def _unavailable(name: str) -> dict[str, Any]:
+    metrics = passing_metrics()
+    metrics[name] = {"status": "unavailable"}
+    return metrics
+
+
+def _changed(name: str, **fields: Any) -> dict[str, Any]:
+    metrics = passing_metrics()
+    metrics[name] = {**metrics[name], **fields}
+    return metrics
+
