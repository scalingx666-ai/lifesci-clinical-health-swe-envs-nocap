+def test_every_tier_resolves_in_the_canonical_tier_table() -> None:
+    matrix = load_kit_support_matrix()
+    names = tier_names(TIERS)
+    tiers = {cell["tier"] for cell in matrix["cells"] if cell["tier"] is not None}
