+<databaseChangeLog
+	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
+	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">
+
+	<!--
+		runOnChange makes Liquibase recompute this changeset's checksum (and so read the sql file) when
+		deciding whether an already-run changeset needs to run again. See TRUNK-6809.
+	-->
+	<changeSet id="testRunOnChangeSqlFile" author="OpenMRS" runOnChange="true">
+		<sqlFile endDelimiter=";" path="sql/testSqlFile.sql" relativeToChangelogFile="true" stripComments="true" />
+	</changeSet>
+
+</databaseChangeLog>
