@@ -58,8 +58,18 @@ class SentryServletContextListener implements ServletContextListener {
     private String fetchGitCommit() {
         Properties properties = new Properties()
         try {
+            // The git.properties file is generated by the gradle-git-properties plugin, which is applied in
+            // build.gradle. The file is generated in build/resources/main and included in the WAR file. It contains
+            // the git commit hash, branch, and other information. The plugin does not generate a git.properties file
+            // when running within a worktree or from source, so we need to handle that case.
             InputStream is = this.class.classLoader.getResourceAsStream('git.properties')
-            properties.load(is)
+            if (!is) {
+                log.info "git.properties not found (git worktree or source build); skipping Sentry commit"
+                return null
+            }
+            // withStream closes the stream after loading
+            is.withStream { properties.load(it) }
+
         } catch (Exception e) {
             log.warn('Unable to load git.properties file for sentry-servlet', e)
         }
