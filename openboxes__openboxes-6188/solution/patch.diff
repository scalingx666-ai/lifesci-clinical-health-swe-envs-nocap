@@ -83,6 +83,35 @@ plugins {
     id 'jacoco'
 }
 
+// JGit 5.x (forced above for Java 8 compatibility) cannot read linked
+// git worktrees, where .git is a file rather than a directory. In a
+// worktree, skip the plugin and write git.properties with the git CLI
+// instead, so GitProperties is still populated. See #6186.
+def isWorktree = file('.git').isFile()
+
+generateGitProperties {
+    onlyIf { !isWorktree }
+}
+
+task generateGitPropertiesWithinWorktree {
+    onlyIf { isWorktree }
+    mustRunAfter processResources
+    def outputFile = file("$buildDir/resources/main/git.properties")
+    outputs.file outputFile
+    outputs.upToDateWhen { false }
+    doLast {
+        def git = { String... args -> (['git'] + args.toList()).execute(null, projectDir).text.trim() }
+        outputFile.parentFile.mkdirs()
+        outputFile.text = [
+                "git.branch=${git('rev-parse', '--abbrev-ref', 'HEAD')}",
+                "git.commit.id=${git('rev-parse', 'HEAD')}",
+                "git.commit.id.abbrev=${git('rev-parse', '--short', 'HEAD')}",
+                "git.commit.time=${git('log', '-1', '--format=%cd', '--date=format:%Y-%m-%dT%H:%M:%S%z')}",
+        ].join('\n') + '\n'
+    }
+}
+classes.dependsOn "generateGitPropertiesWithinWorktree"
+
 // prevent warfile issues by applying this before `asset-pipeline`. OBGM-353
 apply plugin: 'org.grails.grails-web'
 
