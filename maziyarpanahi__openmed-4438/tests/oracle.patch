+def _limit_extensions(
+    category: GraphQLLimitCategory, maximum: Any, observed: int
+) -> dict[str, Any]:
+    return {
+        "code": GRAPHQL_LIMIT_EXCEEDED_CODE,
+        "limit": category.value,
+        "maximum": maximum,
+        "observed": observed,
+    }
