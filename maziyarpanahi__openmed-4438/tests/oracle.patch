+def test_adversarial_documents_never_reach_a_resolver_or_model_loader(
+    monkeypatch: pytest.MonkeyPatch,
+    caplog: pytest.LogCaptureFixture,
+    resolver_calls: list[str],
+    subtests,
+) -> None:
+    for name, value in {
