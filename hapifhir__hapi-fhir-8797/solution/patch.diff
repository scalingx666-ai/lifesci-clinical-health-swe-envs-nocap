diff --git a/hapi-fhir-storage/src/test/java/ca/uhn/fhir/jpa/dao/AutoVersionSaveOrderTest.java b/hapi-fhir-storage/src/test/java/ca/uhn/fhir/jpa/dao/AutoVersionSaveOrderTest.java
