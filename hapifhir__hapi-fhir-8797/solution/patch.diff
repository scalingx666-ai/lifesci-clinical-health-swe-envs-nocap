+				assertThat(patientA.getLinkFirstRep().getOther().getReference()).isEqualTo(patientB.getIdElement().getValue());
+				assertThat(patientB.getLinkFirstRep().getOther().getReference()).isEqualTo(patientA.getIdElement().getValue());
