+        "run_spm12.sh",
+        "run_spm24.sh",
+        "run_spm25.01.sh",
+        "run_spmrc24.sh",
+        "run_spm_25.sh",
+    ],
+)
+def test_get_real_spm_standalone_file_error(tmp_path, spm_file):
+    from clinica.utils.spm import _get_real_spm_standalone_file
+
+    (tmp_path / spm_file).touch()
