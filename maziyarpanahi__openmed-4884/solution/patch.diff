+def _mutate(path: str, value: Any):
+    def apply(record: dict[str, Any]) -> None:
+        *parents, leaf = path.split(".")
+        target = record
+        for key in parents:
+            target = target[key]
+        target[leaf] = value
+
+    return apply
+
+
+@pytest.mark.parametrize(
