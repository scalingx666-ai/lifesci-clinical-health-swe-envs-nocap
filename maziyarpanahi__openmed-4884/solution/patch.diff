+                "bytes": 10,
+                "external_data": [],
+                "op_types": ["Cast", "MatMul", "Shape"],
+            },
+            "fallback-control": {
+                "file": "graphs/model.fallback-control.onnx",
+                "precision": "float32",
+                "sha256": "4" * 64,
+                "bytes": 10,
+                "external_data": [],
+                "op_types": ["Cast", "MatMul", "Mod", "Shape"],
