+def source_page(index):
+    return EvidenceNode(
+        node_id=f"{1000 + index * 100:032x}",
+        kind=NodeKind.PAGE,
+        source_digest="a" * 64,
+        geometry=PageGeometry(page=index, width=100, height=100),
