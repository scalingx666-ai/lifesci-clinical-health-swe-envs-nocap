+TRANSPORT_TLS = "tls"
+TRANSPORT_MTLS = "mtls"
+
+_UNIX_PREFIXES = ("unix:", "unix-abstract:")
+_FINGERPRINT_PATTERN = re.compile(r"[0-9a-f]{64}")
