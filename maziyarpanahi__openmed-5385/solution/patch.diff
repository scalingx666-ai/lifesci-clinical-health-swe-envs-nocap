+def _server_source(files: CredentialFiles, **overrides: Any) -> TLSCredentialSource:
+    values: dict[str, Any] = {
+        "certificate_chain_file": files.certificate_chain_file,
+        "private_key_file": files.private_key_file,
+        "client_ca_file": files.client_ca_file,
