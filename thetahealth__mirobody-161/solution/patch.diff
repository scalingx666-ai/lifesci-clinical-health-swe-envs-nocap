+_COMMON_CANONICAL = "COUNT(DISTINCT unit_canonical) = 1 AND COUNT(value_canonical) = COUNT(value_num)"
+_STAT_VALUE = (
+    "CASE WHEN COUNT(DISTINCT unit_ucum) <= 1 THEN {agg}(value_num)"
