diff --git a/CHANGELOG.md b/CHANGELOG.md
index 63a25660be..c9bfe44347 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -9,6 +9,8 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0
 
 ### Added
 
+- Declare the v3.4 reference deployment, supported transports with their security posture, replica modes, durable components with recovery objectives, and unsupported deployments in a schema-validated file with a matching docs page (#3919).
+
 - Add deterministic edge-VLM execution memory plans with explicit device budgets, bounded preprocessing estimates and local-only abstention before allocation (#2792).
 
 - Define an offline edge-VLM provider contract with bounded image/prompt inputs, source-linked evidence, model/preprocessing digests, shared abstentions, content-free reports and explicit human review for non-diagnostic drafts (#2791).
diff --git a/deploy/reference/reference-deployment.schema.json b/deploy/reference/reference-deployment.schema.json
new file mode 100644
index 0000000000..6b67b07d47
--- /dev/null
+++ b/deploy/reference/reference-deployment.schema.json
@@ -0,0 +1,425 @@
+{
+  "$id": "https://openmed.life/schemas/deploy/reference-deployment.schema.json",
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "OpenMed reference deployment declaration",
+  "description": "Declares the reference topology, supported transports, replica modes, durable components with recovery objectives, and unsupported deployments for one release line. Values are controlled codes and repository-relative references only.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "release",
+    "objective_evidence",
+    "reference_topology",
+    "topologies",
+    "services",
+    "transports",
+    "durable_components",
+    "unsupported_deployments"
+  ],
+  "properties": {
+    "schema_version": {
+      "const": "openmed.reference_deployment.v1"
+    },
+    "release": {
+      "type": "string",
+      "pattern": "^[0-9]+\\.[0-9]+$"
+    },
+    "objective_evidence": {
+      "description": "Whether the recovery objectives are measured. Drills and signed evidence are owned elsewhere.",
+      "enum": ["unmeasured_targets", "measured"]
+    },
+    "reference_topology": {
+      "$ref": "#/$defs/code"
+    },
+    "topologies": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "$ref": "#/$defs/topology"
+      }
+    },
+    "services": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "$ref": "#/$defs/service"
+      }
+    },
+    "transports": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "$ref": "#/$defs/transport"
+      }
+    },
+    "durable_components": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "$ref": "#/$defs/durable_component"
+      }
+    },
+    "unsupported_deployments": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "$ref": "#/$defs/unsupported_deployment"
+      }
+    }
+  },
+  "$defs": {
+    "code": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9_]*$",
+      "maxLength": 64
+    },
+    "codes": {
+      "type": "array",
+      "items": {
+        "$ref": "#/$defs/code"
+      },
+      "uniqueItems": true
+    },
+    "summary": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 400
+    },
+    "repo_path": {
+      "type": "string",
+      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
+    },
+    "module_ref": {
+      "type": "string",
+      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(:[A-Za-z_][A-Za-z0-9_]*)?$"
+    },
+    "route": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["surface", "method", "path"],
+      "properties": {
+        "surface": {
+          "enum": ["rest", "journey_worker", "mcp"]
+        },
+        "method": {
+          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
+        },
+        "path": {
+          "type": "string",
+          "pattern": "^/[A-Za-z0-9_./{}-]*$"
+        }
+      }
+    },
+    "manifest": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["path"],
+      "properties": {
+        "path": {
+          "$ref": "#/$defs/repo_path"
+        },
+        "compose_services": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^[a-z][a-z0-9-]*$"
+          },
+          "uniqueItems": true
+        },
+        "compose_volumes": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^[a-z][a-z0-9-]*$"
+          },
+          "uniqueItems": true
+        },
+        "helm_values": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
+          },
+          "uniqueItems": true
+        }
+      }
+    },
+    "references": {
+      "type": "object",
+      "additionalProperties": false,
+      "minProperties": 1,
+      "properties": {
+        "modules": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/module_ref"
+          },
+          "uniqueItems": true
+        },
+        "routes": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/route"
+          }
+        },
+        "grpc_methods": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^[A-Za-z][A-Za-z0-9]*/[A-Za-z][A-Za-z0-9]*$"
+          },
+          "uniqueItems": true
+        },
+        "manifests": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/manifest"
+          }
+        },
+        "docs": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "pattern": "^docs/[A-Za-z0-9_./-]+\\.md$"
+          },
+          "uniqueItems": true
+        }
+      }
+    },
+    "topology": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "status", "summary", "services", "references"],
+      "properties": {
+        "id": {
+          "$ref": "#/$defs/code"
+        },
+        "status": {
+          "enum": ["reference", "supported", "unsupported"]
+        },
+        "summary": {
+          "$ref": "#/$defs/summary"
+        },
+        "services": {
+          "$ref": "#/$defs/codes",
+          "minItems": 1
+        },
+        "references": {
+          "$ref": "#/$defs/references",
+          "required": ["manifests"]
+        }
+      }
+    },
+    "replica_mode": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["mode", "status", "constraint_codes"],
+      "properties": {
+        "mode": {
+          "enum": ["single", "horizontal", "one_shot", "external"]
+        },
+        "status": {
+          "enum": ["reference", "supported", "restricted", "unsupported"]
+        },
+        "constraint_codes": {
+          "$ref": "#/$defs/codes"
+        },
+        "references": {
+          "$ref": "#/$defs/references"
+        }
+      }
+    },
+    "service": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "summary", "replica_modes", "references"],
+      "properties": {
+        "id": {
+          "$ref": "#/$defs/code"
+        },
+        "summary": {
+          "$ref": "#/$defs/summary"
+        },
+        "replica_modes": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "$ref": "#/$defs/replica_mode"
+          }
+        },
+        "references": {
+          "$ref": "#/$defs/references"
+        }
+      }
+    },
+    "security_posture": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "encryption",
+        "authentication",
+        "default_exposure",
+        "constraint_codes"
+      ],
+      "properties": {
+        "encryption": {
+          "enum": ["none", "optional_tls", "not_applicable"]
+        },
+        "authentication": {
+          "enum": ["none", "optional", "required", "not_applicable"]
+        },
+        "default_exposure": {
+          "enum": [
+            "local_process",
+            "loopback",
+            "internal_network",
+            "cluster_internal",
+            "outbound_only",
+            "not_wired"
+          ]
+        },
+        "constraint_codes": {
+          "$ref": "#/$defs/codes"
+        }
+      }
+    },
+    "transport": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "id",
+        "status",
+        "summary",
+        "services",
+        "security_posture",
+        "references"
+      ],
+      "properties": {
+        "id": {
+          "$ref": "#/$defs/code"
+        },
+        "status": {
+          "enum": ["supported", "restricted", "unsupported"]
+        },
+        "summary": {
+          "$ref": "#/$defs/summary"
+        },
+        "services": {
+          "$ref": "#/$defs/codes",
+          "minItems": 1
+        },
+        "security_posture": {
+          "$ref": "#/$defs/security_posture"
+        },
+        "references": {
+          "$ref": "#/$defs/references"
+        }
+      }
+    },
+    "recovery_objective": {
+      "oneOf": [
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["status", "target_seconds", "basis"],
+          "properties": {
+            "status": {
+              "const": "declared"
+            },
+            "target_seconds": {
+              "type": "integer",
+              "minimum": 0
+            },
+            "basis": {
+              "$ref": "#/$defs/code"
+            }
+          }
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["status", "reason_code"],
+          "properties": {
+            "status": {
+              "const": "unsupported"
+            },
+            "reason_code": {
+              "$ref": "#/$defs/code"
+            }
+          }
+        }
+      ]
+    },
+    "durable_component": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "id",
+        "summary",
+        "storage",
+        "replica_mode",
+        "owner_services",
+        "topologies",
+        "recovery_point_objective",
+        "recovery_time_objective",
+        "references"
+      ],
+      "properties": {
+        "id": {
+          "$ref": "#/$defs/code"
+        },
+        "summary": {
+          "$ref": "#/$defs/summary"
+        },
+        "storage": {
+          "$ref": "#/$defs/code"
+        },
+        "replica_mode": {
+          "enum": [
+            "single_primary",
+            "single_writer_volume",
+            "single_process",
+            "per_replica_memory",
+            "external_operator_owned"
+          ]
+        },
+        "owner_services": {
+          "$ref": "#/$defs/codes",
+          "minItems": 1
+        },
+        "topologies": {
+          "$ref": "#/$defs/codes",
+          "minItems": 1
+        },
+        "recovery_point_objective": {
+          "$ref": "#/$defs/recovery_objective"
+        },
+        "recovery_time_objective": {
+          "$ref": "#/$defs/recovery_objective"
+        },
+        "references": {
+          "$ref": "#/$defs/references"
+        }
+      }
+    },
+    "unsupported_deployment": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "reason_code", "summary", "references"],
+      "properties": {
+        "id": {
+          "$ref": "#/$defs/code"
+        },
+        "reason_code": {
+          "$ref": "#/$defs/code"
+        },
+        "summary": {
+          "$ref": "#/$defs/summary"
+        },
+        "references": {
+          "$ref": "#/$defs/references"
+        }
+      }
+    }
+  }
+}
diff --git a/deploy/reference/v3.4-reference-deployment.json b/deploy/reference/v3.4-reference-deployment.json
new file mode 100644
index 0000000000..bbd186b6fa
--- /dev/null
+++ b/deploy/reference/v3.4-reference-deployment.json
@@ -0,0 +1,1113 @@
+{
+  "schema_version": "openmed.reference_deployment.v1",
+  "release": "3.4",
+  "objective_evidence": "unmeasured_targets",
+  "reference_topology": "compose_single_host",
+  "topologies": [
+    {
+      "id": "compose_single_host",
+      "status": "reference",
+      "summary": "Offline single-host Compose bundle: bundled PostgreSQL, one-shot migration, Journey worker, REST API, optional smoke and MCP profiles on an internal network. Only the REST port is published, bound to loopback by default.",
+      "services": [
+        "postgres",
+        "journey_migrate",
+        "journey_worker",
+        "rest_api",
+        "journey_golden",
+        "mcp_server"
+      ],
+      "references": {
+        "manifests": [
+          {
+            "path": "deploy/openmed-compose.yaml",
+            "compose_services": [
+              "postgres",
+              "journey-migrate",
+              "journey-worker",
+              "openmed",
+              "journey-golden",
+              "mcp"
+            ],
+            "compose_volumes": [
+              "openmed-cache",
+              "openmed-models",
+              "openmed-postgres"
+            ]
+          },
+          {
+            "path": "deploy/docker/Dockerfile.distroless"
+          }
+        ],
+        "docs": [
+          "docs/deploy/self-hosted-compose.md",
+          "docs/deploy/hardened-image.md"
+        ]
+      }
+    },
+    {
+      "id": "helm_kubernetes",
+      "status": "supported",
+      "summary": "Helm chart for one namespace: one REST replica by default, opt-in Journey profile with a migration Job, a worker Deployment, an artifact claim, and an operator-provided external PostgreSQL referenced through a Secret.",
+      "services": [
+        "rest_api",
+        "journey_migrate",
+        "journey_worker",
+        "postgres"
+      ],
+      "references": {
+        "manifests": [
+          {
+            "path": "deploy/helm/openmed-service/Chart.yaml"
+          },
+          {
+            "path": "deploy/helm/openmed-service/values.yaml",
+            "helm_values": [
+              "replicaCount",
+              "persistence.enabled",
+              "journey.enabled",
+              "journey.worker.replicas",
+              "journey.database.secretName",
+              "journey.networkPolicy.enabled"
+            ]
+          },
+          {
+            "path": "deploy/helm/openmed-service/templates/deployment.yaml"
+          },
+          {
+            "path": "deploy/helm/openmed-service/templates/network-policy.yaml"
+          }
+        ],
+        "docs": [
+          "docs/deploy/helm.md"
+        ]
+      }
+    },
+    {
+      "id": "kubernetes_autoscaled",
+      "status": "supported",
+      "summary": "Horizontal autoscaling of the REST Deployment from queue depth, in-flight requests and CPU. Supported for synchronous routes only; process-local job state does not follow a request across replicas.",
+      "services": [
+        "rest_api"
+      ],
+      "references": {
+        "manifests": [
+          {
+            "path": "deploy/k8s/hpa.yaml"
+          }
+        ],
+        "docs": [
+          "docs/deploy/autoscaling.md"
+        ]
+      }
+    },
+    {
+      "id": "kubernetes_model_operator",
+      "status": "supported",
+      "summary": "Operator that pins the served model version of an existing REST Deployment and rolls it out or back. It changes no storage, transport or autoscaling behavior.",
+      "services": [
+        "rest_api"
+      ],
+      "references": {
+        "modules": [
+          "deploy.operator.openmed_operator"
+        ],
+        "manifests": [
+          {
+            "path": "deploy/operator/kustomization.yaml"
+          },
+          {
+            "path": "deploy/operator/crd/openmedmodel.yaml"
+          }
+        ],
+        "docs": [
+          "docs/deploy/operator.md"
+        ]
+      }
+    },
+    {
+      "id": "development_compose",
+      "status": "unsupported",
+      "summary": "Repository-root Compose file for local development. It publishes the REST port on every interface without authentication, has no Journey store, and is not a production topology.",
+      "services": [
+        "rest_api",
+        "mcp_server"
+      ],
+      "references": {
+        "manifests": [
+          {
+            "path": "docker-compose.yml",
+            "compose_services": [
+              "app",
+              "mcp"
+            ]
+          },
+          {
+            "path": "Dockerfile"
+          },
+          {
+            "path": "Dockerfile.mcp"
+          }
+        ]
+      }
+    }
+  ],
+  "services": [
+    {
+      "id": "rest_api",
+      "summary": "FastAPI REST service started through the PHI-safe logging launcher, with the GraphQL router mounted on the same listener.",
+      "replica_modes": [
+        {
+          "mode": "single",
+          "status": "reference",
+          "constraint_codes": []
+        },
+        {
+          "mode": "horizontal",
+          "status": "restricted",
+          "constraint_codes": [
+            "synchronous_routes_only",
+            "per_replica_warm_pool",
+            "per_replica_rate_limits",
+            "per_replica_job_state"
+          ],
+          "references": {
+            "manifests": [
+              {
+                "path": "deploy/k8s/hpa.yaml"
+              }
+            ]
+          }
+        }
+      ],
+      "references": {
+        "modules": [
+          "openmed.service.app:create_app",
+          "openmed.service.logging:main"
+        ],
+        "routes": [
+          {
+            "surface": "rest",
+            "method": "GET",
+            "path": "/livez"
+          },
+          {
+            "surface": "rest",
+            "method": "GET",
+            "path": "/readyz"
+          },
+          {
+            "surface": "rest",
+            "method": "GET",
+            "path": "/health"
+          },
+          {
+            "surface": "rest",
+            "method": "POST",
+            "path": "/analyze"
+          },
+          {
+            "surface": "rest",
+            "method": "POST",
+            "path": "/pii/extract"
+          },
+          {
+            "surface": "rest",
+            "method": "POST",
+            "path": "/pii/deidentify"
+          },
+          {
+            "surface": "rest",
+            "method": "POST",
+            "path": "/pii/deidentify/stream"
+          }
+        ],
+        "manifests": [
+          {
+            "path": "deploy/openmed-compose.yaml",
+            "compose_services": [
+              "openmed"
+            ]
+          },
+          {
+            "path": "deploy/helm/openmed-service/templates/deployment.yaml"
+          },
+          {
+            "path": "deploy/helm/openmed-service/templates/service.yaml"
+          }
+        ],
+        "docs": [
+          "docs/rest-service.md"
+        ]
+      }
+    },
+    {
+      "id": "journey_worker",
+      "summary": "Journey readiness worker. It refreshes value-free store and artifact probes and serves them over an internal health listener; it does not process jobs.",
+      "replica_modes": [
+        {
+          "mode": "single",
+          "status": "reference",
+          "constraint_codes": [
+            "health_probe_only"
+          ]
+        }
+      ],
+      "references": {
+        "modules": [
+          "openmed.deploy.journey:main",
+          "openmed.deploy.journey:probe_deployment"
+        ],
+        "routes": [
+          {
+            "surface": "journey_worker",
+            "method": "GET",
+            "path": "/livez"
+          },
+          {
+            "surface": "journey_worker",
+            "method": "GET",
+            "path": "/readyz"
+          },
+          {
+            "surface": "journey_worker",
+            "method": "GET",
+            "path": "/healthz"
+          }
+        ],
+        "manifests": [
+          {
+            "path": "deploy/openmed-compose.yaml",
+            "compose_services": [
+              "journey-worker"
+            ]
+          },
+          {
+            "path": "deploy/helm/openmed-service/templates/journey-worker.yaml"
+          }
+        ]
+      }
+    },
+    {
+      "id": "journey_migrate",
+      "summary": "One-shot, checksum-verified additive Journey schema migration that gates the worker and API start.",
+      "replica_modes": [
+        {
+          "mode": "one_shot",
+          "status": "reference",
+          "constraint_codes": [
+            "single_migration_runner",
+            "completes_before_api_and_worker"
+          ]
+        }
+      ],
+      "references": {
+        "modules": [
+          "openmed.deploy.journey:run_migrations"
+        ],
+        "manifests": [
+          {
+            "path": "deploy/openmed-compose.yaml",
+            "compose_services": [
+              "journey-migrate"
+            ]
+          },
+          {
+            "path": "deploy/helm/openmed-service/templates/journey-migration-job.yaml"
+          }
+        ]
+      }
+    },
+    {
+      "id": "journey_golden",
+      "summary": "One-shot synthetic golden journey used as a post-start and post-restore smoke check.",
+      "replica_modes": [
+        {
+          "mode": "one_shot",
+          "status": "supported",
+          "constraint_codes": [
+            "smoke_profile_only",
+            "synthetic_content_only"
+          ]
+        }
+      ],
+      "references": {
+        "modules": [
+          "openmed.deploy.journey:run_golden_journey"
+        ],
+        "manifests": [
+          {
+            "path": "deploy/openmed-compose.yaml",
+            "compose_services": [
+              "journey-golden"
+            ]
+          }
+        ]
+      }
+    },
+    {
+      "id": "mcp_server",
+      "summary": "MCP server. Standard input and output is the default; the Compose profile runs stateless streamable HTTP on the internal network only.",
+      "replica_modes": [
+        {
+          "mode": "single",
+          "status": "supported",
+          "constraint_codes": [
+            "optional_profile"
+          ]
+        }
+      ],
+      "references": {
+        "modules": [
