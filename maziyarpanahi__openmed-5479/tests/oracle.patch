+//! Synthetic stand-in for the packaged OpenMed sidecar.
+//!
+//! The qualification tests copy this executable into a temporary bundle as
+//! `openmed-sidecar`, pin it in a manifest, and let the real host start it.
+//! It speaks the JSON-lines protocol and misbehaves on purpose according to a
+//! `fake-sidecar-mode` file next to the executable. Its engine is a direct
+//! replay of the shared offset-contract vectors: for `doc_id`
+//! `parity:<case id>` it masks the reference span by Unicode code point.
+//! It handles only synthetic text and is never bundled into an application.
+
+use std::{
+    fs,
+    io::{self, BufRead, Write},
+    path::PathBuf,
+    process, thread,
+    time::Duration,
+};
+
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+
+const PARITY_VECTORS: &str = include_str!("../../../../tests/fixtures/parity/offset_contract.json");
+const RESPONSE_LIMIT_BYTES: usize = 64_000_000;
+const SYNTHETIC_NAME: &str = "Rowan Hale";
+
+fn main() {
+    let directory = bundle_directory();
+    let mode = fs::read_to_string(directory.join("fake-sidecar-mode"))
+        .map(|value| value.trim().to_owned())
+        .unwrap_or_else(|_| "ok".to_owned());
+    append(
+        &directory.join("fake-sidecar-starts"),
+        &format!("{}\n", process::id()),
+    );
+
+    match mode.as_str() {
+        "startup_failure" => {
+            eprintln!("Traceback: synthetic failure for {SYNTHETIC_NAME}");
+            eprintln!(r#"{{"error_code":"SIDECAR_START_FAILED","event":"sidecar_failed"}}"#);
+            process::exit(1);
+        }
+        "banner" => {
+            println!("OpenMed sidecar ready");
+        }
+        _ => {}
+    }
+
+    let stdin = io::stdin();
+    for line in stdin.lock().lines() {
+        let Ok(line) = line else { process::exit(0) };
+        let Ok(request) = serde_json::from_str::<Value>(&line) else {
+            continue;
+        };
+        let id = request["id"].as_str().unwrap_or_default().to_owned();
+        match request["operation"].as_str() {
+            Some("ping") => respond(&id, ping_result(&mode)),
+            Some("shutdown") => {
+                respond(&id, json!({"shutdown": true}));
+                process::exit(0);
+            }
+            Some("deidentify") => deidentify(&directory, &mode, &id, &request),
+            _ => respond_error(&id, "INVALID_REQUEST"),
+        }
+    }
+}
+
+fn deidentify(directory: &std::path::Path, mode: &str, id: &str, request: &Value) {
+    match mode {
+        "crash_on_deidentify" => process::exit(3),
+        "crash_once" => {
+            let marker = directory.join("fake-sidecar-crashed");
+            if !marker.exists() {
+                append(&marker, "crashed\n");
+                process::exit(3);
+            }
+        }
+        "partial_line" => {
+            print!(r#"{{"id":"{id}","ok":tr"#);
+            let _ = io::stdout().flush();
+            process::exit(2);
+        }
+        "stderr_failure" => {
+            eprintln!("Traceback: synthetic failure while redacting {SYNTHETIC_NAME}");
+            eprintln!(r#"{{"error_code":"SIDECAR_RUNTIME_FAILED","event":"sidecar_failed"}}"#);
+            process::exit(1);
+        }
+        "stderr_flood" => {
+            let noise = format!(
+                "synthetic diagnostic about {SYNTHETIC_NAME} {}",
+                "x".repeat(1_000)
+            );
+            let stderr = io::stderr();
+            let mut stderr = stderr.lock();
+            for _ in 0..2_048 {
+                let _ = writeln!(stderr, "{noise}");
+            }
+        }
+        "slow" => thread::sleep(Duration::from_secs(30)),
+        "delayed" => thread::sleep(Duration::from_millis(1_500)),
+        "stale_generation" => {
+            let sequence = id.rsplit(':').next().unwrap_or("0");
+            let stale = format!("{}:{sequence}", "f".repeat(32));
+            respond(&stale, engine(request));
+            return;
+        }
+        "wrong_id" => {
+            let generation = id.split(':').next().unwrap_or_default();
+            respond(&format!("{generation}:999999999"), engine(request));
+            return;
+        }
+        "oversized" => {
+            write_oversized(id);
+            return;
+        }
+        "malformed" => {
+            println!("{{not json for {SYNTHETIC_NAME}");
+            let _ = io::stdout().flush();
+            return;
+        }
+        "unknown_field" => {
+            write_line(
+                &json!({"id": id, "ok": true, "result": engine(request), "debug": SYNTHETIC_NAME}),
+            );
+            return;
+        }
+        "invalid_spans" => {
+            let mut result = engine(request);
+            let span = result["spans"][0].clone();
+            result["spans"] = json!([span.clone(), span]);
+            respond(id, result);
+            return;
+        }
+        _ => {}
+    }
+    respond(id, engine(request));
+}
+
+fn ping_result(mode: &str) -> Value {
+    let offline = ["OPENMED_OFFLINE", "HF_HUB_OFFLINE", "TRANSFORMERS_OFFLINE"]
+        .iter()
+        .all(|name| std::env::var(name).as_deref() == Ok("1"))
+        && std::env::var_os("PYTHONPATH").is_none()
+        && std::env::var_os("OPENMED_SIDECAR_MODEL")
+            .map(PathBuf::from)
+            .is_some_and(|path| path.is_dir());
+    let protocol_version = if mode == "protocol_two" { 2 } else { 1 };
+    json!({"offline": offline && mode != "online", "protocol_version": protocol_version})
+}
+
+/// Direct reference engine: mask the shared-vector span, or the synthetic
+/// name, in Unicode code-point coordinates.
+fn engine(request: &Value) -> Value {
+    let text = request["text"].as_str().unwrap_or_default();
+    let doc_id = request["options"]["doc_id"]
+        .as_str()
+        .unwrap_or("synthetic-fake")
+        .to_owned();
+    let characters: Vec<char> = text.chars().collect();
+    let found = if let Some(case_id) = doc_id.strip_prefix("parity:") {
+        parity_span(case_id)
+    } else {
+        text.find(SYNTHETIC_NAME).map(|byte_start| {
+            let start = text[..byte_start].chars().count();
+            (
+                start,
+                start + SYNTHETIC_NAME.chars().count(),
+                "[NAME]".to_owned(),
+            )
+        })
+    };
+    let Some((start, end, replacement)) =
+        found.filter(|(start, end, _)| start < end && *end <= characters.len())
+    else {
+        return json!({"deidentified_text": text, "spans": []});
+    };
+    let surface: String = characters[start..end].iter().collect();
+    let redacted: String = characters[..start].iter().collect::<String>()
+        + &replacement
+        + &characters[end..].iter().collect::<String>();
+    json!({
+        "deidentified_text": redacted,
+        "spans": [{
+            "schema_version": 1,
+            "doc_id": doc_id,
+            "start": start,
+            "end": end,
+            "text_hash": format!("hmac-sha256:{:x}", Sha256::digest(surface.as_bytes())),
+            "entity_type": "person",
+            "canonical_label": "NAME",
+            "policy_label": "DIRECT_IDENTIFIER",
+            "regulatory_tags": [],
+            "score": 0.99,
+            "detector": "fake-reference-engine",
+            "evidence": {},
+            "action": "mask",
+            "replacement": replacement,
+            "reversible_id": null,
+            "section": null,
+            "metadata": {},
+        }],
+    })
+}
+
+fn parity_span(case_id: &str) -> Option<(usize, usize, String)> {
+    let vectors: Value = serde_json::from_str(PARITY_VECTORS).ok()?;
+    let case = vectors["cases"]
+        .as_array()?
+        .iter()
+        .find(|case| case["id"].as_str() == Some(case_id))?;
+    Some((
+        usize::try_from(case["expected_start"].as_u64()?).ok()?,
+        usize::try_from(case["expected_end"].as_u64()?).ok()?,
+        case["replacement"].as_str()?.to_owned(),
+    ))
+}
+
+fn respond(id: &str, result: Value) {
+    write_line(&json!({"id": id, "ok": true, "result": result}));
+}
+
+fn respond_error(id: &str, code: &str) {
+    write_line(
+        &json!({"id": id, "ok": false, "error": {"code": code, "message": "Invalid sidecar request."}}),
+    );
+}
+
+fn write_line(value: &Value) {
+    let stdout = io::stdout();
+    let mut stdout = stdout.lock();
+    if writeln!(stdout, "{value}")
+        .and_then(|()| stdout.flush())
+        .is_err()
+    {
+        process::exit(0);
+    }
+}
+
+fn write_oversized(id: &str) {
+    let stdout = io::stdout();
+    let mut stdout = stdout.lock();
+    let chunk = vec![b'x'; 1 << 20];
+    let mut written = 0;
+    let header = format!(r#"{{"id":"{id}","ok":true,"result":{{"deidentified_text":""#);
+    if stdout.write_all(header.as_bytes()).is_err() {
+        process::exit(0);
+    }
+    while written <= RESPONSE_LIMIT_BYTES {
+        if stdout.write_all(&chunk).is_err() {
+            process::exit(0);
+        }
+        written += chunk.len();
+    }
+    let _ = stdout.write_all(b"\",\"spans\":[]}}\n");
+    let _ = stdout.flush();
+}
+
+fn bundle_directory() -> PathBuf {
+    std::env::current_exe()
+        .ok()
+        .and_then(|path| path.parent().map(PathBuf::from))
+        .unwrap_or_else(|| PathBuf::from("."))
+}
+
+fn append(path: &std::path::Path, line: &str) {
+    if let Ok(mut file) = fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = file.write_all(line.as_bytes());
+    }
+}
diff --git a/js/openmedkit-tauri/src-tauri/tests/packaged_sidecar_lane.rs b/js/openmedkit-tauri/src-tauri/tests/packaged_sidecar_lane.rs
new file mode 100644
index 0000000000..8362b68c72
--- /dev/null
+++ b/js/openmedkit-tauri/src-tauri/tests/packaged_sidecar_lane.rs
@@ -0,0 +1,155 @@
+//! Opt-in local-artifact lane for a real packaged sidecar.
+//!
+//! Not run by default. The `packaged-sidecar` job in
+//! `.github/workflows/tauri-sidecar.yml` builds the PyInstaller sidecar,
+//! provisions a local model directory, writes the manifest with
+//! `openmed-sidecar-manifest`, and then runs:
+//!
+//! ```text
+//! OPENMED_TAURI_LANE_SIDECAR=<executable> \
+//! OPENMED_TAURI_LANE_MANIFEST=<openmed-sidecar.json> \
+//! OPENMED_TAURI_LANE_MODEL_ROOT=<model directory> \
+//! OPENMED_SIDECAR_HASH_SECRET=sidecar-golden-secret \
+//! cargo test --locked --test packaged_sidecar_lane -- --ignored
+//! ```
+//!
+//! The lane compares the real sidecar with the shared direct reference vector
+//! used by the Python stdio tests, runs one model-backed request as a leakage
+//! check, and proves tampered or missing artifacts refuse before start. When
+//! `OPENMED_TAURI_LANE_EVIDENCE` is set it writes value-free evidence there.
+
+use std::{path::PathBuf, time::Duration};
+
+use openmedkit_tauri_sidecar::{
+    sidecar_command::{OpenMedSidecarState, SidecarDeidentifyOptions, SidecarDeidentifyRequest},
+    sidecar_manifest::{SidecarBundle, SidecarManifest, SidecarTarget},
+};
+use serde_json::{json, Value};
+
+const GOLDEN: &str =
+    include_str!("../../../../tests/unit/service/fixtures/sidecar_stdio_golden.json");
+const PHI_FRAGMENTS: [&str; 2] = ["425-555-0100", "rowan@example.test"];
+
+fn lane_path(name: &str) -> PathBuf {
+    std::env::var_os(name)
+        .map(PathBuf::from)
+        .unwrap_or_else(|| panic!("{name} must be set for the packaged sidecar lane"))
+}
+
+fn lane_state(bundle: SidecarBundle) -> OpenMedSidecarState {
+    OpenMedSidecarState::from_bundle(bundle)
+        .with_startup_timeout(Duration::from_secs(300))
+        .with_request_timeout(Duration::from_secs(300))
+}
+
+#[test]
+#[ignore = "local-artifact lane: needs a packaged PyInstaller sidecar and a local model"]
+fn packaged_sidecar_matches_shared_vectors_on_this_platform() {
+    let sidecar = lane_path("OPENMED_TAURI_LANE_SIDECAR");
+    let model_root = lane_path("OPENMED_TAURI_LANE_MODEL_ROOT");
+    let manifest_path = lane_path("OPENMED_TAURI_LANE_MANIFEST");
+    let bundle = SidecarBundle::from_manifest_file(&manifest_path, &sidecar, &model_root)
+        .expect("manifest readable");
+    let manifest_bytes = std::fs::read(&manifest_path).expect("manifest");
+    let pinned = bundle.manifest_sha256();
+    let golden: Value = serde_json::from_str(GOLDEN).expect("golden vector");
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .expect("runtime");
+
+    let qualification = runtime.block_on(async {
+        let state = lane_state(bundle.with_pinned_manifest_sha256(pinned.clone()));
+        let qualification = state.qualify().await.expect("packaged sidecar qualifies");
+        assert!(state.ping().await.expect("ping").offline);
+
+        let request = &golden["request"];
+        let options = &request["options"];
+        let result = state
+            .deidentify(SidecarDeidentifyRequest {
+                text: request["text"].as_str().expect("text").to_owned(),
+                options: SidecarDeidentifyOptions {
+                    policy: options["policy"].as_str().map(str::to_owned),
+                    doc_id: options["doc_id"].as_str().map(str::to_owned),
+                    deterministic_only: options["deterministic_only"].as_bool(),
+                    ..SidecarDeidentifyOptions::default()
+                },
+            })
+            .await
+            .expect("deterministic request");
+        let expected = &golden["expected"];
+        assert_eq!(result.deidentified_text, expected["deidentified_text"]);
+        let actual = serde_json::to_value(&result.spans).expect("spans");
+        let expected_spans = expected["spans"].as_array().expect("expected spans");
+        assert_eq!(actual.as_array().map(Vec::len), Some(expected_spans.len()));
+        let tolerance = expected["score_tolerance"].as_f64().expect("tolerance");
+        for (actual_span, expected_span) in actual.as_array().unwrap().iter().zip(expected_spans) {
+            for (key, value) in expected_span.as_object().expect("span") {
+                if key == "score" {
+                    let delta = actual_span[key].as_f64().expect("score") - value.as_f64().unwrap();
+                    assert!(delta.abs() <= tolerance, "score drift on {key}");
+                } else {
+                    assert_eq!(&actual_span[key], value, "span field {key}");
+                }
+            }
+        }
+
+        let model_backed = state
+            .deidentify(SidecarDeidentifyRequest {
+                text: request["text"].as_str().expect("text").to_owned(),
+                options: SidecarDeidentifyOptions {
+                    policy: Some("hipaa_safe_harbor".to_owned()),
+                    doc_id: Some("synthetic-tauri-lane".to_owned()),
+                    ..SidecarDeidentifyOptions::default()
+                },
+            })
+            .await
+            .expect("model-backed request");
+        for fragment in PHI_FRAGMENTS {
+            assert!(
+                !model_backed.deidentified_text.contains(fragment),
+                "direct identifier leaked"
+            );
+        }
+
+        assert!(state.shutdown().await.expect("shutdown").shutdown);
+        state.terminate().await;
+        qualification
+    });
+
+    let mut manifest = SidecarManifest::parse(&manifest_bytes).expect("parse");
+    manifest.model.files[0].sha256 = "0".repeat(64);
+    let tampered = SidecarBundle::new(
+        manifest.to_canonical_bytes().expect("encode"),
+        &sidecar,
+        &model_root,
+    );
+    let error = runtime
+        .block_on(lane_state(tampered).ping())
+        .expect_err("tampered model refuses");
+    assert_eq!(error.code, "SIDECAR_ARTIFACT_MISMATCH");
+
+    let missing = SidecarBundle::new(manifest_bytes.clone(), &sidecar, model_root.join("absent"));
+    let error = runtime
+        .block_on(lane_state(missing).ping())
+        .expect_err("missing model refuses");
+    assert_eq!(error.code, "SIDECAR_ARTIFACT_MISSING");
+
+    if let Some(path) = std::env::var_os("OPENMED_TAURI_LANE_EVIDENCE") {
+        let target = SidecarTarget::host();
+        let evidence = json!({
+            "schema": "openmed.tauri.sidecar_lane_evidence",
+            "schema_version": 1,
+            "platform": target.platform,
+            "arch": target.arch,
+            "manifest_sha256": qualification.manifest_sha256,
+            "files_verified": qualification.files_verified,
+            "protocol_version": qualification.protocol_version,
+            "golden_vectors_passed": 1,
+            "leakage_checks_passed": 1,
+            "negative_controls_passed": 2,
+        });
+        std::fs::write(path, serde_json::to_vec_pretty(&evidence).expect("encode"))
+            .expect("write evidence");
+    }
+}
diff --git a/js/openmedkit-tauri/src-tauri/tests/sidecar_qualification.rs b/js/openmedkit-tauri/src-tauri/tests/sidecar_qualification.rs
new file mode 100644
index 0000000000..e84e53acf7
--- /dev/null
+++ b/js/openmedkit-tauri/src-tauri/tests/sidecar_qualification.rs
@@ -0,0 +1,683 @@
+//! Fake-process qualification of the packaged Tauri sidecar host.
+//!
+//! Each test copies the synthetic `openmed-fake-sidecar` executable into a
+//! temporary bundle as `openmed-sidecar`, writes a synthetic model directory,
+//! pins both in a generated manifest, and drives the real host code: manifest
+//! verification, process start, generation binding, bounded reads, and
+//! teardown. No test loads a model or touches the network.
+
+use std::{
+    fs,
+    future::Future,
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+
+use openmedkit_tauri_sidecar::{
+    sidecar_command::{
+        OpenMedSidecarState, SidecarCommandError, SidecarDeidentifyOptions,
+        SidecarDeidentifyRequest,
+    },
+    sidecar_manifest::{generate_manifest, SidecarBundle, SidecarManifest, SidecarTarget},
+};
+use serde_json::Value;
+
+const FAKE_SIDECAR: &str = env!("CARGO_BIN_EXE_openmed-fake-sidecar");
+const PARITY_VECTORS: &str = include_str!("../../../../tests/fixtures/parity/offset_contract.json");
+const SYNTHETIC_NOTE: &str = "Synthetic patient Rowan Hale called back.";
+
+static NEXT_BUNDLE: AtomicUsize = AtomicUsize::new(0);
+
+struct FakeBundle {
+    directory: PathBuf,
+    sidecar: PathBuf,
+    model_root: PathBuf,
+    manifest: Vec<u8>,
+}
+
+impl Drop for FakeBundle {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.directory);
+    }
+}
+
+impl FakeBundle {
+    fn new(mode: &str) -> Self {
+        let directory = std::env::temp_dir().join(format!(
+            "openmed-tauri-qualification-{}-{}",
+            std::process::id(),
+            NEXT_BUNDLE.fetch_add(1, Ordering::Relaxed)
+        ));
+        let _ = fs::remove_dir_all(&directory);
+        let model_root = directory.join("model");
+        fs::create_dir_all(model_root.join("onnx")).expect("bundle directory");
+        let sidecar = directory.join(if cfg!(windows) {
+            "openmed-sidecar.exe"
+        } else {
+            "openmed-sidecar"
+        });
+        fs::copy(FAKE_SIDECAR, &sidecar).expect("copy fake sidecar");
+        fs::write(directory.join("fake-sidecar-mode"), mode).expect("mode");
+        fs::write(
+            model_root.join("config.json"),
+            br#"{"model_type":"synthetic"}"#,
+        )
+        .expect("config");
+        fs::write(model_root.join("tokenizer.json"), br#"{"synthetic":true}"#).expect("tokenizer");
+        fs::write(model_root.join("onnx/model.onnx"), b"synthetic weights").expect("weights");
+        let manifest = generate_manifest(
+            &sidecar,
+            &model_root,
+            "synthetic/fake-model",
+            &SidecarTarget::host(),
+        )
+        .expect("manifest");
+        Self {
+            directory,
+            sidecar,
+            model_root,
+            manifest,
+        }
+    }
+
+    fn bundle(&self) -> SidecarBundle {
+        SidecarBundle::new(self.manifest.clone(), &self.sidecar, &self.model_root)
+    }
+
+    fn bundle_with(&self, edit: impl FnOnce(&mut SidecarManifest)) -> SidecarBundle {
+        let mut manifest = SidecarManifest::parse(&self.manifest).expect("parse");
+        edit(&mut manifest);
+        SidecarBundle::new(
+            manifest.to_canonical_bytes().expect("encode"),
+            &self.sidecar,
+            &self.model_root,
+        )
+    }
+
+    fn state(&self) -> OpenMedSidecarState {
+        state_for(self.bundle())
+    }
+
+    fn starts(&self) -> usize {
+        fs::read_to_string(self.directory.join("fake-sidecar-starts"))
+            .map(|log| log.lines().count())
+            .unwrap_or(0)
+    }
+
+    fn redacted_path_fragments(&self) -> Vec<String> {
+        vec![
+            self.directory.display().to_string(),
+            "model.onnx".to_owned(),
+            "tokenizer.json".to_owned(),
+        ]
+    }
+}
+
+fn state_for(bundle: SidecarBundle) -> OpenMedSidecarState {
+    OpenMedSidecarState::from_bundle(bundle)
+        .with_request_timeout(Duration::from_secs(10))
+        .with_startup_timeout(Duration::from_secs(20))
+}
+
+fn run<F: Future>(future: F) -> F::Output {
+    tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()
+        .expect("runtime")
+        .block_on(future)
+}
+
+fn note(text: &str, doc_id: Option<&str>) -> SidecarDeidentifyRequest {
+    SidecarDeidentifyRequest {
+        text: text.to_owned(),
+        options: SidecarDeidentifyOptions {
+            doc_id: doc_id.map(str::to_owned),
+            ..SidecarDeidentifyOptions::default()
+        },
+    }
+}
+
+fn rendered(error: &SidecarCommandError) -> String {
+    serde_json::to_string(error).expect("serialize error")
+}
+
+fn assert_error(error: &SidecarCommandError, code: &str, reason: Option<&str>) {
+    assert_eq!(error.code, code, "{}", rendered(error));
+    assert_eq!(error.reason.as_deref(), reason, "{}", rendered(error));
+    let rendered = rendered(error);
+    assert!(!rendered.contains("Rowan Hale"), "{rendered}");
+    assert!(!rendered.contains("Traceback"), "{rendered}");
+    assert!(!rendered.contains(std::path::MAIN_SEPARATOR), "{rendered}");
+}
+
+fn assert_no_bundle_values(bundle: &FakeBundle, error: &SidecarCommandError) {
+    let rendered = rendered(error);
+    for fragment in bundle.redacted_path_fragments() {
+        assert!(!rendered.contains(&fragment), "{rendered}");
+    }
+    let manifest = SidecarManifest::parse(&bundle.manifest).expect("parse");
+    assert!(!rendered.contains(&manifest.sidecar.sha256), "{rendered}");
+    for file in manifest.model.files {
+        assert!(!rendered.contains(&file.sha256), "{rendered}");
+    }
+}
+
+fn refusal(bundle: &FakeBundle, state: OpenMedSidecarState) -> SidecarCommandError {
+    let error = run(state.deidentify(note(SYNTHETIC_NOTE, None))).expect_err("refused");
+    assert_eq!(bundle.starts(), 0, "the sidecar must not start");
+    assert_no_bundle_values(bundle, &error);
+    error
+}
+
+#[test]
+fn qualified_bundle_starts_once_and_reports_value_free_evidence() {
+    let bundle = FakeBundle::new("ok");
+    let state = bundle.state();
+    run(async {
+        let qualification = state.qualify().await.expect("qualified");
+        assert_eq!(qualification.generation.len(), 32);
+        assert_eq!(
+            qualification.manifest_sha256,
+            bundle.bundle().manifest_sha256()
+        );
+        assert_eq!(qualification.files_verified, 3);
+        assert_eq!(qualification.protocol_version, 1);
+        assert_eq!(
+            qualification.capabilities,
+            ["deidentify", "ping", "shutdown"]
+        );
+        let evidence = serde_json::to_string(&qualification).expect("evidence");
+        for fragment in bundle.redacted_path_fragments() {
+            assert!(!evidence.contains(&fragment));
+        }
+
+        let ping = state.ping().await.expect("ping");
+        assert!(ping.offline);
+        let result = state
+            .deidentify(note(SYNTHETIC_NOTE, Some("synthetic-qualification")))
+            .await
+            .expect("deidentify");
+        assert_eq!(
+            result.deidentified_text,
+            "Synthetic patient [NAME] called back."
+        );
+        assert_eq!((result.spans[0].start, result.spans[0].end), (18, 28));
+        assert_eq!(state.generation().await, Some(qualification.generation));
+        assert!(state.shutdown().await.expect("shutdown").shutdown);
+        assert_eq!(state.generation().await, None);
+    });
+    assert_eq!(bundle.starts(), 1);
+}
+
+#[test]
+fn missing_binary_refuses_before_start() {
+    let bundle = FakeBundle::new("ok");
+    fs::remove_file(&bundle.sidecar).expect("remove sidecar");
+    let error = refusal(&bundle, bundle.state());
+    assert_error(&error, "SIDECAR_ARTIFACT_MISSING", Some("sidecar_missing"));
+}
+
+#[test]
+fn changed_binary_refuses_before_start() {
+    let bundle = FakeBundle::new("ok");
+    let mut bytes = fs::read(&bundle.sidecar).expect("read sidecar");
+    let last = bytes.len() - 1;
+    bytes[last] ^= 0x01;
+    fs::write(&bundle.sidecar, &bytes).expect("flip a byte");
+    let error = refusal(&bundle, bundle.state());
+    assert_error(
+        &error,
+        "SIDECAR_ARTIFACT_MISMATCH",
+        Some("sidecar_digest_mismatch"),
+    );
+
+    bytes.push(0);
+    fs::write(&bundle.sidecar, &bytes).expect("grow");
+    let error = refusal(&bundle, bundle.state());
+    assert_error(
+        &error,
+        "SIDECAR_ARTIFACT_MISMATCH",
+        Some("sidecar_size_mismatch"),
+    );
+}
+
+#[test]
+fn changed_missing_or_added_model_files_refuse_before_start() {
+    type Mutation = fn(&Path);
+    let cases: [(&str, Mutation, &str, &str); 5] = [
+        (
+            "changed",
+            |root| fs::write(root.join("onnx/model.onnx"), b"synthetic weightz").unwrap(),
+            "SIDECAR_ARTIFACT_MISMATCH",
+            "model_file_digest_mismatch",
+        ),
+        (
+            "truncated",
+            |root| fs::write(root.join("tokenizer.json"), b"{}").unwrap(),
+            "SIDECAR_ARTIFACT_MISMATCH",
+            "model_file_size_mismatch",
+        ),
+        (
+            "missing",
+            |root| fs::remove_file(root.join("config.json")).unwrap(),
+            "SIDECAR_ARTIFACT_MISSING",
+            "model_file_missing",
+        ),
+        (
+            "added",
+            |root| fs::write(root.join("onnx/extra.onnx"), b"unlisted").unwrap(),
+            "SIDECAR_ARTIFACT_MISMATCH",
+            "model_file_unlisted",
+        ),
+        (
+            "root",
+            |root| fs::remove_dir_all(root).unwrap(),
+            "SIDECAR_ARTIFACT_MISSING",
+            "model_root_missing",
+        ),
+    ];
+    for (label, mutate, code, reason) in cases {
+        let bundle = FakeBundle::new("ok");
+        mutate(&bundle.model_root);
+        let error = refusal(&bundle, bundle.state());
+        assert_eq!(error.reason.as_deref(), Some(reason), "{label}");
+        assert_error(&error, code, Some(reason));
+    }
+}
+
+#[test]
+fn incompatible_or_tampered_manifests_refuse_before_start() {
+    let bundle = FakeBundle::new("ok");
+    let foreign = if cfg!(windows) { "linux" } else { "windows" };
+    let cases: Vec<(SidecarBundle, &str, &str)> = vec![
+        (
+            bundle.bundle_with(|manifest| manifest.sidecar.platform = foreign.to_owned()),
+            "SIDECAR_ARTIFACT_INCOMPATIBLE",
+            "platform_mismatch",
+        ),
+        (
+            bundle.bundle_with(|manifest| manifest.protocol_version = 2),
+            "SIDECAR_ARTIFACT_INCOMPATIBLE",
+            "protocol_unsupported",
+        ),
+        (
+            bundle.bundle_with(|manifest| {
+                manifest.capabilities.retain(|value| value != "deidentify")
+            }),
+            "SIDECAR_ARTIFACT_INCOMPATIBLE",
+            "capability_missing",
+        ),
+        (
+            bundle.bundle_with(|manifest| manifest.schema_version = 2),
+            "SIDECAR_MANIFEST_INVALID",
+            "manifest_schema_unsupported",
+        ),
+        (
+            bundle.bundle_with(|manifest| manifest.model.files[0].sha256 = "0".repeat(64)),
+            "SIDECAR_ARTIFACT_MISMATCH",
+            "model_file_digest_mismatch",
+        ),
+        (
+            SidecarBundle::new(
+                serde_json::to_vec_pretty(
+                    &serde_json::from_slice::<Value>(&bundle.manifest).unwrap(),
+                )
+                .unwrap(),
+                &bundle.sidecar,
+                &bundle.model_root,
+            ),
+            "SIDECAR_MANIFEST_INVALID",
+            "manifest_not_canonical",
+        ),
+        (
+            SidecarBundle::new(
+                b"{\"schema\":".to_vec(),
+                &bundle.sidecar,
+                &bundle.model_root,
+            ),
+            "SIDECAR_MANIFEST_INVALID",
+            "manifest_malformed",
+        ),
+        (
+            bundle.bundle().with_pinned_manifest_sha256("0".repeat(64)),
+            "SIDECAR_MANIFEST_INVALID",
+            "manifest_digest_mismatch",
+        ),
+        (
+            bundle.bundle_with(|manifest| {
+                manifest.model.files[1].path = "../tokenizer.json".to_owned()
+            }),
+            "SIDECAR_MANIFEST_INVALID",
+            "path_unsafe",
+        ),
+    ];
+    for (candidate, code, reason) in cases {
+        let error = refusal(&bundle, state_for(candidate));
+        assert_error(&error, code, Some(reason));
+    }
+
+    let absent = SidecarBundle::from_manifest_file(
+        &bundle.directory.join("absent.json"),
+        &bundle.sidecar,
+        &bundle.model_root,
+    )
+    .expect_err("absent manifest");
+    assert_eq!(absent.code(), "SIDECAR_MANIFEST_INVALID");
+    assert_eq!(absent.reason, "manifest_unreadable");
+
+    let pinned = bundle.bundle().manifest_sha256();
+    let state = state_for(bundle.bundle().with_pinned_manifest_sha256(pinned));
+    run(state.qualify()).expect("pinned manifest qualifies");
+}
+
+#[test]
+fn binary_replaced_between_generations_refuses_the_next_start() {
+    let bundle = FakeBundle::new("ok");
+    let state = bundle.state();
+    run(async {
+        state.qualify().await.expect("first generation");
+        state.shutdown().await.expect("shutdown");
+    });
+    let mut bytes = fs::read(&bundle.sidecar).expect("read");
+    bytes[0] ^= 0xff;
+    fs::write(&bundle.sidecar, bytes).expect("replace");
+    let error = run(state.ping()).expect_err("refused");
+    assert_error(
+        &error,
+        "SIDECAR_ARTIFACT_MISMATCH",
+        Some("sidecar_digest_mismatch"),
+    );
+    assert_eq!(bundle.starts(), 1);
+}
+
+#[test]
+fn crash_mid_request_is_typed_and_the_next_request_gets_a_new_generation() {
+    let bundle = FakeBundle::new("crash_once");
+    let state = bundle.state();
+    run(async {
+        let first = state.qualify().await.expect("qualified").generation;
+        let error = state
+            .deidentify(note(SYNTHETIC_NOTE, None))
+            .await
+            .expect_err("crash");
+        assert_error(&error, "SIDECAR_TERMINATED", Some("process_exited"));
+        assert_eq!(state.generation().await, None);
+
+        let result = state
+            .deidentify(note(SYNTHETIC_NOTE, None))
+            .await
+            .expect("restarted");
+        assert_eq!(result.spans.len(), 1);
+        let second = state.generation().await.expect("running");
+        assert_ne!(first, second);
+    });
+    assert_eq!(bundle.starts(), 2);
+}
+
+#[test]
+fn partial_response_before_exit_is_terminated_not_parsed() {
+    let bundle = FakeBundle::new("partial_line");
+    let error = run(bundle.state().deidentify(note(SYNTHETIC_NOTE, None))).expect_err("partial");
+    assert_error(&error, "SIDECAR_TERMINATED", Some("process_exited"));
+}
+
+#[test]
+fn stderr_failure_maps_to_an_allow_listed_reason_without_copying_stderr() {
+    let bundle = FakeBundle::new("stderr_failure");
+    let error = run(bundle.state().deidentify(note(SYNTHETIC_NOTE, None))).expect_err("failure");
+    assert_error(&error, "SIDECAR_TERMINATED", Some("sidecar_runtime_failed"));
+
+    let bundle = FakeBundle::new("startup_failure");
+    let error = run(bundle.state().ping()).expect_err("startup failure");
+    assert_error(&error, "SIDECAR_TERMINATED", Some("sidecar_start_failed"));
+    assert_eq!(bundle.starts(), 1);
+}
+
+#[test]
+fn stderr_flood_is_drained_and_never_surfaced() {
+    let bundle = FakeBundle::new("stderr_flood");
+    let result = run(bundle.state().deidentify(note(SYNTHETIC_NOTE, None))).expect("drained");
+    assert_eq!(
+        result.deidentified_text,
+        "Synthetic patient [NAME] called back."
+    );
+}
+
+#[test]
+fn stale_generation_responses_are_rejected_and_the_process_discarded() {
+    let bundle = FakeBundle::new("stale_generation");
+    let state = bundle.state();
+    run(async {
+        let error = state
+            .deidentify(note(SYNTHETIC_NOTE, None))
+            .await
+            .expect_err("stale");
+        assert_error(&error, "SIDECAR_PROTOCOL", Some("stale_generation"));
+        assert_eq!(state.generation().await, None);
+        let error = state
+            .deidentify(note(SYNTHETIC_NOTE, None))
+            .await
+            .expect_err("still stale");
+        assert_error(&error, "SIDECAR_PROTOCOL", Some("stale_generation"));
+    });
+    assert_eq!(bundle.starts(), 2);
+
+    let bundle = FakeBundle::new("wrong_id");
+    let error = run(bundle.state().deidentify(note(SYNTHETIC_NOTE, None))).expect_err("wrong id");
+    assert_error(&error, "SIDECAR_PROTOCOL", Some("response_id_mismatch"));
+}
+
+#[test]
+fn a_cancelled_request_never_leaks_its_late_response_to_the_next_caller() {
+    let bundle = FakeBundle::new("delayed");
+    let state = bundle.state();
+    run(async {
+        let first = state.qualify().await.expect("qualified").generation;
+        let abandoned = tokio::time::timeout(
+            Duration::from_millis(200),
+            state.deidentify(note(SYNTHETIC_NOTE, None)),
+        )
+        .await;
+        assert!(abandoned.is_err(), "the renderer dropped the request");
+
+        let ping = state.ping().await.expect("fresh generation");
+        assert!(ping.offline);
+        let second = state.generation().await.expect("running");
+        assert_ne!(first, second);
+    });
+    assert_eq!(bundle.starts(), 2);
+}
+
+#[test]
+fn request_deadline_kills_and_restarts_the_sidecar() {
+    let bundle = FakeBundle::new("slow");
+    let state = state_for(bundle.bundle()).with_request_timeout(Duration::from_millis(300));
+    run(async {
+        let error = state
+            .deidentify(note(SYNTHETIC_NOTE, None))
+            .await
+            .expect_err("deadline");
+        assert_error(&error, "SIDECAR_TIMEOUT", None);
+        assert_eq!(state.generation().await, None);
+        state.ping().await.expect("restarted");
+    });
+    assert_eq!(bundle.starts(), 2);
+}
+
+#[test]
+fn concurrent_requests_are_refused_while_one_is_in_flight() {
+    let bundle = FakeBundle::new("delayed");
+    let state = Arc::new(bundle.state());
+    run(async {
+        state.qualify().await.expect("qualified");
+        let running = Arc::clone(&state);
+        let first =
+            tokio::spawn(async move { running.deidentify(note(SYNTHETIC_NOTE, None)).await });
+        tokio::time::sleep(Duration::from_millis(100)).await;
+        let second = state.ping().await;
+        first.await.expect("task").expect("first request completes");
+        assert_error(&second.expect_err("busy"), "SIDECAR_BUSY", None);
+    });
+}
+
+#[test]
+fn terminate_interrupts_an_in_flight_request_and_kills_the_process() {
+    let bundle = FakeBundle::new("slow");
+    let state = Arc::new(bundle.state());
+    let process_id = run(async {
+        state.qualify().await.expect("qualified");
+        let process_id = state.process_id().await.expect("running");
+        let running = Arc::clone(&state);
+        let request =
+            tokio::spawn(async move { running.deidentify(note(SYNTHETIC_NOTE, None)).await });
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        state.terminate().await;
+        assert_error(
+            &request.await.expect("task").expect_err("interrupted"),
+            "SIDECAR_NOT_RUNNING",
+            Some("host_terminated"),
+        );
+        assert_eq!(state.generation().await, None);
+        assert_error(
+            &state.ping().await.expect_err("closed"),
+            "SIDECAR_NOT_RUNNING",
+            Some("host_terminated"),
+        );
+        process_id
+    });
+    assert!(!process_is_alive(process_id));
+    assert_eq!(bundle.starts(), 1);
+}
+
+#[test]
+fn blocking_terminate_from_an_exit_handler_kills_the_process() {
+    let bundle = FakeBundle::new("ok");
+    let state = bundle.state();
+    let process_id = tauri::async_runtime::block_on(async {
+        state.qualify().await.expect("qualified");
+        state.process_id().await.expect("running")
+    });
+    state.terminate_blocking();
+    assert!(!process_is_alive(process_id));
+    let error = tauri::async_runtime::block_on(state.ping()).expect_err("closed");
+    assert_error(&error, "SIDECAR_NOT_RUNNING", Some("host_terminated"));
+}
+
+#[test]
+fn oversized_responses_fail_closed() {
+    let bundle = FakeBundle::new("oversized");
+    let state = bundle.state();
+    run(async {
+        let error = state
+            .deidentify(note(SYNTHETIC_NOTE, None))
+            .await
+            .expect_err("oversized");
+        assert_error(&error, "SIDECAR_PROTOCOL", Some("response_too_large"));
+        assert_eq!(state.generation().await, None);
+    });
+}
+
+#[test]
+fn malformed_responses_fail_closed() {
+    for (mode, reason) in [
+        ("malformed", "response_malformed"),
+        ("unknown_field", "response_malformed"),
+        ("invalid_spans", "result_invalid"),
+    ] {
+        let bundle = FakeBundle::new(mode);
+        let state = bundle.state();
+        run(async {
+            let error = state
+                .deidentify(note(SYNTHETIC_NOTE, None))
+                .await
+                .expect_err(mode);
+            assert_error(&error, "SIDECAR_PROTOCOL", Some(reason));
+            assert_eq!(state.generation().await, None, "{mode}");
+        });
+    }
+}
+
+#[test]
+fn handshake_rejects_online_incompatible_or_noisy_sidecars() {
+    for (mode, reason) in [
+        ("online", "handshake_invalid"),
+        ("protocol_two", "handshake_invalid"),
+        ("banner", "response_malformed"),
+    ] {
+        let bundle = FakeBundle::new(mode);
+        let state = bundle.state();
+        run(async {
+            let error = state.qualify().await.expect_err(mode);
+            assert_error(&error, "SIDECAR_PROTOCOL", Some(reason));
+            assert_eq!(state.generation().await, None, "{mode}");
+        });
+        assert_eq!(bundle.starts(), 1, "{mode}");
+    }
+}
+
+#[test]
+fn packaged_host_results_match_the_shared_parity_vectors() {
+    let vectors: Value = serde_json::from_str(PARITY_VECTORS).expect("vectors");
+    assert_eq!(vectors["offset_unit"], "unicode_scalar");
+    let cases = vectors["cases"].as_array().expect("cases");
+    assert!(cases.len() >= 40);
+    let bundle = FakeBundle::new("ok");
+    let state = bundle.state();
+    run(async {
+        for case in cases {
+            let id = case["id"].as_str().expect("id");
+            let doc_id = format!("parity:{id}");
+            let result = state
+                .deidentify(note(case["text"].as_str().expect("text"), Some(&doc_id)))
+                .await
+                .unwrap_or_else(|error| panic!("{id}: {}", rendered(&error)));
+            assert_eq!(
+                result.deidentified_text,
+                case["expected_redacted"].as_str().expect("expected"),
+                "{id}"
+            );
+            assert_eq!(result.spans.len(), 1, "{id}");
+            let span = &result.spans[0];
+            assert_eq!(
+                (span.start as u64, span.end as u64),
+                (
+                    case["expected_start"].as_u64().expect("start"),
+                    case["expected_end"].as_u64().expect("end")
+                ),
+                "{id}"
+            );
+            assert_eq!(
+                span.replacement.as_deref(),
+                case["replacement"].as_str(),
+                "{id}"
+            );
+            assert_eq!(span.doc_id, doc_id, "{id}");
+        }
+    });
+    assert_eq!(bundle.starts(), 1);
+}
+
+#[cfg(unix)]
+fn process_is_alive(process_id: u32) -> bool {
+    std::process::Command::new("kill")
+        .arg("-0")
+        .arg(process_id.to_string())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .is_ok_and(|status| status.success())
+}
+
+#[cfg(windows)]
+fn process_is_alive(process_id: u32) -> bool {
+    std::process::Command::new("tasklist")
+        .args(["/FI", &format!("PID eq {process_id}"), "/NH"])
+        .output()
+        .is_ok_and(|output| {
+            String::from_utf8_lossy(&output.stdout).contains(&process_id.to_string())
+        })
+}
